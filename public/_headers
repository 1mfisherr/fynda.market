# Cloudflare Pages headers. The font files never change under this name;
# a photo can be replaced under the same name by import-images.mjs, so a day.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=86400
# Astro's build output: every file name carries a hash of its content, so a
# changed file is a new name and the old one can be kept for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# Every page: HTTPS only, never inside another site's frame, and the
# location prompt only for this site (the Near me page asks for it).
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
