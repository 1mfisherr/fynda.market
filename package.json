{
  "name": "fynda-market",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:functions": "tsc -p tsconfig.functions.json",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "db:test": "node scripts/db-test.mjs",
    "guardrails": "node scripts/guardrails.mjs",
    "verify": "npm run check && npm run check:functions && npm run test && npm run build && npm run guardrails",
    "digest": "node scripts/send-digest.mjs",
    "prebuild": "node scripts/emit-data.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.2",
    "html-to-text": "^10.0.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.64.0",
    "robots-parser": "^3.0.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
