# Copy this file to .env and fill it in. .env is gitignored — never commit it.
# Nothing here should ever be pasted into chat.

# ---------------------------------------------------------------------------
# The new Fynda project
# ---------------------------------------------------------------------------

# Settings -> API. Looks like https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The short id inside that URL (abcdefghijkl). Used to link the CLI.
SUPABASE_PROJECT_REF=

# Settings -> API. The public key. Safe to ship to browsers.
# Newer dashboards call this the "publishable" key.
SUPABASE_ANON_KEY=

# Settings -> API. The secret key — full access, bypasses row level security.
# Build-time and server only, never sent to a browser.
# Newer dashboards call this the "secret" key.
SUPABASE_SERVICE_ROLE_KEY=

# Settings -> Database -> Connection string -> URI, with the database password
# filled in. Used to run migrations and to load data.
# postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# The old fleafind project — read only, and only for the import
# ---------------------------------------------------------------------------

# Same place, in the fleafind project. We dump from here; we never write to it.
V1_DATABASE_URL=
