---
/**
 * Radius view — `/de/umkreis/`, `/fr/a-proximite/`, `/it/nei-dintorni/`,
 * `/en/nearby/`.
 *
 * docs/ARCHITECTURE.md: "in der Nähe" is a query parameter, never a page type
 * of its own — `/{locale}/{nearby}?lat=…&lng=…&km=…`, or `?town=<slug>` when
 * the point is a town. There is no server at request time (docs/STACK.md), so
 * every market ships in the HTML and a script measures, filters and groups.
 *
 * The shape since 2026-09-23 (UI audit; design/place-picker.html, options 3
 * and 3b): the place sits in one pill at the top — "In der Nähe von Zürich ·
 * 25 km" — and the markets under it in distance bands, the soonest first in
 * each. Before anyone has said where they are, the place sheet is what opens;
 * the page used to answer that with all 195 markets of two countries by date,
 * thirty-five screens on a phone, Geneva first for someone in Munich.
 *
 * Four states, decided above the fold: before a place, locating, located,
 * refused. `indexable={false}`: a filter, not a place.
 */
import Page from '../layouts/Page.astro';
import Button from './Button.astro';
import DateFilters from './DateFilters.astro';
import Icon from './Icon.astro';
import MarketRow from './MarketRow.astro';
import TownSearch from './TownSearch.astro';
import { getMarkets } from '../lib/markets';
import { byMarket, datedRows } from '../lib/lists';
import { nearbyPath, utilityAlternates, type Locale } from '../lib/i18n';
import { RADII } from '../lib/geo';
import { t } from '../lib/strings';
import { townIndex } from '../lib/towns';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);

const markets = await getMarkets(locale);
/* One row per market, like every other list on the site. */
const list = byMarket(datedRows(markets));
const towns = townIndex(locale, markets);
const DEFAULT_KM = 25;
---
<Page
  indexable={false}
  locale={locale}
  alternates={utilityAlternates('nearby')}
  title={s.radiusTitle}
  description={s.radiusDescription}
>
  {/* `data-state` is the page's switch: before · locating · located ·
      refused. Sentences travel on elements (a component script is bundled
      once and never sees `locale`). */}
  <div
    class="near"
    data-near
    data-state="before"
    data-default-km={DEFAULT_KM}
    data-near-town={s.nearTown('{town}')}
    data-near-you={s.nearYou}
    data-pick={s.pickTown}
    data-band-first={s.distanceBand(0, 999).replace('999', '{to}')}
    data-band={s.distanceBand(111, 999).replace('111', '{from}').replace('999', '{to}')}
    data-count-one={s.marketCount(1)}
    data-count-many={s.marketCount(2)}
  >
    <section class="page-head gutter">
      <h1>{s.radiusHeading}</h1>
      <button type="button" class="place" data-place aria-haspopup="dialog">
        <Icon name="place" size={18} />
        <span data-place-label>{s.pickTown}</span>
        <Icon name="chevron-down" size={16} />
      </button>
      <p
        class="answer"
        id="status"
        aria-live="polite"
        data-asking={s.askingPhone}
        data-within-one={s.radiusWithin(1, 0).replace('0', '{km}')}
        data-within-many={s.radiusWithin(2, 0).replace('0', '{km}').replace(/^2/, '{n}')}
        data-denied={s.radiusDenied}
      ></p>
    </section>

    <div class="when" data-only="located"><DateFilters locale={locale} dates={list.map((m) => m.next.date)} /></div>

    {/* The place sheet. On a phone it rises from the bottom over a dimmed page;
        on a desk it is a panel under the pill. It opens by itself only while
        no place is known — never with the keyboard up, which nobody asked for. */}
    <div class="sheet-wrap" data-sheet hidden>
      <div class="dim" data-sheet-close></div>
      <div class="sheet" role="dialog" aria-modal="true" aria-label={s.pickTown}>
        <div class="sheet-head">
          <strong>{s.pickTown}</strong>
          <button type="button" class="close" data-sheet-close aria-label={s.closeSheet}><Icon name="chevron-down" size={22} /></button>
        </div>
        <p class="meta denied" data-only="refused">{s.radiusDenied}</p>
        <Button type="button" variant="primary" block data-geo>
          <Icon name="locate" size={18} /><span data-geo-label data-ask={s.radiusUseLocation} data-again={s.tryAgain}>{s.radiusUseLocation}</span>
        </Button>
        <TownSearch locale={locale} towns={towns} mode="pick" nearbyHref={nearbyPath(locale)} showBig id="near-town" />
        <div class="how-far">
          <p class="label">{s.howFarLabel}</p>
          <div class="radius" role="group" aria-label={s.radiusGroup}>
            {RADII.map((km) => (
              <button class="button" type="button" data-km={km} aria-pressed={km === DEFAULT_KM ? "true" : "false"}>{`${km} km`}</button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div id="list" class="gutter list">
      {list.map((market) => (
        <div class="pin" data-lat={market.lat} data-lng={market.lng}>
          <MarketRow market={market} locale={locale} showRhythm />
        </div>
      ))}
    </div>
    <p id="empty" class="gutter meta" hidden>{s.nothingForSelection}</p>
  </div>
</Page>

<style>
  .page-head { display: grid; gap: var(--space-3); }
  .when { margin-block-start: var(--space-4); }

  /* The place pill: the one thing at the top you can change. */
  .place {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-weight: var(--weight-bold);
    cursor: pointer;
  }
  .place span { max-width: 26ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* ---- the sheet ---- */
  .sheet-wrap { position: fixed; inset: 0; z-index: 20; }
  .sheet-wrap[hidden] { display: none; }
  .dim { position: absolute; inset: 0; background: rgb(17 17 16 / 45%); }
  .sheet {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--space-4);
    max-height: 90vh;
    overflow-y: auto;
    padding: var(--space-3) var(--space-page) var(--space-6);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--color-surface);
    box-shadow: 0 calc(var(--space-3) * -1) var(--space-6) rgb(17 17 16 / 18%);
  }
  .sheet-head { display: flex; align-items: center; justify-content: space-between; font-size: var(--text-title); }
  .close { display: grid; place-items: center; width: var(--tap-min); height: var(--tap-min); border: 0; background: none; color: var(--color-ink); cursor: pointer; }
  .label {
    color: var(--color-quiet);
    font-size: var(--text-tiny);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .how-far { display: grid; gap: var(--space-2); }
  .radius { display: flex; border-block: var(--border-width) solid var(--color-line); }
  .radius > .button {
    flex: 1 1 0;
    min-width: 0;
    min-height: var(--tap-min);
    padding-inline: var(--space-1);
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--color-quiet);
    box-shadow: none;
  }
  .radius > .button[aria-pressed='true'] {
    background: none;
    color: var(--color-ink);
    box-shadow: inset 0 calc(var(--border-width) * -3) 0 var(--color-accent);
  }

  /* A desk has room for the sheet as a centred panel. Keep in step with
     --breakpoint-wide. */
  @media (min-width: 900px) {
    .sheet { inset: 12vh auto auto 50%; width: min(var(--measure), 92vw); transform: translateX(-50%); border-radius: var(--radius-md); }
  }

  /* ---- the bands ---- */
  .list :global(.band) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-block-start: var(--space-5);
    padding-block-end: var(--space-2);
    border-block-end: calc(var(--border-width) * 2) solid var(--color-ink);
  }
  .list :global(.band h2) { margin: 0; font-size: var(--text-title); }
  .list :global(.band span) { color: var(--color-quiet); font-size: var(--text-small); }

  /* The switch. A block is shown only in the states its `data-only` names. */
  [data-only] { display: none; }
  [data-state='located'] [data-only~='located'],
  [data-state='refused'] [data-only~='refused'] { display: block; }

  /* Until there is a point, the list waits — with JavaScript. Without it the
     page is still every market by date. */
  [data-js][data-state='before'] #list,
  [data-js][data-state='refused'] #list { display: none; }
  [data-state='locating'] #list { opacity: 0.45; transition: opacity var(--duration-base) var(--ease-base); }
</style>

<script>
  import { inWindow, type DateWindow } from '../lib/date-window';
  import { distanceKm } from '../lib/geo';
  import { TOWN_KEY } from '../lib/local-keys';

  type State = 'before' | 'locating' | 'located' | 'refused';
  type Origin = { lat: number; lng: number; town?: { slug: string; name: string } };

  const page = document.querySelector<HTMLElement>('[data-near]');
  if (page) {
    const d = page.dataset;
    page.setAttribute('data-js', '');
    const sheet = page.querySelector<HTMLElement>('[data-sheet]')!;
    const placeLabel = page.querySelector<HTMLElement>('[data-place-label]')!;
    const geoLabel = page.querySelector<HTMLElement>('[data-geo-label]');
    const statusEl = document.getElementById('status');
    const listEl = document.getElementById('list')!;
    const empty = document.getElementById('empty');
    const pins = Array.from(page.querySelectorAll<HTMLElement>('.pin'));
    const dateButtons = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const kmButtons = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-km]'));
    const towns: { slug: string; name: string; lat: number; lng: number }[] = JSON.parse(
      page.querySelector<HTMLElement>('[data-ts]')?.dataset.towns ?? '[]',
    ).map(([slug, name, , , , , lat, lng]: [string, string, string, string, string, number, number, number]) => ({ slug, name, lat, lng }));

    let state: State = 'before';
    let origin: Origin | null = null;
    let km = Number(d.defaultKm ?? 25);
    let when: DateWindow = 'all';

    const lang = document.documentElement.lang || 'de';
    const oneDecimal = new Intl.NumberFormat(lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const count = (n: number) => ((n === 1 ? d.countOne : d.countMany) ?? '').replace(/\d+/, String(n));

    function openSheet(yes: boolean) {
      sheet.hidden = !yes;
      document.documentElement.style.overflow = yes ? 'hidden' : '';
    }

    /* The URL says what is on screen, so a list can be shared and Back works. */
    function writeUrl() {
      const q = new URLSearchParams();
      if (origin?.town) q.set('town', origin.town.slug);
      else if (origin) { q.set('lat', origin.lat.toFixed(4)); q.set('lng', origin.lng.toFixed(4)); }
      if (origin) q.set('km', String(km));
      if (when !== 'all') q.set('zeit', when);
      history.replaceState(null, '', `${location.pathname}${q.toString() ? `?${q}` : ''}`);
    }

    function render() {
      page!.setAttribute('data-state', state);
      placeLabel.textContent = origin
        ? `${origin.town ? (d.nearTown ?? '').replace('{town}', origin.town.name) : d.nearYou} · ${km} km`
        : d.pick ?? '';
      if (geoLabel) geoLabel.textContent = (state === 'refused' ? geoLabel.dataset.again : geoLabel.dataset.ask) ?? '';
      for (const b of kmButtons) b.setAttribute('aria-pressed', String(Number(b.dataset.km) === km));

      for (const band of Array.from(listEl.querySelectorAll('.band'))) band.remove();
      if (!origin) {
        if (statusEl) statusEl.textContent = state === 'locating' ? d.asking ?? '' : state === 'refused' ? statusEl.dataset.denied ?? '' : '';
        if (empty) empty.hidden = true;
        return;
      }

      const now = new Date();
      const shown = pins
        .map((pin) => {
          const row = pin.querySelector<HTMLElement>('[data-date]');
          const label = pin.querySelector<HTMLElement>('[data-distance]');
          const dist = distanceKm(origin!.lat, origin!.lng, Number(pin.dataset.lat), Number(pin.dataset.lng));
          const ok = dist <= km && inWindow(row?.dataset.date ?? '', when, now);
          pin.hidden = !ok;
          if (label) { label.hidden = !ok; label.textContent = ok ? `${oneDecimal.format(dist)} km` : ''; }
          return { pin, dist, date: row?.dataset.date ?? '' };
        })
        .filter((x) => !x.pin.hidden);

      /* Bands up to the chosen distance; the soonest first inside each. */
      const edges = [0, 10, 25, 50, 100].filter((e) => e < km).concat(km);
      for (let i = 0; i < edges.length - 1; i++) {
        const from = edges[i], to = edges[i + 1];
        const inBand = shown.filter((x) => x.dist > from - (i === 0 ? 1 : 0) && x.dist <= to).sort((a, b) => a.date.localeCompare(b.date) || a.dist - b.dist);
        if (!inBand.length) continue;
        const head = document.createElement('div');
        head.className = 'band';
        const h2 = document.createElement('h2');
        h2.textContent = (from === 0 ? d.bandFirst ?? '' : d.band ?? '').replace('{from}', String(from)).replace('{to}', String(to));
        const n = document.createElement('span');
        n.textContent = count(inBand.length);
        head.append(h2, n);
        listEl.appendChild(head);
        for (const x of inBand) listEl.appendChild(x.pin);
      }

      if (empty) empty.hidden = shown.length > 0;
      if (statusEl) {
        const tpl = (shown.length === 1 ? statusEl.dataset.withinOne : statusEl.dataset.withinMany) ?? '';
        statusEl.textContent = tpl.replace('{n}', String(shown.length)).replace('{km}', String(km));
      }
    }

    function set(next: State, where: Origin | null = origin) {
      state = next;
      origin = where;
      render();
      writeUrl();
    }

    const geo = (detail: Record<string, string>) => document.dispatchEvent(new CustomEvent('fynda:geo', { detail }));
    function locate() {
      openSheet(false);
      if (!('geolocation' in navigator)) { geo({ outcome: 'denied', reason: 'unavailable' }); set('refused', null); openSheet(true); return; }
      set('locating', null);
      geo({ outcome: 'requested' });
      navigator.geolocation.getCurrentPosition(
        (pos) => { geo({ outcome: 'granted' }); set('located', { lat: pos.coords.latitude, lng: pos.coords.longitude }); },
        (err) => {
          const reason = err.code === err.PERMISSION_DENIED ? 'denied' : err.code === err.TIMEOUT ? 'timeout' : 'unavailable';
          geo({ outcome: 'denied', reason });
          set('refused', null);
          openSheet(true);
        },
        { enableHighAccuracy: false, timeout: 8000 },
      );
    }

    function useTown(slug: string | null | undefined) {
      const town = towns.find((x) => x.slug === slug);
      if (!town) return false;
      openSheet(false);
      set('located', { lat: town.lat, lng: town.lng, town: { slug: town.slug, name: town.name } });
      return true;
    }

    page.querySelector('[data-place]')?.addEventListener('click', () => openSheet(true));
    for (const el of Array.from(page.querySelectorAll('[data-sheet-close]'))) el.addEventListener('click', () => openSheet(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) openSheet(false); });
    for (const b of Array.from(page.querySelectorAll<HTMLElement>('[data-geo]'))) b.addEventListener('click', (e) => { e.preventDefault(); locate(); });
    page.addEventListener('fynda:locate', locate);
    page.addEventListener('fynda:town', (e) => useTown((e as CustomEvent).detail?.slug));
    for (const b of kmButtons) b.addEventListener('click', () => { km = Number(b.dataset.km); if (origin) { openSheet(false); set('located'); } else render(); });
    for (const b of dateButtons) b.addEventListener('click', () => {
      for (const o of dateButtons) o.setAttribute('aria-pressed', String(o === b));
      when = (b.dataset.filter ?? 'all') as DateWindow;
      render(); writeUrl();
    });

    /* Where the page starts: the URL, then the town this browser remembers,
       then the sheet. The home page sends `?lat&lng`, or `?denied=` when the
       phone said no there. */
    const q = new URLSearchParams(location.search);
    const kmParam = Number(q.get('km'));
    if (kmParam > 0) km = kmParam;
    const zeit = q.get('zeit');
    dateButtons.find((b) => b.dataset.filter === zeit)?.click();
    const lat = Number(q.get('lat')), lng = Number(q.get('lng'));
    let remembered: string | undefined;
    try { remembered = JSON.parse(localStorage.getItem(TOWN_KEY) ?? 'null')?.slug; } catch { /* private mode */ }
    if (q.get('lat') && Number.isFinite(lat) && Number.isFinite(lng)) set('located', { lat, lng });
    else if (useTown(q.get('town'))) { /* done */ }
    else if (q.get('denied')) { set('refused', null); openSheet(true); }
    else if (useTown(remembered)) { /* done */ }
    else { set('before', null); openSheet(true); }
  }
</script>
