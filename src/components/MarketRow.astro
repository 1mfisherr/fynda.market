---
/**
 * A market in a list. **The only one on the site.**
 *
 * Home, city, canton, radius and saved all render this, so a change to a row
 * is a change everywhere by construction rather than by discipline. It comes
 * in two sizes and they share every part — the same day label, name, badge,
 * flag, venue line and picture. Only the frame differs:
 *
 *   variant="feature"  picture above, name at display size. The lead of a
 *                      block. A page with one size on it has no rhythm.
 *   variant="row"      picture beside, compact. Everything after the lead.
 *   variant="compact"  a small picture, the name, and one line under it —
 *                      Today · 07:00–17:00 · 2.5 km. The other markets under a
 *                      market page's buttons, where this market is the page
 *                      and they are a footnote (Delfim, 2026-10-10).
 *
 * A row with no date says when the market is back instead — "Back in April",
 * or when it last ran (src/lib/season.ts). Accented, like a date: it is the
 * answer to the same question.
 *
 * What a row does NOT say, and why (all one rule — say the exception, never
 * the rule; BRAND.md):
 *
 *   the entry fee   151 of 157 markets are free. A price appears only when
 *                   there is one.
 *   the city        omitted where the page already names it.
 *   the freshness   silence means confirmed and recently checked. See
 *                   src/lib/freshness.ts.
 *   the kind        badged only when it is not an ordinary Flohmarkt, which
 *                   was 41 of 45 rows. See vocabulary.ts BADGED_KINDS.
 *
 * One loud thing per row: the name. Everything under it steps down a weight.
 * The check stamp ("Zuletzt geprüft 22. Mai") used to share the first line
 * with the date and the hours at the same size, and as the data aged it was
 * on five rows in seven — three loud things. It is now the last line, quiet.
 * A cancellation stays on the first line: that is status, and status is loud.
 */
import type { Market } from '../lib/types';
import { BADGED_KINDS, LINES } from '../lib/vocabulary';
import { formatDate, formatTime, formatTimeRange, toIsoWithOffset, todayIso } from '../lib/format';
import { withinHorizon } from '../lib/markets';
import { encodeDates } from '../lib/date-rows';
import { flagFor } from '../lib/freshness';
import { DEFAULT_LOCALE, formatFee, marketPath, type Locale } from '../lib/i18n';
import { seasonLabel } from '../lib/season';
import { t } from '../lib/strings';
import PhotoOrArt from './PhotoOrArt.astro';

interface Props {
  market: Market;
  locale?: Locale;
  /** 'feature' leads a block; 'row' is everything after it; 'compact' is a footnote to another market. */
  variant?: 'feature' | 'row' | 'compact';
  /** Leave the city off where the page already names it. */
  omitCity?: boolean;
  /** "Jeden Samstag, ganzjährig" — the line that replaces eighteen repeats. */
  showRhythm?: boolean;
  /** Rendered verbatim as a pill on the first line; the caller computed it and must never guess it. */
  distance?: string;
  /** Off where the page groups rows under a day header that already says it. */
  showDay?: boolean;
  /**
   * Every date inside the horizon on the row, for a page whose When control
   * must find the market on any of them, not only its next — src/lib/date-rows.ts.
   * Town and canton lists; nowhere else pays the bytes.
   */
  allDates?: boolean;
}
const {
  market, locale = DEFAULT_LOCALE, variant = 'row',
  omitCity = false, showRhythm = false, distance, showDay = true, allDates = false,
} = Astro.props;

const s = t(locale);
const occurrence = market.next;
const cancelled = occurrence?.status === 'cancelled';
const flag = flagFor(occurrence, s, locale);
const line = LINES[market.kind];
const badge = BADGED_KINDS.has(market.kind) ? line.short[locale] : undefined;

// "Sat 31 Oct", with the month: a canton list runs 120 days, and "Sat 31"
// followed by "Sun 1" read as the same October weekend (found 2026-09-28).
// A compact row is read beside one market's own date, so its day is a word
// where it can be — "Today" — and the date only after that.
const today = todayIso();
const relativeDay = (date: string) => {
  const next = new Date(`${today}T12:00:00`);
  next.setDate(next.getDate() + 1);
  const tomorrow = `${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, '0')}-${String(next.getDate()).padStart(2, '0')}`;
  return date === today ? s.statusToday : date === tomorrow ? s.statusTomorrow : formatDate(date, locale);
};
const dayLabel = showDay && occurrence ? (variant === 'compact' ? relativeDay(occurrence.date) : formatDate(occurrence.date, locale)) : '';
const compact = variant === 'compact';

/* No date: when it is back, else when it last ran — the honest answer to
   "when" that the rhythm line alone left to the reader. */
const between = !occurrence && showRhythm
  ? seasonLabel(market, today, locale) ?? (market.lastDate ? s.lastHeld(formatDate(market.lastDate, locale)) : undefined)
  : undefined;
const times = occurrence?.startTime
  ? `${formatTime(occurrence.startTime)}${occurrence.endTime ? `–${formatTime(occurrence.endTime)}` : ''}`
  : undefined;

/* Today's instants, for the clock line (src/lib/clock.ts). Only a date that
   is today, not cancelled, with both ends known — the rest have no minute to
   tell. The build knows the day; the browser works out the hour. */
const live = occurrence && !cancelled && occurrence.date === todayIso() && occurrence.startTime && occurrence.endTime
  ? { start: toIsoWithOffset(occurrence.date, occurrence.startTime, market.timezone), end: toIsoWithOffset(occurrence.date, occurrence.endTime, market.timezone) }
  : undefined;

const dates = allDates
  ? encodeDates(withinHorizon([market.next, ...market.upcoming].filter(Boolean) as NonNullable<typeof market.next>[])
    .filter((o) => o.status !== 'cancelled')
    .sort((a, b) => a.date.localeCompare(b.date))
    .map((o) => ({ date: o.date, hours: formatTimeRange(o.startTime, o.endTime, locale) ?? '' })))
  : undefined;

const entry = market.entryFee ? formatFee(market.entryFee, market.countryCode) : undefined;
const where = [market.venueName, omitCity ? undefined : market.city, entry]
  .filter(Boolean).join(' · ');

const size = variant === 'feature' ? 720 : 148;
---

{/* data-date is always present: the When control reads it, and a row with no
    date yet ("") is shown under All and hidden under any real window. */}
<article class:list={['card', variant, { cancelled }]} data-date={occurrence?.date ?? ''} data-market={market.id} data-start={live?.start} data-end={live?.end} data-lat={distance ? undefined : market.lat} data-lng={distance ? undefined : market.lng} data-dates={dates || undefined}>
  <div class="pic"><PhotoOrArt market={market} width={size} height={size} /></div>
  <div class="body">
    <p class="meta">
      {dayLabel && <span class="day">{dayLabel}</span>}
      {times && <span class="hours">{times}</span>}
      {flag?.tone === 'bad' && <span class="flag bad">{flag.text}</span>}
      {/* The distance, as a pill at the end of the line. The slot is always in
          the markup and empty until someone has a real origin to measure from:
          the radius view's script fills it, the city page's "within 25 km"
          block and the market page's nearby block at build time, and on every
          other list the script below, from the town the visitor picked. Never
          a distance we guessed. */}
      <span class="km" data-distance hidden={!distance}>{distance}</span>
    </p>
    <h3 class="name">
      <a href={marketPath(locale, market.slug)}>{market.name}</a>
      {badge && <i class="badge" style={`background:var(${line.token});color:var(${line.token}-ink)`}>{badge}</i>}
    </h3>
    {/* "Closes in 40 min", or "Over for today" — the exceptions only. An open
        market with hours to go says nothing: its times already do. */}
    {live && <p class="clock" data-clock hidden></p>}
    {between && <p class="state">{between}</p>}
    {!compact && showRhythm && market.recurrenceText && <p class="rhythm">{market.recurrenceText}</p>}
    {!compact && <p class="where">{where}</p>}
    {!compact && flag?.tone === 'warn' && <p class="check">{flag.text}</p>}
  </div>
</article>

<style>
  .card { position:relative; }
  .pic { overflow:hidden; border-radius:var(--radius-sm); background:var(--color-paper); }
  .body { min-width:0; }

  /* The line above the name. The date is the one loud colour on the page —
     BRAND.md allows the accent here and nowhere else in a list. */
  .meta { display:flex; align-items:center; flex-wrap:wrap; gap:var(--space-2); margin:0; }
  .day { color:var(--color-accent-text); font-size:var(--text-small); font-weight:var(--weight-black); letter-spacing:var(--tracking-caps); text-transform:uppercase; white-space:nowrap; }
  .hours { color:var(--color-grey); font-size:var(--text-small); font-weight:var(--weight-semibold); white-space:nowrap; }
  .flag { font-size:var(--text-small); font-weight:var(--weight-bold); }
  .flag.bad { color:var(--color-accent-text); }
  .km { margin-inline-start:auto; padding:var(--space-half) var(--space-2); border-radius:var(--radius-pill); background:var(--color-ink); color:var(--color-white); font-size:var(--text-micro); font-weight:var(--weight-bold); font-variant-numeric:var(--figures-tabular); white-space:nowrap; }

  /* One loud thing. Everything below it steps down a weight. */
  .name { margin-block-start:var(--space-half); font-weight:var(--weight-bold); letter-spacing:var(--tracking-title); line-height:1.2; }
  .name a::after { position:absolute; inset:0; content:''; }
  .badge { display:inline-block; margin-inline-start:var(--space-2); padding:var(--space-half) var(--space-2); border-radius:var(--radius-pill); color:var(--color-white); font-size:var(--text-micro); font-style:normal; font-weight:var(--weight-black); letter-spacing:var(--tracking-caps); vertical-align:var(--space-half); white-space:nowrap; }
  .clock { margin:var(--space-1) 0 0; color:var(--color-accent-text); font-size:var(--text-small); font-weight:var(--weight-bold); line-height:1.4; }
  .clock[hidden] { display:none; }
  /* Finished for today: still listed, so the list does not jump, but it steps
     back. The picture fades with it, as a cancellation's does. */
  .over .clock { color:var(--color-quiet); }
  .over .name a { color:var(--color-quiet); }
  .over .pic { opacity:0.45; }
  .state { margin:var(--space-1) 0 0; color:var(--color-accent-text); font-size:var(--text-small); font-weight:var(--weight-bold); line-height:1.4; }
  .rhythm { margin:var(--space-1) 0 0; color:var(--color-grey); font-size:var(--text-small); font-weight:var(--weight-semibold); line-height:1.4; }
  .where { margin:var(--space-half) 0 0; color:var(--color-quiet); font-size:var(--text-small); line-height:1.4; }
  .check { margin:var(--space-half) 0 0; color:var(--color-quiet); font-size:var(--text-micro); line-height:1.4; }

  /* ---- the lead ---- */
  .feature .pic { aspect-ratio:16 / 10; margin-block-end:var(--space-3); border-radius:var(--radius-md); }
  .feature .name { font-size:var(--text-feature); font-weight:var(--weight-black); letter-spacing:var(--tracking-tight); line-height:1.14; }

  /* ---- everything after it ---- */
  .row { display:grid; grid-template-columns:var(--row-thumb) minmax(0, 1fr); gap:var(--space-4); align-items:center; padding-block:var(--space-4); border-block-end:var(--border-width) solid var(--color-line); }
  .row .pic { aspect-ratio:1; }
  .row .name { font-size:var(--text-row-name); }

  /* ---- a footnote to another market: name first, then one line ---- */
  .compact { display:grid; grid-template-columns:var(--row-thumb-compact) minmax(0, 1fr); gap:var(--space-3); align-items:center; padding-block:var(--space-3); border-block-end:var(--border-width) solid var(--color-line); }
  .compact .pic { aspect-ratio:1; border-radius:var(--radius-photo); }
  .compact .body { display:flex; flex-direction:column; }
  .compact .name { order:-1; margin:0; font-size:var(--text-small); }
  .compact .meta { margin-block-start:var(--space-half); gap:var(--space-1); }
  .compact .day, .compact .hours { font-size:var(--text-micro); letter-spacing:normal; text-transform:none; }
  .compact .meta > * + *::before { content:'· '; color:var(--color-quiet); }
  .compact .km { margin:0; padding:0; background:none; color:var(--color-grey); font-weight:var(--weight-semibold); }

  .cancelled .name a { color:var(--color-quiet); text-decoration:line-through; text-decoration-color:var(--color-line); }
  .cancelled .pic { filter:grayscale(1); opacity:0.55; }
</style>

<script>
  import { clockState, clockWords, formatSpan, instantsOf } from '../lib/clock';
  import { iso } from '../lib/date-window';
  import { DISTANCE_MAX_KM, distanceKm, kmLabel, type PickedTown } from '../lib/geo';
  import { TOWN_KEY, adopt } from '../lib/local-keys';

  /* How far each card is from the town the visitor picked — within 50 km, and
     only once they have picked one. Straight line; the list keeps its order,
     because sorting by distance is the Near me page's job, and that page
     measures from its own origin, so its cards are left alone. */
  adopt(TOWN_KEY);
  const town = ((): PickedTown | null => {
    try { return JSON.parse(localStorage.getItem(TOWN_KEY) ?? 'null'); } catch { return null; }
  })();
  if (town && typeof town.lat === 'number' && typeof town.lng === 'number') {
    const tag = document.documentElement.lang || 'en';
    for (const card of Array.from(document.querySelectorAll<HTMLElement>('article.card[data-lat][data-lng]'))) {
      if (card.closest('.pin')) continue;
      const pill = card.querySelector<HTMLElement>('[data-distance]');
      if (!pill || pill.textContent) continue;
      const km = distanceKm(town.lat, town.lng, Number(card.dataset.lat), Number(card.dataset.lng));
      if (km > DISTANCE_MAX_KM) continue;
      pill.textContent = kmLabel(km, tag);
      pill.hidden = false;
    }
  }

  /* Every row on the page that is on today, painted now and again each
     minute: a town page left open on a phone at 15:58 should not still be
     recommending a market that closed at 16:00. */
  const words = clockWords();
  const rows = Array.from(document.querySelectorAll<HTMLElement>('article.card[data-start][data-end]'));
  const paint = () => {
    for (const row of rows) {
      const at = instantsOf(row);
      const slot = row.querySelector<HTMLElement>('[data-clock]');
      const state = at && clockState(...at);
      if (!state || !slot || !words) continue;
      // A When filter can show this row for a later date (src/lib/date-rows.ts);
      // then today's clock has nothing to say about it.
      if (row.dataset.date !== iso(new Date())) { row.classList.remove('over'); slot.hidden = true; continue; }
      row.classList.toggle('over', state.phase === 'over');
      row.dataset.phase = state.phase;
      if (state.phase === 'closing') slot.textContent = words.closesIn.replace('{t}', formatSpan(state.minutes, words));
      else if (state.phase === 'over') slot.textContent = words.overToday;
      slot.hidden = !(state.phase === 'closing' || state.phase === 'over');
    }
  };
  if (rows.length && words) {
    paint();
    setInterval(paint, 60_000);
  }
</script>
