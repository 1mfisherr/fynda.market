---
/**
 * A market in a list. **The only one on the site.**
 *
 * Home, city, canton, radius and saved all render this, so a change to a row
 * is a change everywhere by construction rather than by discipline. It comes
 * in two sizes and they share every part — the same day label, name, badge,
 * flag, venue line and picture. Only the frame differs:
 *
 *   variant="feature"  picture above, name at display size. The lead of a
 *                      block. A page with one size on it has no rhythm.
 *   variant="row"      picture beside, compact. Everything after the lead.
 *
 * What a row does NOT say, and why (all one rule — say the exception, never
 * the rule; BRAND.md):
 *
 *   the entry fee   151 of 157 markets are free. A price appears only when
 *                   there is one.
 *   the city        omitted where the page already names it.
 *   the freshness   silence means confirmed and recently checked. See
 *                   src/lib/freshness.ts.
 *   the kind        badged only when it is not an ordinary Flohmarkt, which
 *                   was 41 of 45 rows. See vocabulary.ts BADGED_KINDS.
 *
 * One loud thing per row: the name. Everything under it steps down a weight.
 * The check stamp ("Zuletzt geprüft 22. Mai") used to share the first line
 * with the date and the hours at the same size, and as the data aged it was
 * on five rows in seven — three loud things. It is now the last line, quiet.
 * A cancellation stays on the first line: that is status, and status is loud.
 */
import type { Market } from '../lib/types';
import { BADGED_KINDS, LINES } from '../lib/vocabulary';
import { formatTime } from '../lib/format';
import { flagFor } from '../lib/freshness';
import { DEFAULT_LOCALE, marketPath, type Locale } from '../lib/i18n';
import { t } from '../lib/strings';
import PhotoOrArt from './PhotoOrArt.astro';

interface Props {
  market: Market;
  locale?: Locale;
  /** 'feature' leads a block; 'row' is everything after it. */
  variant?: 'feature' | 'row';
  /** Leave the city off where the page already names it. */
  omitCity?: boolean;
  /** "Jeden Samstag, ganzjährig" — the line that replaces eighteen repeats. */
  showRhythm?: boolean;
  /** Rendered verbatim as a pill on the first line; the caller computed it and must never guess it. */
  distance?: string;
  /** Off where the page groups rows under a day header that already says it. */
  showDay?: boolean;
}
const {
  market, locale = DEFAULT_LOCALE, variant = 'row',
  omitCity = false, showRhythm = false, distance, showDay = true,
} = Astro.props;

const s = t(locale);
const occurrence = market.next;
const cancelled = occurrence?.status === 'cancelled';
const flag = flagFor(occurrence, s, locale);
const line = LINES[market.kind];
const badge = BADGED_KINDS.has(market.kind) ? line.short[locale] : undefined;

const day = occurrence ? new Date(`${occurrence.date}T00:00:00`) : undefined;
// "Sa. 19." is German; the ordinal dot has no business on the other three locales.
const dayLabel = showDay && day ? `${s.weekdaysShort[day.getDay()]} ${day.getDate()}${locale === 'de' ? '.' : ''}` : '';
const times = occurrence?.startTime
  ? `${formatTime(occurrence.startTime)}${occurrence.endTime ? `–${formatTime(occurrence.endTime)}` : ''}`
  : undefined;

const entry = market.entryFee ? `${market.entryFee} CHF` : undefined;
const where = [market.venueName, omitCity ? undefined : market.city, entry]
  .filter(Boolean).join(' · ');

const size = variant === 'feature' ? 720 : 148;
---

<article class:list={['card', variant, { cancelled }]} data-date={occurrence?.date} data-market={market.id}>
  <div class="pic"><PhotoOrArt market={market} width={size} height={size} /></div>
  <div class="body">
    <p class="meta">
      {dayLabel && <span class="day">{dayLabel}</span>}
      {times && <span class="hours">{times}</span>}
      {flag?.tone === 'bad' && <span class="flag bad">{flag.text}</span>}
      {/* The distance, as a pill at the end of the line. The slot is always in
          the markup and empty until someone has a real origin to measure from:
          the radius view's script fills it, and the city page's "within 25 km"
          block fills it at build time. Never a distance we guessed. */}
      <span class="km" data-distance hidden={!distance}>{distance}</span>
    </p>
    <h3 class="name">
      <a href={marketPath(locale, market.slug)}>{market.name}</a>
      {badge && <i class="badge" style={`background:var(${line.token})`}>{badge}</i>}
    </h3>
    {showRhythm && market.recurrenceText && <p class="rhythm">{market.recurrenceText}</p>}
    <p class="where">{where}</p>
    {flag?.tone === 'warn' && <p class="check">{flag.text}</p>}
  </div>
</article>

<style>
  .card { position:relative; }
  .pic { overflow:hidden; border-radius:var(--radius-sm); background:var(--color-paper); }
  .body { min-width:0; }

  /* The line above the name. The date is the one loud colour on the page —
     BRAND.md allows the accent here and nowhere else in a list. */
  .meta { display:flex; align-items:center; flex-wrap:wrap; gap:var(--space-2); margin:0; }
  .day { color:var(--color-accent); font-size:var(--text-small); font-weight:var(--weight-black); letter-spacing:var(--tracking-caps); text-transform:uppercase; white-space:nowrap; }
  .hours { color:var(--color-grey); font-size:var(--text-small); font-weight:var(--weight-semibold); white-space:nowrap; }
  .flag { font-size:var(--text-small); font-weight:var(--weight-bold); }
  .flag.bad { color:var(--color-accent); }
  .km { margin-inline-start:auto; padding:var(--space-half) var(--space-2); border-radius:var(--radius-pill); background:var(--color-ink); color:var(--color-white); font-size:var(--text-micro); font-weight:var(--weight-bold); font-variant-numeric:var(--figures-tabular); white-space:nowrap; }

  /* One loud thing. Everything below it steps down a weight. */
  .name { margin-block-start:var(--space-half); font-weight:var(--weight-bold); letter-spacing:var(--tracking-title); line-height:1.2; }
  .name a::after { position:absolute; inset:0; content:''; }
  .badge { display:inline-block; margin-inline-start:var(--space-2); padding:var(--space-half) var(--space-2); border-radius:var(--radius-pill); color:var(--color-white); font-size:var(--text-micro); font-style:normal; font-weight:var(--weight-black); letter-spacing:var(--tracking-caps); vertical-align:var(--space-half); white-space:nowrap; }
  .rhythm { margin:var(--space-1) 0 0; color:var(--color-grey); font-size:var(--text-small); font-weight:var(--weight-semibold); line-height:1.4; }
  .where { margin:var(--space-half) 0 0; color:var(--color-quiet); font-size:var(--text-small); line-height:1.4; }
  .check { margin:var(--space-half) 0 0; color:var(--color-quiet); font-size:var(--text-micro); line-height:1.4; }

  /* ---- the lead ---- */
  .feature .pic { aspect-ratio:16 / 10; margin-block-end:var(--space-3); border-radius:var(--radius-md); }
  .feature .name { font-size:var(--text-feature); font-weight:var(--weight-black); letter-spacing:var(--tracking-tight); line-height:1.14; }

  /* ---- everything after it ---- */
  .row { display:grid; grid-template-columns:var(--row-thumb) minmax(0, 1fr); gap:var(--space-4); align-items:center; padding-block:var(--space-4); border-block-end:var(--border-width) solid var(--color-line); }
  .row .pic { aspect-ratio:1; }
  .row .name { font-size:var(--text-row-name); }

  .cancelled .name a { color:var(--color-quiet); text-decoration:line-through; text-decoration-color:var(--color-line); }
  .cancelled .pic { filter:grayscale(1); opacity:0.55; }
</style>
