---
/**
 * The list row — 76px thumbnail, name, date, place.
 *
 * This is the shape the whole category uses (docs/PRODUCT.md: results grouped
 * under day headings, sorted chronologically, never by relevance). The two
 * things nobody else does are visible here: a cancelled row keeps its place
 * and says why, and it shows the next date instead of just disappearing.
 */
import type { Market } from '../lib/types';
import { formatWhen, formatDateShort } from '../lib/format';
import PlaceholderArt from './PlaceholderArt.astro';
import Icon from './Icon.astro';

interface Props {
  market: Market;
}

const { market } = Astro.props;
const o = market.next;
const cancelled = o?.status === 'cancelled';
const nextAfter = market.upcoming.find((u) => u.status !== 'cancelled');
---

<article class:list={['row', { cancelled }]}>
  <div class="thumb">
    {market.imageUrl ? (
      <img src={market.imageUrl} alt="" width="76" height="76" loading="lazy" decoding="async" />
    ) : (
      <PlaceholderArt kind={market.kind} seed={market.slug} rounded="sm" />
    )}
  </div>

  <div class="text">
    <h3 class="name"><a href={`/de/markt/${market.slug}/`}>{market.name}</a></h3>

    {o && (
      <p class="when" data-date={o.date}>
        {cancelled
          ? `Abgesagt${o.cancellationNote ? ` · ${o.cancellationNote}` : ''}`
          : formatWhen(o.date, o.startTime, o.endTime)}
      </p>
    )}

    <p class="where">
      {market.city}
      {cancelled && nextAfter && <> · nächster Termin {formatDateShort(nextAfter.date)}</>}
    </p>
  </div>

  <Icon name="chevron-right" size={20} strokeWidth={2.2} class="chev" />
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 24px;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-5);
  }

  .row + .row {
    border-top: 1px solid var(--color-line);
  }

  .thumb {
    height: 76px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-paper);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    min-width: 0;
  }

  .name {
    margin: 0;
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-snug);
  }

  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .when {
    margin: var(--space-1) 0 0;
    font-size: var(--text-date);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }

  .where {
    margin: 1px 0 0;
    font-size: var(--text-date);
    color: var(--color-grey);
  }

  .chev {
    color: var(--color-quiet);
    justify-self: end;
  }

  .cancelled .name {
    color: var(--color-quiet);
    text-decoration: line-through;
    text-decoration-color: var(--color-line);
  }

  .cancelled .when,
  .cancelled .where {
    color: var(--color-status-cancelled);
  }

  .cancelled .thumb {
    opacity: 0.55;
  }
</style>
