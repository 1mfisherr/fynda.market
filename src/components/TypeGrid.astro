---
/**
 * The market types — the block above the FAQ on the home page.
 *
 * It shows the tags exactly as the rows carry them (`.tag`, base.css), and
 * only the kinds that carry one: an ordinary flea market is the rule and has
 * no tag, so a "Flea" tile taught nothing a row would ever show. Until
 * 2026-11-02 this was five coloured tiles explaining a stripe the rows had
 * lost in October (Delfim, design/home-polish-v1.html).
 *
 * TypeLegend is the other key: two-letter codes beside a list.
 */
import { BADGED_KINDS, LEGEND, LINES } from '../lib/vocabulary';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { t } from '../lib/strings';

interface Props { locale?: Locale }
const { locale = DEFAULT_LOCALE } = Astro.props;
const s = t(locale);
const kinds = LEGEND.filter((kind) => BADGED_KINDS.has(kind));
---
<ul class="types list-reset gutter" aria-label={s.marketTypes}>
  {kinds.map((kind) => (
    <li><i class="tag" style={`--tag:var(${LINES[kind].token})`}>{LINES[kind].short[locale]}</i></li>
  ))}
</ul>

<style>
  .types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }
  /* A legend, so a size up from the row's tag: read on its own, not beside a name. */
  .types .tag { font-size: var(--text-small); line-height: 1.8; }
</style>
