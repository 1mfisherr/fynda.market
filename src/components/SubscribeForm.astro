---
/**
 * The signup, wherever a person is standing.
 *
 * It used to be a card with a button that took people to a page with a form on
 * it. A footer link and a card that leaves the page are the two worst places a
 * signup can live: a form matched to the page it sits on converts several times
 * what a generic one does, and the page someone has to travel to converts
 * whoever was already determined enough to travel.
 *
 * **It never asks where the visitor is.** A market page, a city page and a
 * canton page all carry the place in their own URL, so the form carries it in
 * a hidden field and shows one box. Only the pages that genuinely cannot know —
 * home, the footer and the newsletter page itself — draw the picker, and it
 * asks for a town, not a region (Delfim, 2026-10-10): the list of 39 cantons
 * and Länder, ungrouped, had no Munich in it, and a canton is thirty times
 * bigger in Graubünden than in Zug. Left empty, it is everywhere. It asks no
 * distance (Delfim, 2026-10-11): the digest takes the town alone, 25 km or
 * 50 km, whichever fills a mail that weekend (src/lib/digest.ts). The town is
 * picked from suggestions, never free text saved as "everywhere".
 *
 * Canton and not city: fifty-five cities is fifty-five segments, most of them
 * holding nobody; fourteen cantons is a list worth cutting. It is also roughly
 * how far a person drives on a Saturday, so somebody in Uster gets Winterthur
 * and Zürich rather than only Uster.
 */
import Button from './Button.astro';
import Honeypot from './Honeypot.astro';
import Field from './Field.astro';
import { FORMS } from '../lib/utility-copy';
import { t } from '../lib/strings';
import { getMarkets } from '../lib/markets';
import { townIndex } from '../lib/towns';
import type { RegionOption } from '../lib/regions';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /**
   * The canton this page is about. A canton page, and only a canton page.
   *
   * The bare `name`, not `regionLabel`'s "Kanton Zürich" — nothing in this
   * block says the word. The page's own heading still does, where it is what
   * separates the canton from the city of the same name.
   */
  region?: Pick<RegionOption, 'slug' | 'name'>;
  /**
   * A place and a distance, for the pages where "near me" is the real question
   * — a city page and a market page. A canton is a blunt answer there:
   * Graubünden is thirty times the size of Zug.
   */
  near?: { slug: string; name: string };
  /** Ask for a town and a distance — the pages that cannot know where the visitor is. Ignored when `region` or `near` is set. */
  pick?: boolean;
  /**
   * `card` is the block on a content page. `footer` is the one line at the
   * bottom of every page, including the legal ones where a card would be noise.
   */
  variant?: 'card' | 'footer';
  /**
   * "Tell me when it's back" in place of the weekly card (PAGES.md, 2026-10-10):
   * one e-mail the night a date appears, posted to `/b` rather than `/n`. With
   * a `market` it is about that market — a market page with no date; without,
   * about the town in `near` — a town page with nothing dated. `near` is also
   * where the optional tick subscribes the weekly mail, so an alert needs it.
   */
  alert?: { market?: { id: string; name: string } };
  /**
   * Whether this instance owns the page's `#sub-*` result ids.
   *
   * Exactly one form per page may, or the ids repeat. The footer is on every
   * page, so the footer owns them: a visitor with no JavaScript is redirected
   * to `#sub-done` and the browser takes them to the foot of whatever page they
   * were on. A card shows its own answer through the script instead.
   */
  anchors?: boolean;
}

const { locale, region, near, pick = false, variant = 'card', alert, anchors = false } = Astro.props;
const s = t(locale);
const copy = FORMS.newsletter[locale];
if (alert && !near) throw new Error('SubscribeForm: an alert needs `near`, the town it is about or around.');

/* One phrase, whichever shape this page knows: "für Zürich", or "rund um
   Zürich" — no distance, which the digest picks each week. strings.ts owns the
   prepositions — and the region one is the form's own rather than the mail's,
   because a bare canton name takes a different preposition from "Kanton
   Zürich" and not the same one in every canton. */
const scope = near
  ? s.scopeAround(near.name)
  : region
    ? s.subscribeScopeRegion(region.name)
    : null;

/* The card says what it offers in its heading; the word "Newsletter" steps down
   to a label above it. Nobody signed up to a block headed "Newsletter" (378
   views, 0 taps, 2026-09-23). An alert says what it will send, and that it is
   the only thing it will send. */
const town = near?.name ?? '';
const eyebrow = alert ? s.alertEyebrow : s.newsletterTitle;
const title = alert
  ? (alert.market ? s.alertTitleMarket : s.alertTitleTown(town))
  : s.subscribeTitle(near?.name);
const body = alert
  ? (alert.market ? s.alertBodyMarket(alert.market.name) : s.alertBodyTown(town))
  : scope ? s.subscribeBodyScope(scope) : pick ? s.subscribeBodyPick : s.newsletterBody;
const success = alert ? s.alertDone : copy.success;

/* The picker is drawn only where the page cannot answer the question itself. */
const picker = !scope && pick;
/* Every town with a market, for the suggestions under the town field
   (src/lib/town-match.ts, the town search's own rule). The script writes the
   picked town's slug; /n resolves a typed name too, for a post made with no
   script, and refuses one it does not know. */
const towns = picker
  ? townIndex(locale, await getMarkets(locale)).map((x) => [x.slug, x.name, x.region, x.country, x.n])
  : [];

/* Unique per instance, and the same on every build: a page carries the card and
   the footer at once, and two fields with the same id are two labels pointing at
   the first one. Derived rather than random, because a random id would change
   the HTML of all 944 pages every time the site is rebuilt. */
const id = `sub-${variant}`;
---
<section class={`subscribe subscribe--${variant}`} data-subscribe-block data-alert={alert ? '' : undefined}>
  {variant === 'card' && <p class="eyebrow">{eyebrow}</p>}
  {variant === 'card' && <h2>{title}</h2>}
  <p class="meta body">{body}</p>

  <form
    class="subscribe-form"
    action={alert ? '/b' : '/n'}
    method="post"
    data-subscribe
    data-alert={alert ? '' : undefined}
    data-errors={JSON.stringify(copy.errors ?? {})}
    data-success={success}
  >
    {/* What the endpoint needs from a post the browser made on its own: the
        page it came from, which fixes the language and where to send the
        visitor back to; the exact words they agreed to; and which fragment the
        answer should land on, so this form's results and the utility pages'
        never fight over one set of ids. */}
    <input type="hidden" name="path" value={Astro.url.pathname} />
    <input type="hidden" name="consent_text" value={[variant === 'card' ? title : null, body].filter(Boolean).join(' — ')} />
    <input type="hidden" name="anchor" value="sub" />
    {region && <input type="hidden" name="region" value={region.slug} />}
    {near && <input type="hidden" name="city" value={near.slug} />}
    {alert?.market && <input type="hidden" name="market" value={alert.market.id} />}
    {alert && <input type="hidden" name="weekly_consent" value={s.alertWeekly(town)} />}

    {/* The site's own field for both, so the label, the error slot and the aria
        wiring are the ones every other form already uses.

        The options are bare names — "Zürich", "Wallis" — not `regionLabel`'s
        "Kanton Zürich". Every option in this list is a canton, so the word is
        the same on all fourteen rows and carries nothing; the page's own
        heading and breadcrumb still say it, where it distinguishes the canton
        from the city that shares its name. */}
    {picker && (
      <div class="town-pick" data-town-pick>
        <Field label={s.subscribeTownLabel} name="town" type="text" hint={s.subscribeTownHint} idPrefix={id} />
        <ul class="list-reset town-sug" id={`${id}-town-list`} role="listbox" aria-label={s.subscribeTownLabel} data-town-list hidden></ul>
        <input type="hidden" name="city" value="" data-town-slug data-towns={JSON.stringify(towns)} data-unknown={s.subscribeTownUnknown} data-none={s.townNoMatch} />
      </div>
    )}

    <Field
      label={copy.fields[0].label}
      name="email"
      type="email"
      required
      placeholder={copy.fields[0].placeholder}
      idPrefix={id}
    />

    {/* Unticked: the alert is what they came for, and the weekly mail is
        an offer beside it, not a condition of it. The words are part of what
        /b records as agreed to, when ticked. */}
    {alert && (
      <label class="tick">
        <input type="checkbox" name="weekly" value="1" />
        <span>{s.alertWeekly(town)}</span>
      </label>
    )}

    <Honeypot id={id} />

    <Button type="submit" variant={variant === 'card' ? 'primary' : 'secondary'} block>
      {alert ? s.alertSend : variant === 'card' ? s.subscribeSend : copy.submit}
    </Button>
  </form>


  {/* Shown in place of the form once the address is saved. The script reveals
      it; the ids only exist on the instance that owns them. */}
  <p class="subscribe-done" id={anchors ? 'sub-done' : undefined} hidden>{success}</p>
  {anchors && (
    <>
      <p class="subscribe-done" id="sub-invalid" hidden>{copy.errors?.invalid}</p>
      <p class="subscribe-done" id="sub-failed" hidden>{copy.errors?.failed}</p>
    </>
  )}
</section>

<style>
  /* The town's suggestions: a panel under the field, over the page — the
     town search's list, at the form's size. */
  .town-pick { position: relative; }
  .town-sug { position: absolute; inset-inline: 0; z-index: 6; margin-block-start: calc(var(--space-1) * -1); max-height: 50vh; overflow-y: auto; border: var(--border-width) solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); box-shadow: 0 var(--space-3) var(--space-6) rgb(17 17 16 / 12%); }
  .town-sug[hidden] { display: none; }
  .town-sug :global(li) { display: grid; min-height: var(--tap-min); align-content: center; padding: var(--space-2) var(--space-4); border-block-start: var(--border-width) solid var(--color-line); font-weight: var(--weight-semibold); cursor: pointer; }
  .town-sug :global(li:first-child) { border-block-start: 0; }
  .town-sug :global(li[aria-selected='true']) { background: var(--color-paper); }
  .town-sug :global(.where) { color: var(--color-quiet); font-size: var(--text-micro); font-weight: var(--weight-regular); }
  .town-sug :global(.none) { color: var(--color-quiet); font-weight: var(--weight-regular); cursor: default; }
  .subscribe { display: grid; gap: var(--space-3); }

  .subscribe--card {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }

  .subscribe .eyebrow { margin: 0 0 calc(var(--space-2) * -1); }
  .subscribe h2 { margin: 0; }
  .subscribe .body { color: var(--color-grey); }

  .subscribe-form { display: grid; gap: var(--space-3); }

  .tick { display: flex; gap: var(--space-2); align-items: flex-start; font-size: var(--text-small); line-height: var(--leading-snug); cursor: pointer; }
  .tick input { flex: none; width: var(--space-5); height: var(--space-5); margin: 0; accent-color: var(--color-ink); }

  /* The note is the consent wording, so it is never hidden and never shortened
     — it is what the row records the visitor as having agreed to. */
  .subscribe .note { font-size: var(--text-micro); color: var(--color-quiet); }

  /* The footer's copy sits above a rule that already separates it from the
     links, so it needs no panel of its own. */
  .subscribe--footer { gap: var(--space-2); }
  .subscribe--footer .body { font-weight: var(--weight-bold); color: var(--color-ink); }

  /* Revealed by the script, or by `:target` when there is no script. */
  .subscribe-done { font-weight: var(--weight-bold); }
  .subscribe-done:target { display: block !important; }

</style>

<script>
  /**
   * Every signup block on the page, submitted in place.
   *
   * All of it is an enhancement: each form carries `action="/n"` and
   * `method="post"`, so with no JavaScript the browser posts it and the
   * endpoint answers with a redirect to `#sub-done`, which the footer's copy
   * of that message reveals through CSS `:target`. Nothing here is
   * load-bearing.
   */
  import { townMatcher } from '../lib/town-match';

  const forms = document.querySelectorAll<HTMLFormElement>('form[data-subscribe]');

  type PickTown = { slug: string; name: string; region: string; country: string; n: number };
  const escHtml = (v: string) => v.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  /**
   * The town field: suggestions as you type, and only a picked (or exactly
   * typed) town counts. Typing again forgets the pick, so gibberish after a
   * pick is never saved as the town picked before it.
   */
  function townField(form: HTMLFormElement) {
    const box = form.querySelector<HTMLElement>('[data-town-pick]');
    const slugField = form.querySelector<HTMLInputElement>('[data-town-slug]');
    const input = form.elements.namedItem('town') as HTMLInputElement | null;
    const list = box?.querySelector<HTMLUListElement>('[data-town-list]');
    if (!box || !slugField || !input || !list) return null;
    const towns: PickTown[] = (JSON.parse(slugField.dataset.towns ?? '[]') as [string, string, string, string, number][])
      .map(([slug, name, region, country, n]) => ({ slug, name, region, country, n }));
    const matcher = townMatcher(towns);
    const error = input.closest('.field')?.querySelector<HTMLElement>('.field-error') ?? null;
    let shown: PickTown[] = [];
    let active = -1;

    input.setAttribute('role', 'combobox');
    input.setAttribute('aria-autocomplete', 'list');
    input.setAttribute('aria-controls', list.id);
    input.setAttribute('aria-expanded', 'false');
    input.setAttribute('autocomplete', 'off');
    input.setAttribute('autocapitalize', 'words');
    input.setAttribute('spellcheck', 'false');

    const open = (yes: boolean) => {
      list.hidden = !yes;
      input.setAttribute('aria-expanded', String(yes));
      if (!yes) input.removeAttribute('aria-activedescendant');
    };
    const hideError = () => { if (error) { error.hidden = true; error.textContent = ''; } input.removeAttribute('aria-invalid'); };
    const render = () => {
      const q = input.value.trim();
      shown = matcher.match(q);
      active = -1;
      if (!q) { open(false); return; }
      list.innerHTML = shown.length
        ? shown.map((t, i) => `<li role="option" id="${list.id}-${i}" aria-selected="false" data-i="${i}"><span>${escHtml(t.name)}</span><span class="where">${escHtml(`${t.region} · ${t.country}`)}</span></li>`).join('')
        : `<li class="none" aria-disabled="true">${escHtml(slugField.dataset.none ?? '')}</li>`;
      open(true);
    };
    const pick = (t: PickTown) => {
      input.value = t.name;
      slugField.value = t.slug;
      hideError();
      open(false);
    };
    const move = (to: number) => {
      if (!shown.length) return;
      active = (to + shown.length) % shown.length;
      for (const li of Array.from(list.querySelectorAll('[role=option]'))) li.setAttribute('aria-selected', String(li.getAttribute('data-i') === String(active)));
      input.setAttribute('aria-activedescendant', `${list.id}-${active}`);
    };

    input.addEventListener('input', () => { slugField.value = ''; hideError(); render(); });
    input.addEventListener('focus', () => { if (!slugField.value) render(); });
    input.addEventListener('keydown', (event) => {
      if (list.hidden) return;
      if (event.key === 'ArrowDown') { event.preventDefault(); move(active + 1); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); move(active - 1); }
      else if (event.key === 'Enter') { event.preventDefault(); const t = shown[active >= 0 ? active : 0]; if (t) pick(t); }
      else if (event.key === 'Escape') open(false);
    });
    list.addEventListener('mousedown', (event) => event.preventDefault());
    list.addEventListener('click', (event) => {
      const li = (event.target as HTMLElement).closest<HTMLElement>('[data-i]');
      const t = li ? shown[Number(li.dataset.i)] : undefined;
      if (t) pick(t);
    });
    document.addEventListener('click', (event) => { if (!box.contains(event.target as Node)) open(false); });

    /** The slug to post, '' for everywhere, or null when the name is unknown (the error is shown). */
    return (): string | null => {
      const typed = input.value.trim();
      if (!typed) { slugField.value = ''; return ''; }
      if (!slugField.value) {
        const exact = matcher.exact(typed);
        if (exact) pick(exact);
      }
      if (slugField.value) return slugField.value;
      if (error) { error.textContent = slugField.dataset.unknown ?? ''; error.hidden = false; }
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return null;
    };
  }

  for (const form of forms) {
    const block = form.closest('[data-subscribe-block]') as HTMLElement | null;
    const email = form.elements.namedItem('email') as HTMLInputElement | null;
    // The e-mail's own slot: a town field above it has one too.
    const error = email?.closest('.field')?.querySelector<HTMLElement>('.field-error') ?? null;
    const done = block?.querySelector<HTMLElement>('.subscribe-done') ?? null;
    const errors = JSON.parse(form.dataset.errors ?? '{}') as Partial<
      Record<'empty' | 'invalid' | 'failed' | 'offline', string>
    >;

    if (!email) continue;
    const resolveTown = townField(form);

    /* Milliseconds from the first touch of this form, not from page load. The
       endpoint throws away a fill no person could have typed; measured from
       page load it would throw away real people instead, and answer them with
       a success. */
    let firstTouch = 0;
    const touched = () => { if (!firstTouch) firstTouch = Date.now(); };
    form.addEventListener('focusin', touched);
    form.addEventListener('input', touched);

    // With a script we take over the checking, because the browser's own bubble
    // speaks the browser's language rather than the page's and tells a screen
    // reader nothing. With no script the browser's checks are all there is.
    form.noValidate = true;

    /* Loose on purpose: this decides whether to interrupt someone, so it may
       only reject what is certainly wrong. The endpoint is the real check. */
    const looksLikeAddress = (value: string) => /^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(value);

    const show = (message: string) => {
      if (!error) return;
      error.textContent = message;
      error.hidden = false;
      email.setAttribute('aria-invalid', 'true');
      email.focus();
    };

    const clear = () => {
      if (!error) return;
      error.hidden = true;
      error.textContent = '';
      email.removeAttribute('aria-invalid');
    };

    /* After they leave the field, never while they are still typing: an address
       is invalid for as long as it takes to type one. */
    email.addEventListener('blur', () => {
      const value = email.value.trim();
      if (value && !looksLikeAddress(value)) {
        if (error) { error.textContent = errors.invalid ?? ''; error.hidden = false; }
        email.setAttribute('aria-invalid', 'true');
      } else {
        clear();
      }
    });
    email.addEventListener('input', clear);

    let failures = 0;

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      /* The town first: it is the field above. A name we do not know is
         asked about rather than quietly saved as "everywhere". */
      if (resolveTown && resolveTown() === null) return;

      const value = email.value.trim();
      if (!value) { show(errors.empty ?? ''); return; }
      if (!looksLikeAddress(value)) { show(errors.invalid ?? ''); return; }

      clear();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;

      /* Every field the form holds, so a hidden field added to the markup
         is posted without anyone remembering to add it here. This list was
         written out by hand until 2026-09-23, and it had left out the town
         and the distance: every signup from a town or market page was saved
         as "the whole country". Only what the browser alone knows is added. */
      const fields = Object.fromEntries(
        [...new FormData(form).entries()].filter((entry): entry is [string, string] => typeof entry[1] === 'string')
      );

      void fetch(form.getAttribute('action') ?? '/n', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({
          ...fields,
          email: value,
          elapsed_ms: firstTouch ? Date.now() - firstTouch : null,
          path: location.pathname,
        }),
      })
        .then((res) => (res.ok ? 'ok' : res.status === 422 ? 'invalid' : 'failed'))
        .catch(() => 'offline')
        .then((outcome) => {
          if (button) button.disabled = false;

          /* Tell the page what happened, in the words the analytics constraint
             uses. Analytics.astro listens for this rather than for the submit,
             because a submit event knows only that somebody pressed the button
             — and a signup that was refused looks identical to one that
             worked. The funnel is only worth having if the last step is true. */
          /* An alert is its own funnel, counted in its own table (date_alerts);
             telling analytics it was a newsletter signup would blur both. Its
             weekly tick is a newsletter signup, though, and went uncounted
             until 2026-10-23 (the first one that day had no event). */
          const weekly = form.hasAttribute('data-alert') && fields.weekly === '1';
          if (!form.hasAttribute('data-alert') || (weekly && outcome === 'ok')) form.dispatchEvent(new CustomEvent('fynda:newsletter', {
            bubbles: true,
            detail: {
              outcome:
                outcome === 'ok' ? 'ok'
                : outcome === 'invalid' ? 'validation_error'
                : 'server_error',
            },
          }));

          if (outcome === 'ok') {
            form.hidden = true;
            const note = block?.querySelector<HTMLElement>('.note');
            if (note) note.hidden = true;
            if (done) {
              done.hidden = false;
              done.setAttribute('tabindex', '-1');
              done.focus();
            }
            return;
          }

          if (outcome === 'invalid') { show(errors.invalid ?? ''); return; }

          failures += 1;
          show(outcome === 'offline' ? errors.offline ?? '' : errors.failed ?? '');
        });
    });
  }
</script>
