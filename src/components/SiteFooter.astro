---
/**
 * The foot of every page.
 *
 * Deliberately not a link farm. PAGES.md: no city list down here — it
 * duplicated the cities block further up, and a bare list of place links is
 * the doorway shape that a spam update reads as a doorway. What is here is
 * navigation to the pages that are not in the body of any listing: the forms,
 * the legal text, and the visitor's own saved markets.
 *
 * Every link goes through utilityPath, so a locale without its own copy of a
 * page links to the German one rather than to a 404 — see i18n.ts.
 */
import Wordmark from './Wordmark.astro';
import SubscribeForm from './SubscribeForm.astro';
import { DEFAULT_LOCALE, LOCALE, localeTag, nearbyPath, utilityPath, type Locale } from '../lib/i18n';
import { regionOptions } from '../lib/regions';
import { t } from '../lib/strings';

interface Props {
  locale?: Locale;
  /** The same page in the other languages — the switcher at the foot. */
  alternates?: { locale: Locale; path: string }[];
  /**
   * False on a page that carries its own signup card. Two identical forms on
   * one page is one too many, and the card is the one placed where people
   * read; the footer keeps its Newsletter link. The card then owns the
   * `#sub-*` ids (its `anchors` prop).
   */
  signup?: boolean;
}
const { locale = DEFAULT_LOCALE, alternates = [], signup = true } = Astro.props;
const s = t(locale);
const year = new Date().getFullYear();

/*
 * The one signup that is on literally every page, legal text included, where a
 * card would be noise. It carries the picker rather than a canton: the footer
 * cannot know what the page is about, and the pages that can know already put
 * the canton into a card of their own further up.
 *
 * It also owns the page's `#sub-*` result ids, because it is the only signup
 * block guaranteed to be present — a visitor with no JavaScript is redirected
 * here and lands on the answer.
 */
const cantons = await regionOptions(locale);

const fynda = [
  { href: utilityPath(locale, 'about'), label: s.footerAbout },
  { href: utilityPath(locale, 'organiser'), label: s.footerOrganisers },
  { href: utilityPath(locale, 'newsletter'), label: s.footerNewsletter },
  { href: utilityPath(locale, 'report'), label: s.footerReport },
  { href: nearbyPath(locale), label: s.footerNearby },
  { href: utilityPath(locale, 'saved'), label: s.saved },
];
const legal: { href: string; label: string; cookies?: boolean }[] = [
  { href: utilityPath(locale, 'imprint'), label: s.footerImprint },
  { href: utilityPath(locale, 'privacy'), label: s.footerPrivacy },
  { href: utilityPath(locale, 'terms'), label: s.footerTerms },
];
---
<footer class="site-footer wrapper">
  <div class="brand gutter">
    <Wordmark locale={locale} />
    <p class="meta">{s.footerTagline}</p>
  </div>

  {signup && (
    <div class="signup gutter">
      <SubscribeForm locale={locale} options={cantons} variant="footer" anchors />
    </div>
  )}

  <div class="cols gutter">
    <nav aria-labelledby="foot-fynda">
      <h2 class="eyebrow" id="foot-fynda">{s.footerFynda}</h2>
      <ul class="list-reset">{fynda.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav aria-labelledby="foot-legal">
      <h2 class="eyebrow" id="foot-legal">{s.footerLegal}</h2>
      <ul class="list-reset">{legal.map((l) => <li><a href={l.href} data-cookies-open={l.cookies ? '' : undefined}>{l.label}</a></li>)}</ul>
    </nav>
  </div>

  {alternates.length > 1 && (
    <nav class="langs gutter" aria-label={s.languageLabel}>
      {alternates.map((alt) => (
        <a href={alt.path} lang={localeTag(alt.locale)} hreflang={localeTag(alt.locale)}
           aria-current={alt.locale === locale ? 'true' : undefined}>{LOCALE[alt.locale].label}</a>
      ))}
    </nav>
  )}

  <p class="base gutter">© {year} fynda.market</p>
</footer>

<style>
  .signup {
    padding-block: var(--space-4);
    border-block-end: var(--border-width) solid var(--color-line);
    margin-block-end: var(--space-4);
  }

  .site-footer {
    padding-block: var(--space-6) var(--space-7);
    border-block-start: var(--border-width) solid var(--color-line);
    background: var(--color-paper);
    font-size: var(--text-small);
  }
  .site-footer > * + * { margin-block-start: var(--space-5); }

  .brand p { margin-block-start: var(--space-1); max-width: var(--measure); }

  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .cols h2 { color: var(--color-quiet); }
  .cols ul { margin-block-start: var(--space-2); }
  .cols li + li { margin-block-start: var(--space-1); }
  .cols a { display: inline-block; padding-block: var(--space-half); font-weight: var(--weight-semibold); }

  .langs { display: flex; flex-wrap: wrap; gap: var(--space-3); color: var(--color-grey); font-size: var(--text-micro); }
  .langs a { font-weight: var(--weight-semibold); }
  .langs a[aria-current] { color: var(--color-ink); }

  .base {
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-line);
    color: var(--color-quiet);
    font-size: var(--text-micro);
  }

  /* Two columns: everything about the site on the left, the signup down the
     right, and the language switcher and copyright spanning the foot.

     Every cell is placed rather than flowed. Left to the grid's own order the
     signup took the right of the first row and the link columns took the left
     of the second, so the first row was a 60px wordmark beside a 390px form —
     a 330px hole — and the second was the links beside nothing at all. The two
     halves of the footer were empty in opposite corners.

     Keep in step with --breakpoint-wide; a media query cannot read a token. */
  @media (min-width: 900px) {
    .site-footer {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      column-gap: var(--space-7);
      row-gap: var(--space-6);
      align-items: start;
    }
    .site-footer > * + * { margin-block-start: 0; }

    .brand  { grid-area: 1 / 1; }
    .cols   { grid-area: 2 / 1; }
    .signup { grid-area: 1 / 2 / span 2 / auto; }
    .langs, .base { grid-column: 1 / -1; }

    /* The rule and the space under it separate the signup from what follows it
       in one stacked column. In two columns nothing follows it, so the rule was
       a line drawn under the right-hand half of the footer and nothing else. */
    .signup { padding-block: 0; border-block-end: 0; margin-block-end: 0; }

    /* Hugging their content rather than halving 700px. Two lists of six short
       links do not need 340px each, and at that width the second column reads
       as unrelated to the first. */
    .cols { grid-template-columns: repeat(2, minmax(0, max-content)); column-gap: var(--space-7); }
  }
</style>
