---
/**
 * The five lines, from the vocabulary. It used to carry its own copy of the
 * labels — which is how the legend said "Halle" while the market page said
 * "Hallenflohmarkt" for the same kind.
 */
import LineCode from './LineCode.astro';
import { LEGEND, LINES } from '../lib/vocabulary';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { t } from '../lib/strings';

interface Props { locale?: Locale }
const { locale = DEFAULT_LOCALE } = Astro.props;
const s = t(locale);
---
<aside class="legend gutter" aria-label={s.marketTypes}>
  {LEGEND.map((kind) => <span><LineCode kind={kind} /> {LINES[kind].short[locale]}</span>)}
</aside>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .legend span {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-grey);
    font-size: var(--text-micro);
    font-weight: var(--weight-bold);
  }
</style>
