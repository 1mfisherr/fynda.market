---
/**
 * The masthead, once. It was re-typed in all three pages before this existed,
 * and had already drifted: two of them styled `header` differently.
 */
import Wordmark from './Wordmark.astro';
import { DEFAULT_LOCALE, homePath, localeTag, nearbyPath, utilityPath, type Locale } from '../lib/i18n';
import { t } from '../lib/strings';

interface Props {
  locale?: Locale;
  /** The same page in the other languages, for the switcher. */
  alternates?: { locale: Locale; path: string }[];
}
const { locale = DEFAULT_LOCALE, alternates = [] } = Astro.props;
const s = t(locale);
const others = alternates.filter((a) => a.locale !== locale);

/**
 * Above 900px the masthead had a logo, four language codes and Gemerkt in it,
 * and scrolling was the only way to reach anything else. These are the three
 * ways into the site that are not a market: the town list, the canton list and
 * the radius view.
 *
 * Städte and Kantone are blocks of the home page rather than pages of their
 * own, so they are anchors into it — honest from anywhere on the site, and
 * they stop being anchors by themselves the day a country page exists.
 *
 * Labels are the footer's, not new ones: one word per idea across the site.
 */
/* The regions entry used to point at #kantone. With a second country the front
   door has one places block per country, so that id only exists while there is
   one — the towns anchor is the one that survives both. */
const sections = [
  { href: `${homePath(locale)}#staedte`, label: s.cities },
  { href: nearbyPath(locale), label: s.footerNearby },
];
---
<header class="site-header wrapper">
  {/* No back chevron. It used to sit here on deep pages, which put the logo in
      a different place on every page but the home one — and the browser
      already has a back button. */}
  <Wordmark locale={locale} size="grows" />

  {/* Hidden on a phone, where the line is already full — see the note in the
      stylesheet below. The links exist in the footer at every width. */}
  <nav class="sections" aria-label={s.navLabel}>
    {sections.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <div class="lead">
    {/* Real links, not a script-driven picker: a language switcher that search
        engines cannot follow is how one locale never gets discovered. */}
    {others.length > 0 && (
      <nav class="langs" aria-label={s.languageLabel}>
        {others.map((alt) => (
          <a href={alt.path} lang={localeTag(alt.locale)} hreflang={localeTag(alt.locale)}>{alt.locale.toUpperCase()}</a>
        ))}
      </nav>
    )}
    <a class="saved" href={utilityPath(locale, 'saved')}>{s.saved}</a>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-page);
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
  }
  .lead { display: flex; align-items: center; gap: var(--space-2); }

  /* A phone header already carries the mark, four language codes and Gemerkt
     on one line; a fourth group pushes something off the end. The same links
     are in the footer, so nothing is unreachable — this is the desk getting
     the room the phone does not have. */
  .sections { display: none; }
  .langs { display: flex; gap: var(--space-half); color: var(--color-quiet); font-size: var(--text-micro); }
  /* A tap target of at least 44px, without the row growing: the padding is
     the target, the row keeps its line height. It was a 20px-wide letter pair. */
  .langs a { padding: var(--space-3) var(--space-1); margin-block: calc(-1 * var(--space-3)); }
  /* The mark and Gemerkt are 20px tall as text; the same trick gives them a
     target of at least 24px without moving the row. */
  .site-header > :global(.mark), .saved { padding-block: var(--space-2); margin-block: calc(-1 * var(--space-2)); }

  /* Nothing is competing for the line any more, so the mark goes back up the
     type ramp. Keep in step with --breakpoint-wide. */
  @media (min-width: 900px) {
    .site-header { padding-block: var(--space-4); }
    .lead { gap: var(--space-4); }
    /* `justify-content: space-between` would push the links to the middle of
       the bar. They belong beside the mark, so the mark takes the slack. The
       mark is a child component, hence the global selector, scoped by the
       header's own class. */
    .site-header > :global(.mark) { margin-inline-end: auto; }
    .sections {
      display: flex;
      gap: var(--space-5);
      margin-inline-end: var(--space-6);
      color: var(--color-grey);
      font-weight: var(--weight-semibold);
    }
    .sections a:hover { color: var(--color-ink); }
  }
</style>
