---
/**
 * The masthead, once. It was re-typed in all three pages before this existed,
 * and had already drifted: two of them styled `header` differently.
 */
import { DEFAULT_LOCALE, LOCALE, homePath, utilityPath, type Locale } from '../lib/i18n';
import { t } from '../lib/strings';

interface Props {
  locale?: Locale;
  /** The same page in the other languages, for the switcher. */
  alternates?: { locale: Locale; path: string }[];
}
const { locale = DEFAULT_LOCALE, alternates = [] } = Astro.props;
const s = t(locale);
const others = alternates.filter((a) => a.locale !== locale);
---
<header class="site-header wrapper">
  {/* The mark and nothing else. A back chevron used to sit here on deep pages,
      which put the logo in a different place on every page but the home one —
      and the browser already has a back button. */}
  <a class="mark" href={homePath(locale)}>fynda<span>.</span>market</a>
  <div class="lead">
    {/* Real links, not a script-driven picker: a language switcher that search
        engines cannot follow is how one locale never gets discovered. */}
    {others.length > 0 && (
      <nav class="langs" aria-label={s.languageLabel}>
        {others.map((alt) => (
          <a href={alt.path} lang={LOCALE[alt.locale].tag} hreflang={LOCALE[alt.locale].tag}>{alt.locale.toUpperCase()}</a>
        ))}
      </nav>
    )}
    <a class="saved" href={utilityPath(locale, 'saved')}>{s.saved}</a>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-page);
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
  }
  .lead { display: flex; align-items: center; gap: var(--space-2); }
  .langs { display: flex; gap: var(--space-1); color: var(--color-quiet); font-size: var(--text-micro); }
  .langs a { padding-inline: var(--space-half); }
  .mark {
    /* "fynda.market" is twice the width of "fynda." and has to share a phone
       line with the language switcher and Gemerkt, so it takes the next step
       down the type ramp rather than pushing them off the end. */
    font-size: var(--text-date);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-display);
  }
  /* The only decorative use of the accent on the site, and it is the logo. */
  .mark span { color: var(--color-accent); }
</style>
