---
/**
 * The logo, and the only place it is drawn.
 *
 * The name is "fynda.market", the way Booking.com is not "Booking" — the whole
 * thing is the logo and it is allowed to be read. Since 2026-09-17 it is an
 * image, `public/brand/fynda-wordmark.svg`: a soft serif with the `y` and the
 * dot in the accent. It is never typed in the site font again; the SVG's
 * fills are the token values from tokens.css by hand, so a changed accent is
 * changed in both files. The dot is the one decorative use of the accent on
 * the site (docs/BRAND.md); everything else the accent touches is a date or
 * a status.
 *
 * Header and footer used to each carry their own copy of this markup and
 * these rules, and the pages a Cloudflare Function renders carried a third
 * version with no dot at all (2026-09-16). One component, one mark; the
 * Function pages and the e-mails mirror it by hand in functions/_page.ts and
 * functions/_mail.ts, because a Function may not import from src/ — change
 * this and change those.
 *
 * `size` picks the step on the type ramp: the header grows above 900px, the
 * footer does not.
 */
import { homePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  size?: 'title' | 'grows';
}
const { locale, size = 'title' } = Astro.props;
---
<a class:list={['mark', size]} href={homePath(locale)}>
  <img src="/brand/fynda-wordmark.svg" alt="fynda.market" width="1995" height="350" />
</a>

<style>
  /* The image runs ascender to descender, so 1.15 × the type size puts its
     letters at the height the typed name had. Width follows the SVG's ratio. */
  .mark {
    display: inline-block;
    line-height: 0;
    font-size: var(--text-title);
  }
  .mark img {
    display: block;
    height: calc(1.15 * var(--text-title));
    width: auto;
  }

  /* Keep in step with --breakpoint-wide. */
  @media (min-width: 900px) {
    .grows img { height: calc(1.15 * var(--text-section)); }
  }
</style>
