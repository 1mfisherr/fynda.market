---
/**
 * One labelled control. The shape lives in styles/base.css so a page that needs
 * a plain <input> can wear `.field` without importing anything.
 *
 * All three forms post to an endpoint of their own now — /n, /r and /o — and
 * each says so on its own page. A form that silently discards what someone
 * typed is worse than no form.
 */
import type { FormOption } from '../lib/utility-copy';

interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'textarea' | 'select';
  hint?: string;
  required?: boolean;
  placeholder?: string;
  options?: FormOption[];
  /** Namespaces the id, for a page carrying more than one of the same field. */
  idPrefix?: string;
}
const {
  label, name, type = 'text', hint, required = false, placeholder, options = [], idPrefix = 'f',
} = Astro.props;
/* `f-email` was fine while only one form was ever on a page. The signup block
   now sits in the footer of every page and in a card on most of them, so two
   fields would answer to the same id and both labels would point at the first
   one. The prefix is what keeps them apart. */
const id = `${idPrefix}-${name}`;

/**
 * Every field carries an empty message of its own, hidden until something goes
 * wrong. It is in the markup rather than created by script so that the control
 * can point at it from the start: a description that appears only after the
 * error does is announced late or not at all.
 *
 * The hint is described too, where there is one, so a screen reader reads the
 * instruction and the error rather than only whichever came last.
 */
const hintId = hint ? `${id}-hint` : null;
const errorId = `${id}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');
---
<label class="field" for={id}>
  <span>{label}</span>
  {hint && <span class="hint" id={hintId}>{hint}</span>}
  {type === 'textarea' && (
    <textarea id={id} name={name} required={required} placeholder={placeholder} aria-describedby={describedBy}></textarea>
  )}
  {type === 'select' && (
    <select id={id} name={name} required={required} aria-describedby={describedBy}>
      {options.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
  )}
  {(type === 'text' || type === 'email') && (
    <input id={id} type={type} name={name} required={required} placeholder={placeholder} aria-describedby={describedBy} />
  )}
  <p class="field-error" id={errorId} hidden></p>
</label>
