---
/**
 * The events only a browser can see.
 *
 * Page views are NOT sent from here — they are counted at the edge in
 * functions/_middleware.ts, where an ad blocker cannot remove them. This file
 * covers the other half: what someone did once the page was in front of them.
 * Losing some of that to a blocker is acceptable; losing page views is not.
 *
 * Every event's `props` shape is fixed by a check constraint on
 * analytics_events — exact key names, exact allowed values. That is deliberate
 * and worth obeying to the letter: it is what stops this file inventing a
 * second vocabulary six months from now and quietly splitting the numbers in
 * two. If a value here is wrong the row is rejected, which is the correct
 * failure and the reason the collector logs rejections.
 *
 * It listens at the document rather than asking every component to report
 * itself, so adding a link to a page never means remembering to instrument it.
 */
---
<script>
  import { onCLS, onINP, onLCP, onTTFB, onFCP } from 'web-vitals';

  const ENDPOINT = '/e';

  /** One id per tab, gone when the tab closes. Groups a sitting; not identity. */
  const sessionId = (() => {
    try {
      const key = 'fynda:session';
      let id = sessionStorage.getItem(key);
      if (!id) { id = crypto.randomUUID(); sessionStorage.setItem(key, id); }
      return id;
    } catch { return crypto.randomUUID(); }
  })();

  /** One id per page load, so a click can be tied to the view it came from. */
  const pageViewId = crypto.randomUUID();

  function send(event_name: string, props: Record<string, unknown>, el?: Element | null) {
    const market = el?.closest<HTMLElement>('[data-market]')?.dataset.market;
    const body = JSON.stringify({
      event_name,
      path: location.pathname,
      session_id: sessionId,
      page_view_id: pageViewId,
      market_id: market ?? null,
      viewport_w: window.innerWidth,
      props,
    });

    // sendBeacon survives the page being torn down by the navigation the click
    // just started — which is exactly when an outbound click happens.
    try {
      if (navigator.sendBeacon) {
        navigator.sendBeacon(ENDPOINT, new Blob([body], { type: 'application/json' }));
        return;
      }
    } catch { /* fall through */ }
    fetch(ENDPOINT, { method: 'POST', body, keepalive: true, headers: { 'Content-Type': 'application/json' } })
      .catch(() => { /* analytics never breaks a page */ });
  }

  /** The constraint wants a bare lowercase hostname and nothing else. */
  const hostOf = (href: string) => {
    try { return new URL(href, location.origin).hostname.toLowerCase(); } catch { return ''; }
  };

  /**
   * Which list a row was clicked in, in the constraint's own vocabulary.
   *
   * Decided by the page, not by a container: `#list` is the row holder on the
   * city page, the saved page AND the radius view, so keying off it labelled
   * every city-page click "nearby". The path is the thing that actually
   * differs.
   */
  const RADIUS_PAGE = /^\/(de|fr|it|en)\/(umkreis|a-proximite|nei-dintorni|nearby)\//;
  const HOME_PAGE = /^\/(de|fr|it|en)\/$/;
  function surfaceOf(el: Element): string {
    if (RADIUS_PAGE.test(location.pathname)) return 'nearby';
    // The home page leads with the weekend; anything below it is still a list.
    if (HOME_PAGE.test(location.pathname) && el.closest('section')?.querySelector('h2')) {
      return 'weekend_rail';
    }
    return 'list';
  }

  /** Where a row sat when it was clicked — 1-based, as a person would count. */
  function positionOf(el: Element): number {
    const row = el.closest('[data-date], .pin, li');
    if (!row?.parentElement) return 0;
    return [...row.parentElement.children].indexOf(row) + 1;
  }

  document.addEventListener('click', (event) => {
    const el = (event.target as Element | null)?.closest?.('a, button');
    if (!el) return;
    const href = el.getAttribute('href');

    // Leaving the site is the conversion: on v1, 55% of it was directions and
    // 45% the organiser's own page. PAGES.md calls this the whole funnel.
    if (href && /^https?:/i.test(href) && !href.startsWith(location.origin)) {
      const maps = /google\.[a-z.]+\/maps|maps\.app\.goo\.gl|openstreetmap|apple\.com\/maps/i.test(href);
      send('outbound_click', {
        click_type: maps ? 'directions' : /facebook|instagram|tiktok|x\.com|twitter/i.test(href) ? 'social' : 'organiser_website',
        destination_host: hostOf(href),
      }, el);
      return;
    }

    // A phone number is a lead too; there is no host, so the word stands in.
    if (href?.startsWith('tel:')) { send('outbound_click', { click_type: 'phone', destination_host: 'tel' }, el); return; }

    if (href?.endsWith('.ics')) { send('calendar_add', { method: 'ics' }, el); return; }

    // A row's link into a market page: how a list becomes a visit.
    if (href && /\/(markt|marche|mercato|market)\/[a-z0-9-]+\/$/.test(href)) {
      send('market_click', { position: positionOf(el), surface: surfaceOf(el) }, el);
      return;
    }

    // The date control and the radius buttons are both filters. `zeit` carries
    // a named window or one YYYY-MM-DD, which is what date-window.ts reads.
    const filter = (el as HTMLElement).dataset.filter;
    if (filter) { send('filter_changed', { filter: 'zeit', value: filter }, el); return; }

    const km = (el as HTMLElement).dataset.km;
    if (km) { send('filter_changed', { filter: 'umkreis', value: km }, el); return; }

    // A town from the search control's sheet. The form this replaced reported
    // `ort` on submit; the sheet's rows are links, so it is a click now.
    const ort = (el as HTMLElement).dataset.townSlug;
    if (ort) { send('filter_changed', { filter: 'ort', value: ort }, el); return; }

    if ((el as HTMLElement).dataset.save !== undefined) {
      // The button reports what it became, so add and remove stay separable.
      const added = el.getAttribute('aria-pressed') !== 'true';
      send('market_save', { action: added ? 'add' : 'remove' }, el);
      return;
    }

    if (href && /\/(melden|report|signaler|segnalare)\//.test(href)) {
      // `grund` is the value the reports table stores — the same vocabulary the
      // chip, the select and the column use. It said `ausgefallen` here until
      // 2026-09-10, a German word from an earlier draft that nothing has sent
      // since the keys became the database's own, so every cancellation was
      // being filed as a correction.
      const grund = new URLSearchParams(href.split('?')[1] ?? '').get('grund');
      send('report_open', { kind: grund === 'cancelled' ? 'cancellation' : 'correction' }, el);
      return;
    }

    // The organiser's own ask: "this is my market". A different queue, a
    // different person, and the start of the only relationship this site has.
    if (href && /\/(veranstalter|organisateurs|organizzatori|organisers)\//.test(href)) {
      send('report_open', { kind: 'organiser' }, el);
    }
  }, { capture: true, passive: true });

  document.addEventListener('submit', (event) => {
    const form = event.target as HTMLFormElement | null;
    if (!form) return;

    // The search card is a place-and-time chooser, not a text search — the site
    // has no free-text box, and v1's data says nobody wanted one. So it reports
    // the two filters it actually sets rather than a `search` event with a
    // `term` nobody typed.
    if (form.classList.contains('search')) {
      const data = new FormData(form);
      const ort = String(data.get('ort') ?? '');
      const zeit = String(data.get('zeit') ?? '');
      if (ort) send('filter_changed', { filter: 'ort', value: ort }, form);
      if (zeit) send('filter_changed', { filter: 'zeit', value: zeit }, form);
    }

  }, { capture: true, passive: true });

  /**
   * The signup reports its own outcome.
   *
   * This used to listen for a submit on `form[data-newsletter]` and record
   * `outcome: 'ok'` for every one of them. Two things were wrong with it: the
   * attribute was renamed to `data-subscribe` when the form moved onto every
   * page, so nothing had matched it since — not one `newsletter_submit` row
   * exists — and a submit event cannot know whether the address was accepted,
   * so the outcome it recorded was a guess that was always the same.
   *
   * SubscribeForm knows the answer and says so. A visitor with JavaScript off
   * posts the form itself and is counted by nothing here; that is the same
   * trade as every other event in this file.
   */
  /**
   * The near-me ask, step by step: `requested` on the tap, then `granted` or
   * `denied` with the reason. The search control and the radius view both
   * raise it; neither knows or cares that it is counted. granted ÷ requested
   * is the number the near-me page is judged on (docs/specs/near-me.md).
   */
  document.addEventListener('fynda:geo', (event) => {
    const detail = (event as CustomEvent<{ outcome?: string; reason?: string }>).detail;
    if (!detail?.outcome) return;
    send('geo_prompt', detail.reason ? { outcome: detail.outcome, reason: detail.reason } : { outcome: detail.outcome });
  });

  document.addEventListener('fynda:newsletter', (event) => {
    const detail = (event as CustomEvent<{ outcome?: string }>).detail;
    if (!detail?.outcome) return;
    send('newsletter_submit', { outcome: detail.outcome }, event.target as Element);
  });

  /**
   * "Nothing matched" is the most valuable event and the most commonly missed,
   * because it usually hides inside a search that returned zero rows. It has
   * its own name in the schema so a query cannot overlook it.
   *
   * The constraint wants a `term` — it was designed for a typed search. Ours is
   * the filter the visitor actually expressed, which is the same question asked
   * a different way: a date, a radius, or the word for "everything".
   */
  const empty = document.getElementById('empty');
  if (empty) {
    let last = empty.hidden;
    new MutationObserver(() => {
      if (empty.hidden === last) return;
      last = empty.hidden;
      if (empty.hidden) return;
      const chosen = document.querySelector<HTMLElement>('[data-filter][aria-pressed="true"]');
      send('no_results', { term: chosen?.dataset.filter || 'alle' }, empty);
    }).observe(empty, { attributes: true, attributeFilter: ['hidden'] });
  }

  /**
   * The signup form was seen. Without this, "0 signups" cannot be told apart
   * from "nobody scrolled that far" — and with 77% of visitors leaving after
   * one page, that is the question. Once per block per page view, when half
   * of it has been on screen.
   *
   * `placement` names the form, not the page — page_type already says which
   * page: `card` at the foot of a listing, `footer` on every page, `page` on
   * the newsletter page itself, where the same block is the whole point.
   *
   * "Seen" is half the block, or half a screen's worth of it — the block with
   * its canton picker is taller than half a phone, so a bare 50% threshold
   * would never fire on the device 60% of visitors hold.
   */
  const blocks = document.querySelectorAll<HTMLElement>('[data-subscribe-block]');
  if (blocks.length && 'IntersectionObserver' in window) {
    const onNewsletterPage = /^\/(de|fr|it|en)\/newsletter\/$/.test(location.pathname);
    const seen = new WeakSet<Element>();
    const enough = (entry: IntersectionObserverEntry) =>
      entry.intersectionRatio >= 0.5 || entry.intersectionRect.height >= window.innerHeight / 2;
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || seen.has(entry.target) || !enough(entry)) continue;
        seen.add(entry.target);
        io.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const placement = el.classList.contains('subscribe--footer')
          ? 'footer'
          : onNewsletterPage ? 'page' : 'card';
        send('newsletter_form_view', { placement }, el);
      }
    }, { threshold: [0, 0.25, 0.5, 0.75, 1] });
    blocks.forEach((b) => io.observe(b));
  }

  /**
   * The organiser funnel: `view` the claim page, `start` typing, `submit` a
   * claim the endpoint accepted. `report_open` with kind `organiser` is the
   * click that brings someone here from a market page; together the four rows
   * say where organisers drop out — the one relationship this site has.
   */
  if (/^\/(de|fr|it|en)\/(veranstalter|organisateurs|organizzatori|organisers)\/$/.test(location.pathname)) {
    const form = document.querySelector<HTMLFormElement>('form[data-mail]');
    send('organiser_contact', { step: 'view' }, form);
    if (form) {
      let started = false;
      const start = () => {
        if (started) return;
        started = true;
        send('organiser_contact', { step: 'start' }, form);
      };
      form.addEventListener('focusin', start, { once: true });
      form.addEventListener('input', start, { once: true });
      form.addEventListener('fynda:form', (event) => {
        const detail = (event as CustomEvent<{ outcome?: string }>).detail;
        if (detail?.outcome === 'ok') send('organiser_contact', { step: 'submit' }, form);
      });
    }
  }

  /* ------------------------------------------------------------------------
   * Since 2026-09-17: what the page was like to be on.
   * ---------------------------------------------------------------------- */

  /** The market this page is about, when it is one — for the beacons below. */
  const pageMarket = document.querySelector<HTMLElement>('.market[data-market]');

  /**
   * How long the page was actually in front of someone. The clock runs only
   * while the tab is visible, so a page left open behind another window
   * counts nothing. Sent once, when the page is hidden or closed — the only
   * moment a browser reliably lets a beacon out.
   */
  let activeMs = 0;
  let visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') { visibleSince = performance.now(); return; }
    if (visibleSince !== null) { activeMs += performance.now() - visibleSince; visibleSince = null; }
  });

  /** The deepest point scrolled to, as a share of the page. */
  let maxScroll = 0;
  const measureScroll = () => {
    const doc = document.documentElement;
    const total = doc.scrollHeight - window.innerHeight;
    const pct = total <= 0 ? 100 : Math.min(100, Math.round(((window.scrollY + window.innerHeight) / doc.scrollHeight) * 100));
    if (pct > maxScroll) maxScroll = pct;
  };
  measureScroll();
  window.addEventListener('scroll', measureScroll, { passive: true });

  /**
   * Which blocks of the page were on screen, in the order they appeared. A
   * block is a <section id>; the market page names its blocks (about,
   * expect, when, hinkommen, dates, report). 30% of a block visible counts.
   */
  const sectionsSeen: string[] = [];
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  if (sections.length && 'IntersectionObserver' in window) {
    const so = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const id = (entry.target as HTMLElement).id;
        if (entry.isIntersecting && !sectionsSeen.includes(id)) { sectionsSeen.push(id); so.unobserve(entry.target); }
      }
    }, { threshold: 0.3 });
    sections.forEach((el) => so.observe(el));
  }

  /**
   * Core Web Vitals as this visitor experienced them. Cloudflare's own RUM
   * excludes Swiss and EU visitors, so we measure ourselves. The library
   * reports each metric once it is final; INP and CLS finalise when the page
   * is hidden, which is why the row goes out with page_leave.
   */
  const vitals: Record<string, number> = {};
  const keep = (name: string) => ({ value }: { value: number }) => { vitals[name] = Math.round(name === 'cls' ? value * 1000 : value) / (name === 'cls' ? 1000 : 1); };
  onLCP(keep('lcp')); onINP(keep('inp')); onCLS(keep('cls')); onTTFB(keep('ttfb')); onFCP(keep('fcp'));

  let left = false;
  const leave = () => {
    if (left) return;
    left = true;
    if (visibleSince !== null) { activeMs += performance.now() - visibleSince; visibleSince = null; }
    measureScroll();
    send('page_leave', { active_ms: Math.round(activeMs), max_scroll_pct: maxScroll, sections: sectionsSeen }, pageMarket);
    if (Object.keys(vitals).length) send('web_vitals', vitals, pageMarket);
  };
  // pagehide is the reliable one on phones; visibilitychange→hidden covers a
  // tab switch that never comes back. Both call leave(); it sends once.
  window.addEventListener('pagehide', leave);
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') leave(); });

  /** A script broke on someone's device. Three per page at most. */
  let errors = 0;
  const reportError = (message: string, source?: string, line?: number) => {
    if (errors++ >= 3) return;
    const props: Record<string, unknown> = { message: String(message).slice(0, 300) };
    if (source) props.source = String(source).replace(location.origin, '').slice(0, 200);
    if (typeof line === 'number') props.line = line;
    send('js_error', props);
  };
  window.addEventListener('error', (e) => reportError(e.message, e.filename, e.lineno));
  window.addEventListener('unhandledrejection', (e) => reportError(`unhandled: ${String((e as PromiseRejectionEvent).reason).slice(0, 200)}`));

  /** A short name for an element: tag, id, first class. Never its text. */
  const selectorOf = (el: Element): string => {
    const tag = el.tagName.toLowerCase();
    const id = el.id ? `#${el.id}` : '';
    const cls = el.classList[0] ? `.${el.classList[0]}` : '';
    return `${tag}${id}${cls}`.slice(0, 200);
  };
  const INTERACTIVE = 'a[href], button, input, select, textarea, label, summary, [role="button"], [tabindex], details';

  /**
   * Frustration, measured. A rage click is three clicks within a second on
   * the same spot. A dead click is a click on something that looks clickable
   * (the cursor is a hand) but is not a link, a button or a control — the
   * classic "I tapped the card and nothing happened".
   */
  let clicks: { t: number; x: number; y: number }[] = [];
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target) return;
    const now = performance.now();
    clicks = clicks.filter((c) => now - c.t < 1000);
    clicks.push({ t: now, x: event.clientX, y: event.clientY });
    if (clicks.length >= 3 && clicks.every((c) => Math.abs(c.x - event.clientX) < 30 && Math.abs(c.y - event.clientY) < 30)) {
      send('rage_click', { selector: selectorOf(target) }, target);
      clicks = [];
      return;
    }
    if (!target.closest(INTERACTIVE) && getComputedStyle(target).cursor === 'pointer') {
      send('dead_click', { selector: selectorOf(target) }, target);
    }
  }, { capture: true, passive: true });

  /** First touch of the signup form: seen → started → submitted becomes a funnel. */
  const started = new WeakSet<Element>();
  document.addEventListener('focusin', (event) => {
    const form = (event.target as Element | null)?.closest?.('form[data-subscribe]');
    if (!form || started.has(form)) return;
    started.add(form);
    const block = form.closest<HTMLElement>('[data-subscribe-block]');
    const placement = block?.classList.contains('subscribe--footer')
      ? 'footer'
      : /^\/(de|fr|it|en)\/newsletter\/$/.test(location.pathname) ? 'page' : 'card';
    send('newsletter_form_start', { placement }, form);
  });

  /** The language links in the header. `to` is the language chosen. */
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest?.('nav.langs a[hreflang]');
    if (!link) return;
    const to = (link.getAttribute('hreflang') ?? '').slice(0, 2).toLowerCase();
    if (['de', 'fr', 'it', 'en'].includes(to)) send('language_switch', { to }, link);
  }, { capture: true, passive: true });
</script>
