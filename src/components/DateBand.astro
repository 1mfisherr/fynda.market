---
import { parseDate } from '../lib/format';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { t } from '../lib/strings';

interface Props { date: string; count: number; locale?: Locale }
const { date, count, locale = DEFAULT_LOCALE } = Astro.props;
const s = t(locale);
const day = parseDate(date);
const weekday = s.weekdaysLong[day.getDay()];
const month = s.monthsLong[day.getMonth()];
---
<header class="band"><strong class="day">{String(day.getDate()).padStart(2, '0')}</strong><span class="when">{weekday}<em>{month}</em></span><span class="count">{s.marketCount(count).toUpperCase()}</span></header>
<style>
  .band { display:grid; grid-template-columns:auto 1fr auto; gap:var(--space-3); align-items:end; padding:var(--space-page) var(--space-page) var(--space-2); border-top:var(--border-width) solid var(--color-line); }
  .day { font-size:var(--text-day-band); font-weight:var(--weight-black); letter-spacing:-0.05em; line-height:0.86; }
  .when { font-size:var(--text-micro); font-weight:var(--weight-black); letter-spacing:0.1em; line-height:1.5; text-transform:uppercase; }
  .when em { display:block; color:var(--color-quiet); font-style:normal; font-weight:var(--weight-bold); }
  .count { padding-bottom:var(--space-half); color:var(--color-quiet); font-size:var(--text-micro); font-weight:var(--weight-bold); white-space:nowrap; }
</style>
