---
/**
 * The newsletter and organiser blocks were the same card written twice, on two
 * pages, with the button styled separately in each. One card, four props.
 *
 * It sets no outer margin. It used to carry its own `margin-inline`, which is
 * the thing base.css warns about: the home page wanted the two cards side by
 * side above 900px and could not put them in a grid without first cancelling a
 * margin the component had decided on. The parent supplies `.gutter` now, the
 * same way every other block on a page does.
 */
import Button from './Button.astro';
import { DEFAULT_LOCALE, utilityPath, type Locale } from '../lib/i18n';
import { t } from '../lib/strings';

interface Props {
  /**
   * `claim` is the organiser card addressed to one market rather than to the
   * country. It is the same ask and the same destination; only the words and
   * the pre-filled form differ, so it belongs here rather than in a fourth
   * component that would drift.
   */
  kind: 'newsletter' | 'organiser' | 'claim';
  locale?: Locale;
  /** Overrides the standard body — the city page names the city in it. */
  body?: string;
  /** Overrides the destination — the claim card carries its market in the query. */
  href?: string;
  /**
   * How loud the button is. Where two cards sit together only one of them can
   * be the filled one, or neither reads as the thing to do.
   */
  variant?: 'primary' | 'secondary';
  /** One short line under the button — the claim card's "Free. Always." */
  note?: string;
}
const { kind, locale = DEFAULT_LOCALE, body, href, variant = 'primary', note } = Astro.props;
const s = t(locale);
const COPY = {
  newsletter: { title: s.newsletterTitle, body: s.newsletterBody, action: s.newsletterAction, key: 'newsletter' },
  organiser: { title: s.organiserTitle, body: s.organiserBody, action: s.organiserAction, key: 'organiser' },
  claim: { title: s.claimTitle, body: s.claimBody, action: s.claimAction, key: 'organiser' },
} as const;
const copy = COPY[kind];
---
<section class="cta">
  <h2>{copy.title}</h2>
  <p class="meta">{body ?? copy.body}</p>
  <Button href={href ?? utilityPath(locale, copy.key)} variant={variant} block>{copy.action}</Button>
  {note && <p class="meta note">{note}</p>}
</section>

<style>
  .cta {
    display: grid;
    /* Title and text take what they need; the third row takes the rest.
       Without this the card's three rows shared the height equally whenever a
       taller card sat beside it — on the home page the organiser card grew to
       match the signup form and turned a 44px button into a 124px lozenge,
       with the same slack opening up under the heading. */
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }

  /* Sitting on the floor of the card rather than floating in the slack. Where
     the card is alone the row collapses to the button and this does nothing. */
  .cta > :last-child { align-self: end; }
  .note { text-align: center; margin: 0; }
</style>
