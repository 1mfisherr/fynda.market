---
/**
 * The newsletter and organiser blocks were the same card written twice, on two
 * pages, with the button styled separately in each. One card, four props.
 */
import Button from './Button.astro';
import { DEFAULT_LOCALE, utilityPath, type Locale } from '../lib/i18n';
import { t } from '../lib/strings';

interface Props {
  kind: 'newsletter' | 'organiser';
  locale?: Locale;
  /** Overrides the standard body — the city page names the city in it. */
  body?: string;
}
const { kind, locale = DEFAULT_LOCALE, body } = Astro.props;
const s = t(locale);
const copy = kind === 'newsletter'
  ? { title: s.newsletterTitle, body: s.newsletterBody, action: s.newsletterAction, href: utilityPath(locale, 'newsletter') }
  : { title: s.organiserTitle, body: s.organiserBody, action: s.organiserAction, href: utilityPath(locale, 'organiser') };
---
<section class="cta">
  <h2>{copy.title}</h2>
  <p class="meta">{body ?? copy.body}</p>
  <Button href={copy.href} variant="primary" block>{copy.action}</Button>
</section>

<style>
  .cta {
    display: grid;
    gap: var(--space-3);
    margin-inline: var(--space-page);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }
</style>
