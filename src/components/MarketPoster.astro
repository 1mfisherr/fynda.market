---
/**
 * The poster card — used in horizontally scrolling rails.
 *
 * The accent appears on exactly one thing: the date line. That is the whole
 * brand rule (docs/BRAND.md), and it means the most important fact on the card
 * is also the only coloured thing on it.
 */
import type { Market } from '../lib/types';
import { formatWhen } from '../lib/format';
import PlaceholderArt from './PlaceholderArt.astro';
import Icon from './Icon.astro';

interface Props {
  market: Market;
  /** Eager-load the first card's art; it is usually the LCP element. */
  priority?: boolean;
}

const { market } = Astro.props;
const o = market.next;
const cancelled = o?.status === 'cancelled';
const confirmed = o?.status === 'confirmed';
---

<article class:list={['poster', { cancelled }]}>
  <a class="media" href={`/de/markt/${market.slug}/`} tabindex="-1" aria-hidden="true">
    {market.imageUrl ? (
      <img src={market.imageUrl} alt="" width="224" height="176" loading="lazy" decoding="async" />
    ) : (
      <PlaceholderArt kind={market.kind} seed={market.slug} />
    )}

    <span class:list={['badge', confirmed ? 'is-confirmed' : 'is-quiet']}>
      {confirmed && <Icon name="check" size={13} strokeWidth={3} />}
      {confirmed ? 'Bestätigt' : cancelled ? 'Abgesagt' : 'Nicht bestätigt'}
    </span>
  </a>

  <h3 class="name">
    <a href={`/de/markt/${market.slug}/`}>{market.name}</a>
  </h3>

  {o && (
    <p class="when" data-date={o.date}>
      {cancelled
        ? `Abgesagt${o.cancellationNote ? ` · ${o.cancellationNote}` : ''}`
        : formatWhen(o.date, o.startTime, o.endTime)}
    </p>
  )}

  <p class="where">{market.city}</p>
</article>

<style>
  .poster {
    width: 224px;
    flex-shrink: 0;
  }

  .media {
    position: relative;
    display: block;
    height: 176px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-paper);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 30px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: 0 1px 4px rgb(17 17 16 / 14%);
    font-size: var(--text-micro);
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--color-ink);
  }

  .badge.is-quiet {
    color: var(--color-quiet);
  }

  .name {
    margin: var(--space-3) 0 0;
    font-size: var(--text-title);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-snug);
  }

  /* The whole card is clickable, but only the title is in the tab order. */
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .poster {
    position: relative;
  }

  .when {
    margin: var(--space-1) 0 0;
    font-size: var(--text-date);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }

  .where {
    margin: 2px 0 0;
    font-size: var(--text-date);
    color: var(--color-grey);
  }

  /* Cancelled: greyed, struck through, and it says the word. Never colour
     alone — docs/BRAND.md. */
  .cancelled .name {
    color: var(--color-quiet);
    text-decoration: line-through;
    text-decoration-color: var(--color-line);
  }

  .cancelled .when,
  .cancelled .where {
    color: var(--color-status-cancelled);
  }

  .cancelled .media {
    opacity: 0.55;
  }
</style>
