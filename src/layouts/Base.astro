---
import '../styles/tokens.css';
import '../styles/base.css';

import { DEFAULT_LOCALE, localeTag, type CountryCode, type Locale } from '../lib/i18n';
import { fitDescription } from '../lib/titles';

interface Props {
  title: string;
  description: string;
  /** Set false on pages that must not be indexed (filter views, etc). */
  indexable?: boolean;
  locale?: Locale;
  /**
   * The same page in the other languages. Every member must list every other
   * member including itself, or Google discards the whole cluster — the single
   * most common way hreflang is got wrong.
   */
  alternates?: { locale: Locale; path: string }[];
  /**
   * Which country this page is about, where it is about one. `/de/` serves
   * Zürich and München, so the tag a page carries — de-CH or de-DE — is the
   * only thing that tells Google which German reader it is for. Every member
   * of a cluster is the same place, so one country covers the whole set.
   */
  country?: CountryCode;
  /**
   * What the page is about, for the edge counter (functions/_middleware.ts
   * reads these tags off the response): the market's id, the town's and the
   * canton's slugs, the next date. A page view then carries them without the
   * edge knowing the database.
   */
  analytics?: { market?: string; city?: string; region?: string; next?: string };
}

const { title, description: raw, indexable = true, locale = DEFAULT_LOCALE, alternates = [], country, analytics = {} } = Astro.props;
/* One rule for every page's snippet, rather than a length check per template:
   395 town descriptions ran past what Google shows (SEO audit, 2026-09-23). */
const description = fitDescription(raw);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const href = (path: string) => new URL(path, Astro.site).href;
/* x-default is the page for a visitor whose browser matches none of our
   languages — a Spaniard, a Pole. Where one language has to stand for all it
   is English (CLAUDE.md), so English where the page has it, else the site's
   default. Delfim, 2026-09-18; it was German before. */
const fallback = alternates.find((a) => a.locale === 'en') ?? alternates.find((a) => a.locale === DEFAULT_LOCALE);
import Analytics from '../components/Analytics.astro';
---

<!doctype html>
<html lang={localeTag(locale, country)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {analytics.market && <meta name="fynda:market" content={analytics.market} />}
    {analytics.city && <meta name="fynda:city" content={analytics.city} />}
    {analytics.region && <meta name="fynda:region" content={analytics.region} />}
    {analytics.next && <meta name="fynda:next" content={analytics.next} />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, follow" />}

    {/* Self-referencing included, per the return-link rule. */}
    {indexable && alternates.map((alt) => (
      <link rel="alternate" hreflang={localeTag(alt.locale, country)} href={href(alt.path)} />
    ))}
    {indexable && fallback && <link rel="alternate" hreflang="x-default" href={href(fallback.path)} />}

    {/* Self-hosted since 2026-09-16 — src/styles/base.css says why. Preloaded so
        the first paint does not wait for the stylesheet to discover it. */}
    <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* The y. mark. Browsers that read SVG take it; the .ico is for the rest and
        for the address-bar drop-downs that only fetch /favicon.ico. iOS and
        Android want opaque PNGs, so those carry the site's white. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeTag(locale, country).replace('-', '_')} />
    <meta property="og:image" content={href('/og-image.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Structured data and anything else page-specific. Guardrail check 6
         polices what may appear here. -->
    <slot name="head" />
  </head>
  <body>
    <slot />
    {/* Interaction events only. Page views are counted at the edge, in
        functions/_middleware.ts, so a blocker cannot remove them. */}
    <Analytics />
  </body>
</html>
