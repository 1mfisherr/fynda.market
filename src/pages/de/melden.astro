---
/**
 * Report page — `/de/melden/`.
 *
 * The site's trust engine, not a formality. All three buttons on a market
 * page ("Fand nicht statt", "War schon vorbei", "Etwas anderes") land here,
 * and what happens on this page is what makes "Bestätigt am 12.08." on a
 * market page honest rather than decorative — every report gets checked by
 * hand before that date changes.
 *
 * No backend yet, same honest pattern as newsletter.astro and
 * veranstalter.astro: the form opens a `mailto:` with the values filled in
 * and says so, rather than pretending to submit somewhere.
 */
import Page from '../../layouts/Page.astro';
import Field from '../../components/Field.astro';
import Button from '../../components/Button.astro';
---
<Page
  back
  title="Etwas melden — Fynda"
  description="Markt nicht gefunden, schon vorbei oder falsche Angaben? Meldung senden, wir prüfen von Hand."
  indexable={false}
>
  <section class="gutter">
    <h1>Etwas stimmt nicht?</h1>
    <p class="answer">Sagen Sie uns, was Sie vor Ort erlebt haben — wir prüfen jede Meldung von Hand.</p>
  </section>

  <div class="prose gutter">
    <p>
      Melden Sie eine Absage oder eine falsche Angabe, ändert sich nichts automatisch. Wir prüfen
      jede Meldung, bevor wir etwas an der Marktseite ändern, und zeigen dort dann, wann wir das
      zuletzt geprüft haben — das Datum ist der Beweis, nicht nur ein Versprechen.
    </p>
  </div>

  <form class="stack gutter" id="melden-form">
    <Field
      label="Was ist passiert?"
      name="grund"
      type="select"
      required
      options={[
        'Der Markt fand nicht statt',
        'Der Markt war früher vorbei',
        'Adresse oder Zeit stimmt nicht',
        'Etwas anderes',
      ]}
    />
    <Field label="Welcher Markt?" name="markt" required placeholder="z. B. Flohmarkt Zürich Bürkliplatz" />
    <Field label="E-Mail (optional)" name="email" type="email" hint="Falls wir zurückschreiben dürfen." />
    <Field label="Nachricht" name="nachricht" type="textarea" placeholder="Was genau haben Sie festgestellt?" />
    <Button type="submit" variant="primary" block>Meldung senden</Button>
    <p class="meta">
      Absenden öffnet Ihr E-Mail-Programm mit einer vorausgefüllten Nachricht an hallo@fynda.market —
      es gibt noch kein automatisches Versandsystem. Sie sehen die Nachricht, bevor sie abgeschickt wird.
    </p>
  </form>
</Page>

<script>
  const form = document.getElementById('melden-form') as HTMLFormElement | null;

  /**
   * The market page sends the market with the visitor: /de/melden/?markt=…&grund=…
   * Someone who has just found a closed gate should not have to retype the name
   * of the page they came from — that is where a report form loses its reports.
   */
  const params = new URLSearchParams(window.location.search);
  const markt = params.get('markt');
  const grund = params.get('grund');

  if (markt) {
    const field = form?.elements.namedItem('markt') as HTMLInputElement | null;
    if (field) field.value = markt;
  }
  if (grund) {
    const select = form?.elements.namedItem('grund') as HTMLSelectElement | null;
    const wanted: Record<string, number> = { ausgefallen: 0, vorbei: 1, anderes: 3 };
    if (select && grund in wanted) select.selectedIndex = wanted[grund];
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) ?? '').trim();

    const grund = value('grund');
    const markt = value('markt');
    const email = value('email');
    const nachricht = value('nachricht');

    const lines = [`Grund: ${grund}`, `Markt: ${markt}`];
    if (email) lines.push(`Antwort an: ${email}`);
    lines.push('', nachricht);

    const subject = `Meldung: ${markt || 'Markt unbekannt'}`;
    const url = `mailto:hallo@fynda.market?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    window.location.href = url;
  });
</script>
