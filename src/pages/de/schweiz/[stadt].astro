---
import Base from '../../../layouts/Base.astro';
import DateBand from '../../../components/DateBand.astro';
import MarketRow from '../../../components/MarketRow.astro';
import TypeLegend from '../../../components/TypeLegend.astro';
import { getMarkets, withinHorizon } from '../../../lib/markets';
import type { Market, Occurrence } from '../../../lib/types';

export async function getStaticPaths() {
  const slugify = (value: string) => value.toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const markets = await getMarkets();
  const cities = [...new Set(markets.map((market) => market.city))];
  return cities.map((city) => ({ params: { stadt: slugify(city) }, props: { city, markets: markets.filter((market) => market.city === city) } }));
}
const slugify = (value: string) => value.toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const { city, markets } = Astro.props;
const rows = markets.flatMap((market) => withinHorizon([market.next, ...market.upcoming].filter(Boolean) as Occurrence[]).map((next) => ({ ...market, next })));
const groups = Object.values(rows.reduce<Record<string, Market[]>>((all, row) => { (all[row.next!.date] ??= []).push(row); return all; }, {})).sort((a, b) => a[0].next!.date.localeCompare(b[0].next!.date));
const year = new Date().getFullYear();
const site = 'https://fynda.market';
const jsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Schweiz', item: `${site}/de/schweiz/` }, { '@type': 'ListItem', position: 2, name: city, item: `${site}/de/schweiz/${slugify(city)}/` }] };
---
<Base title={`Flohmärkte in ${city} ${year} | Fynda`} description={`Flohmärkte in ${city}: Termine, Öffnungszeiten und Absagen.`}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <header><a class="mark" href="/de/">fynda<span>.</span></a><a href="/de/gemerkt/">Gemerkt</a></header>
  <main><section class="head"><h1>Flohmärkte in {city} {year}</h1><p>{markets.length} Märkte · {rows.length} Termine bis Dezember · zuletzt geprüft heute</p><p>Termine, Öffnungszeiten und Absagen.</p></section>
  <div class="filters" role="group" aria-label="Filter"><button class="active" type="button" data-filter="all">Alle</button><button type="button" data-filter="today">Heute</button><button type="button" data-filter="weekend">Wochenende</button><button type="button" data-filter="private">Nur Private</button></div>
  <div id="list">{groups.map((group) => <section class="day" data-day><DateBand date={group[0].next!.date} count={group.length} />{group.map((market) => <MarketRow market={market} />)}</section>)}</div>
  <p class="empty" id="empty" hidden>Für diesen Zeitraum ist nichts eingetragen.</p>
  <TypeLegend />
  <section class="newsletter"><h2>Nichts verpassen</h2><p>Neue Termine und Absagen für {city}.</p><a href="/de/newsletter/">Newsletter abonnieren</a></section></main>
</Base>
<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]')); const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-date]')); const empty = document.getElementById('empty');
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  const apply = (filter: string) => { const today = iso(new Date()); const day = new Date().getDay(); const saturday = new Date(); saturday.setDate(saturday.getDate() + (day === 0 ? -1 : (6-day+7)%7)); const sunday = new Date(saturday); sunday.setDate(saturday.getDate()+1); let count=0; rows.forEach((row) => { const date=row.dataset.date ?? ''; const privateSeller=row.textContent?.includes('nur Private'); const show=filter==='all' || filter==='today' && date===today || filter==='weekend' && date>=iso(saturday) && date<=iso(sunday) || filter==='private' && privateSeller; row.hidden=!show; if(show) count++; }); document.querySelectorAll<HTMLElement>('[data-day]').forEach((section) => section.hidden=!Array.from(section.querySelectorAll<HTMLElement>('[data-date]')).some((row) => !row.hidden)); if(empty) empty.hidden=count>0; };
  buttons.forEach((button) => button.addEventListener('click', () => { buttons.forEach((other) => other.classList.toggle('active', other===button)); apply(button.dataset.filter ?? 'all'); })); apply('all');
</script>
<style>
  header,main{max-width:var(--content-max);margin-inline:auto}header{display:flex;justify-content:space-between;align-items:center;padding:var(--space-3) var(--space-page);font-size:var(--text-small);font-weight:var(--weight-bold)}.mark{font-size:var(--text-title);font-weight:var(--weight-black);letter-spacing:var(--tracking-display)}.mark span{color:var(--color-accent)}.head{padding:var(--space-page)}h1{margin:0;font-size:var(--text-display);font-weight:var(--weight-black);letter-spacing:var(--tracking-display);line-height:var(--leading-tight)}.head p{margin:var(--space-2) 0 0;color:var(--color-grey);font-size:var(--text-small)}.filters{display:flex;gap:var(--space-2);overflow-x:auto;padding:0 var(--space-page) var(--space-page)}button{min-height:var(--tap-min);padding:0 var(--space-3);border:var(--border-width) solid var(--color-line);border-radius:var(--radius-pill);background:var(--color-surface);color:var(--color-ink);font:inherit;font-size:var(--text-small);font-weight:var(--weight-bold);white-space:nowrap}button.active{background:var(--color-ink);color:var(--color-surface);border-color:var(--color-ink)}.empty{padding:var(--space-page);color:var(--color-grey)}.newsletter{margin:var(--space-page);padding:var(--space-5);background:var(--color-paper);border-radius:var(--radius-md)}.newsletter h2{margin:0;font-size:var(--text-section);letter-spacing:var(--tracking-section)}.newsletter p{color:var(--color-grey);font-size:var(--text-small)}.newsletter a{display:inline-flex;min-height:var(--tap-min);align-items:center;font-size:var(--text-small);font-weight:var(--weight-bold)}
</style>
