---
/**
 * City page — `/de/schweiz/[stadt]/`.
 *
 * The best-earning page type on v1 and the one the home page's city list points
 * at. Unlike home it shows every date for the city: someone here has already
 * chosen the place, so the list is the answer rather than a sample of it.
 */
import Page from '../../../layouts/Page.astro';
import CtaCard from '../../../components/CtaCard.astro';
import DateBand from '../../../components/DateBand.astro';
import DateFilters from '../../../components/DateFilters.astro';
import MarketRow from '../../../components/MarketRow.astro';
import Section from '../../../components/Section.astro';
import TypeLegend from '../../../components/TypeLegend.astro';
import { getMarkets, withinHorizon } from '../../../lib/markets';
import { formatDate, formatTimeRange } from '../../../lib/format';
import { dateCount } from '../../../lib/vocabulary';
import type { Market, Occurrence } from '../../../lib/types';

export async function getStaticPaths() {
  const markets = await getMarkets();
  const cities = new Map(markets.map((market) => [market.citySlug, market.city]));
  return [...cities].map(([stadt, city]) => ({
    params: { stadt },
    props: {
      city,
      stadt,
      region: markets.find((market) => market.citySlug === stadt)!.region,
      markets: markets.filter((market) => market.citySlug === stadt),
    },
  }));
}

const { city, stadt, region, markets } = Astro.props;
const rows = markets.flatMap((market) =>
  withinHorizon([market.next, ...market.upcoming].filter(Boolean) as Occurrence[])
    .map((next) => ({ ...market, next }))
);
const groups = Object.values(
  rows.reduce<Record<string, Market[]>>((all, row) => { (all[row.next!.date] ??= []).push(row); return all; }, {})
).sort((a, b) => a[0].next!.date.localeCompare(b[0].next!.date));

const year = new Date().getFullYear();

/**
 * The answer sentence, before the list. Tripadvisor opens a city page with the
 * count in the title and one line that answers the query; it is also where AI
 * answers are extracted from — 44% of citations come from the first 30% of a
 * page. So: which market is next, when, and where.
 */
/**
 * The count leads, but "Flohmarkt" is the query and must survive: nobody
 * searches "7 Märkte in Luzern". Ranked-list shapes are what AI answers cite,
 * and this is that shape without losing the head term.
 */
const heading = markets.length === 1
  ? `Der Flohmarkt in ${city} ${year}`
  : `Die ${markets.length} Flohmärkte in ${city} ${year}`;

const soonest = rows.find((row) => row.next!.status !== 'cancelled');
const answer = soonest
  ? `Der nächste ist ${soonest.name} am ${formatDate(soonest.next!.date)}${
      formatTimeRange(soonest.next!.startTime, soonest.next!.endTime)
        ? `, ${formatTimeRange(soonest.next!.startTime, soonest.next!.endTime)} Uhr`
        : ''
    }, ${soonest.venueName}.`
  : 'Zurzeit ist kein Termin bestätigt.';
const site = 'https://fynda.market';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Schweiz', item: `${site}/de/schweiz/` },
    { '@type': 'ListItem', position: 2, name: city, item: `${site}/de/schweiz/${stadt}/` },
  ],
};
---
<Page back title={`${heading} | Fynda`} description={`Flohmärkte in ${city}: Termine, Öffnungszeiten und Absagen.`}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="page-head gutter">
    <h1>{heading}</h1>
    <p class="answer">{answer}</p>
    <p class="meta">{dateCount(rows.length)} in den nächsten vier Monaten · zuletzt geprüft heute</p>
    <p class="meta">Alle bekannten Flohmärkte in {city}, Kanton {region} — mit Terminen, Öffnungszeiten und Absagen. Abgesagte Termine bleiben sichtbar.</p>
  </section>

  <DateFilters windows={['all', 'today', 'weekend']} label="Filter" />

  <Section bleed>
    <div id="list">
      {groups.map((group) => (
        <section class="day" data-day>
          <DateBand date={group[0].next!.date} count={group.length} />
          {group.map((market) => <MarketRow market={market} />)}
        </section>
      ))}
    </div>
    <p id="empty" class="gutter meta" hidden>Für diesen Zeitraum ist nichts eingetragen.</p>
  </Section>

  <TypeLegend />

  <CtaCard
    title="Nichts verpassen"
    body={`Neue Termine und Absagen für ${city}.`}
    href="/de/newsletter/"
    action="Newsletter abonnieren"
  />
</Page>

<script>
  import { inWindow, type DateWindow } from '../../../lib/date-window';

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-date]'));
  const days = Array.from(document.querySelectorAll<HTMLElement>('[data-day]'));
  const empty = document.getElementById('empty');

  const apply = (window: DateWindow) => {
    const now = new Date();
    let shown = 0;
    for (const row of rows) {
      const visible = inWindow(row.dataset.date ?? '', window, now);
      row.hidden = !visible;
      if (visible) shown++;
    }
    for (const day of days) {
      day.hidden = !Array.from(day.querySelectorAll<HTMLElement>('[data-date]')).some((row) => !row.hidden);
    }
    if (empty) empty.hidden = shown > 0;
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      apply((button.dataset.filter ?? 'all') as DateWindow);
    });
  }
  apply('all');
</script>
