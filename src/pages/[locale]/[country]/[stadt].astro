---
/**
 * City page — `/de/schweiz/[stadt]/`.
 *
 * The best-earning page type on v1 and the one the home page's city list points
 * at. Unlike home it shows every date for the city: someone here has already
 * chosen the place, so the list is the answer rather than a sample of it.
 */
import Page from '../../../layouts/Page.astro';
import SubscribeForm from '../../../components/SubscribeForm.astro';
import DateFilters from '../../../components/DateFilters.astro';
import MarketRow from '../../../components/MarketRow.astro';
import PillList from '../../../components/PillList.astro';
import Section from '../../../components/Section.astro';
import TypeLegend from '../../../components/TypeLegend.astro';
import Button from '../../../components/Button.astro';
import Icon from '../../../components/Icon.astro';
import { getMarkets, HORIZON_DAYS } from '../../../lib/markets';
import { datedRows, groupByDay, lastChecked, nearbyMarkets, townRows, undatedMarkets, weekendAround } from '../../../lib/lists';
import { formatDate, formatDateShort, formatTimeRange, parseDate, todayIso } from '../../../lib/format';
import { BADGED_KINDS } from '../../../lib/vocabulary';
import { kmLabel } from '../../../lib/geo';
import { LOCALES, cityPath, homePath, isCityState, localeTag, marketPath, regionPath, type Locale } from '../../../lib/i18n';
import { seasonLabel } from '../../../lib/season';
import { t } from '../../../lib/strings';
import { fitTitle } from '../../../lib/titles';
import { hasTownPage, townIndex, townsAround } from '../../../lib/towns';
import { townFacts } from '../../../lib/town-facts';
import type { Market } from '../../../lib/types';

/**
 * One city page per city per locale. A city carries the same slug in all four —
 * Zürich is `zurich` in every language — so the alternate paths differ only in
 * the locale and the country segment, and are read straight off the slug.
 */
export async function getStaticPaths() {
  const byLocale = new Map<Locale, Market[]>();
  for (const locale of LOCALES) byLocale.set(locale, await getMarkets(locale));

  // citySlug -> the country segment it sits under, per locale. The country is
  // the one part of the path still translated (schweiz / suisse / svizzera),
  // and it is looked up rather than assumed because a second country is coming.
  const countryOf = new Map<Locale, Map<string, string>>();
  for (const locale of LOCALES) {
    countryOf.set(locale, new Map(byLocale.get(locale)!.map((m) => [m.citySlug, m.countrySlug])));
  }

  const paths = [];
  for (const locale of LOCALES) {
    const markets = byLocale.get(locale)!;
    const cities = new Map(markets.map((m) => [m.citySlug, m]));
    const index = townIndex(locale, markets);
    for (const [stadt, sample] of cities) {
      const here = markets.filter((m) => m.citySlug === stadt);
      /* A town of one market has no page: its market's page is the town's
         page, and this address 301s there (src/lib/towns.ts townHref,
         scripts/redirects.mjs). It comes back by itself at a second market. */
      if (!hasTownPage(here)) continue;
      const around = nearbyMarkets(here, markets);
      /* A thin town already lists what is around it; a busy one gets its empty weekend days filled. */
      const weekend = around.rows.length ? [] : weekendAround(here, markets);
      const towns = townsAround(stadt, index);
      const alternates = LOCALES.map((other) => {
        const country = countryOf.get(other)!.get(stadt);
        return country ? { locale: other, path: cityPath(other, country, stadt) } : null;
      }).filter(Boolean) as { locale: Locale; path: string }[];

      paths.push({
        params: { locale, country: sample.countrySlug, stadt },
        // `only` branches below (a one-market town) are kept for the day a town
        // page is built with one market again; today none is.
        props: { locale, city: sample.city, stadt, region: sample.region, regionSlug: sample.regionSlug, markets: here, nearby: around.rows, nearbyKm: around.km, weekend, towns, alternates },
      });
    }
  }
  return paths;
}

const { locale, city, stadt, region, regionSlug, markets, nearby, nearbyKm, weekend, towns, alternates } = Astro.props;
const s = t(locale);
/* Every date, for the counts and the answer sentence; then one row per market,
   which is what the page actually renders — src/lib/lists.ts. */
const rows = datedRows(markets);
const checked = lastChecked(rows);
/* The coming week day by day, then one row per market (src/lib/lists.ts townRows). */
const list = townRows(rows);
/* The rest of the town's markets: no date inside the horizon, listed under
   their own header with the rhythm line, hidden by any When but All. */
const undated = undatedMarkets(markets);

/* The year in a heading is the year of the next real date here, or none: "2026"
   over a page whose next date is in 2027, or that has none, does not match its
   title (582 titles did, SEO audit 2026-10-07). */
const year = (() => {
  const first = rows.filter((row) => row.next!.status !== 'cancelled').map((row) => row.next!.date).sort()[0];
  return first ? Number(first.slice(0, 4)) : undefined;
})();

/**
 * The answer sentence, before the list. Tripadvisor opens a city page with the
 * count in the title and one line that answers the query; it is also where AI
 * answers are extracted from — 44% of citations come from the first 30% of a
 * page. So: which market is next, when, and where.
 */
/**
 * The count leads, but "Flohmarkt" is the query and must survive: nobody
 * searches "7 Märkte in Luzern". Ranked-list shapes are what AI answers cite,
 * and this is that shape without losing the head term.
 */
/* The count is what the list holds, not what the city holds. `markets`
   includes markets with no upcoming date, so the old heading said 17 over
   fourteen rows — invisible while the list was 61 rows of repeats, and
   the first thing anyone would count now that it is one row each. */
/* …and the list now holds every market the town has — dated ones under their
   day, the rest under "No date yet" — so the count is simply all of them.
   (Before the undated were listed, "Die 0 Flohmärkte in Muttenz 2026" was a
   title in Google for a fortnight.) */
const heading = s.cityHeading(markets.length, city, year);

// The earliest upcoming date, not the first row of an unsorted list: `rows` is
// in market order, so `.find()` here answered with whichever market happened to
// be first in the database.
const soonest = [...rows]
  .filter((row) => row.next!.status !== 'cancelled')
  .sort((a, b) => a.next!.date.localeCompare(b.next!.date) || (a.next!.startTime ?? '').localeCompare(b.next!.startTime ?? ''))[0];
/* A town of one market with nothing dated answers with that market's season
   and its last edition — "Usually in September. Last held Sat 19 Sep." — the
   same words its own page leads with (src/lib/season.ts). */
const only = markets.length === 1 ? markets[0] : undefined;
const between = only && !soonest
  ? [seasonLabel(only, todayIso(), locale), only.lastDate && s.lastHeld(formatDate(only.lastDate, locale))].filter(Boolean).map((part) => `${part}.`).join(' ')
  : '';
const answer = soonest
  ? s.cityNext(
      soonest.name,
      formatDate(soonest.next!.date, locale),
      formatTimeRange(soonest.next!.startTime, soonest.next!.endTime, locale),
      soonest.venueName
    )
  : between || s.cityNoDate;
/* Nothing dated of its own: no date control to filter with, and the alert —
   "tell me when Rafz has a date" — in the weekly card's place. */
const ownDates = rows.some((row) => row.next.status !== 'cancelled');
/**
 * The search snippet. It said "Alle bekannten Flohmärkte in Worb — mit
 * Terminen, Öffnungszeiten und Absagen" on every city page, and Search
 * Console's first nine days showed what that earns: Worb, Wettingen and Chur
 * at position 5–8 with 100–200 impressions each and no clicks. The person
 * searching "flohmarkt worb" wants to know when, and the market page's snippet
 * already answers that. So the description is the answer sentence the page
 * opens with, plus the count — the generic line stays only for a city with
 * nothing upcoming, where it is the honest description.
 */
/* With nothing upcoming, the most recent market that ran — a fact the
   searcher can use ("so it was last month; it is annual"), where the snippet
   used to open on "Noch kein nächster Termin" on 33 town pages
   (Search Console, 2026-09-28). */
const latest = [...markets].filter((m) => m.lastDate).sort((a, b) => b.lastDate!.localeCompare(a.lastDate!))[0];
const description = soonest
  ? s.cityDescription(
      city,
      soonest.name,
      formatDate(soonest.next!.date, locale),
      formatTimeRange(soonest.next!.startTime, soonest.next!.endTime, locale),
      soonest.venueName,
      rows.length,
      Math.round(HORIZON_DAYS / 30)
    )
  : [latest && s.cityLast(latest.name, formatDate(latest.lastDate!, locale)), s.cityNoDate, s.cityIntro(city, region, markets[0].countryCode)].filter(Boolean).join(' ');
/**
 * The list, grouped under the day it happens. It was fifteen rows each carrying
 * its own "SA 19." — the same day four times over, and the month changing
 * twice with nothing to say so. People scan headings, not rows (NN/g's
 * eyetracking, and both product studies of 2026-09-15 said the same). So one
 * header per day, sticky while its rows scroll past, and a month label where
 * the month turns. The date in the header is where the accent lives now: once
 * per day rather than once per row, which is what makes it mean something.
 *
 * Only the very first market is the feature. Two features and a two-line chip
 * row put the first market name 1,300px down a phone; one puts three markets
 * on the first screen.
 */
const today = todayIso();
interface Group<T> { date: string; label: string; weekday: string; monthLabel?: string; rows: T[] }
/** The day groups from lists.ts, with this page's header words on each. */
function labelled<T>(items: T[], dateOf: (item: T) => string): Group<T>[] {
  return groupByDay(items, dateOf).map(({ date, rows }, i, all) => {
    const d = parseDate(date);
    const dot = locale === 'de' ? '.' : '';
    const monthTurned = i > 0 && all[i - 1].date.slice(0, 7) !== date.slice(0, 7);
    return {
      date,
      weekday: date === today ? s.filterToday : s.weekdaysLong[d.getDay()],
      label: `${d.getDate()}${dot} ${s.monthsLong[d.getMonth()]}`,
      monthLabel: monthTurned ? `${s.monthsLong[d.getMonth()]} ${d.getFullYear()}` : undefined,
      rows,
    };
  });
}
const groups = labelled(list, (market) => market.next.date);
/* This weekend's empty days, filled from within 25 km, in date order among the town's own days. */
const aroundGroups = labelled(weekend.flatMap((day) => day.rows), ({ market }) => market.next.date);
const days = [
  ...groups.map((group) => ({ ...group, around: false as const })),
  ...aroundGroups.map((group) => ({ ...group, around: true as const })),
].sort((a, b) => a.date.localeCompare(b.date));
const leadDay = groups[0]?.date;
const nearbyGroups = labelled(nearby, ({ market }) => market.next.date);

/* The legend explains the badge colours. With no badged market on the page it
   teaches a colour system nothing on the page uses — the market page dropped
   it for the same reason. */
/* A town of one market: that market, large, and the way there — the first
   thing someone on this page does next (Delfim, 2026-10-10). Not its
   description: that is the market page's, and two pages saying the same
   is what Google's September update punished. */
const routeHref = only ? `https://www.google.com/maps/dir/?api=1&destination=${only.lat},${only.lng}` : undefined;

const hasBadge = [...list, ...nearby.map((n) => n.market), ...weekend.flatMap((d) => d.rows.map((n) => n.market))].some((market) => BADGED_KINDS.has(market.kind));

/* The What row: what sets this town's markets apart, as buttons that keep only those (src/lib/town-facts.ts). */
const what = townFacts(markets, today).map(({ fact, ids }) => ({ key: fact, label: s.whatLabels[fact], ids }));

const site = 'https://fynda.market';
const cityState = isCityState(markets[0].countryCode, regionSlug);
/* The town's own markets, in the order the page lists them: what the page is
   a list of, for search engines and AI answers. URL and name only — an Event
   per market is the market page's (one per page, guardrail 6). */
const listed = [...new Map([...list, ...undated].map((market) => [market.slug, market])).values()];
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: heading,
  numberOfItems: listed.length,
  itemListElement: listed.map((market, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site}${marketPath(locale, market.slug)}`,
    name: market.name,
  })),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'fynda.market', item: `${site}${homePath(locale)}` },
    ...(cityState ? [] : [{ name: region, item: `${site}${regionPath(locale, markets[0].countryCode, markets[0].countrySlug, regionSlug)}` }]),
    { name: city, item: `${site}${cityPath(locale, markets[0].countrySlug, stadt)}` },
  ].map((step, i) => ({ '@type': 'ListItem', position: i + 1, ...step })),
};
---
<Page locale={locale} alternates={alternates} country={markets[0].countryCode} title={fitTitle(heading, soonest && s.titleNext(formatDateShort(soonest.next!.date, locale)))} description={description} analytics={{ city: stadt, region: regionSlug }} footerSignup={false}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemList)} slot="head" />

  <section class="page-head gutter">
    <h1>{heading}</h1>
    <p class="answer">{answer}</p>
    {rows.length > 0 && (
      <p class="meta">{s.dateCount(rows.length)} {s.inNextMonths(Math.round(HORIZON_DAYS / 30))}{checked && <> · <span data-stamp>{s.lastChecked(formatDateShort(checked, locale))}</span></>}</p>
    )}
  </section>

  {/* The nearby rows count too: on Worb, "Wochenende" showing Bern's Saturday
      market is the point of the block. */}
  {/* Every day a market runs, not only each market's next one — a weekly
      market is on the calendar every week (src/lib/date-rows.ts). */}
  {ownDates && <DateFilters locale={locale} dates={[...rows.filter((r) => r.next.status !== 'cancelled').map((r) => r.next.date), ...nearby.map((n) => n.market.next.date)]} what={what} />}

  {/* One row per market, not one per date. Zürich was 61 rows for 14 markets
      under a heading that said 17; the recurrence phrase on each row says what
      the other forty-seven were repeating. See src/lib/lists.ts. */}
  <Section>
    <div
      id="list"
      data-weekdays={JSON.stringify(s.weekdaysLong)}
      data-months={JSON.stringify(s.monthsLong)}
      data-today={s.filterToday}
      data-dot={locale === 'de' ? '.' : ''}
      data-count-one={s.marketCount(1)}
      data-count-many={s.marketCount(2)}
    >
      {days.map((group) => group.around ? (
        /* Nothing here this day, so what is on within 25 km — other towns'
           markets, outside this page's content floor like *Within 25 km*. */
        <aside class="day-group gutter around" data-outside-floor data-around-day={group.date}>
          <h2 class="day-head">
            <span class="weekday">{group.weekday}</span>
            <span class="date">{group.label}</span>
          </h2>
          <p class="meta around-note">{s.aroundNothing(city)}</p>
          {group.rows.map(({ market, km }) => (
            <MarketRow market={market} locale={locale} showRhythm showDay={false} distance={`${Math.round(km)} km`} showFacts />
          ))}
        </aside>
      ) : (
        <section class="day-group gutter" data-day={group.date}>
          {group.monthLabel && <p class="month">{group.monthLabel}</p>}
          <h2 class="day-head">
            <span class="weekday">{group.weekday}</span>
            <span class="date">{group.label}</span>
            <span class="count">{s.marketCount(group.rows.length)}</span>
          </h2>
          {group.rows.map((market, i) => (
            <MarketRow market={market} locale={locale} variant={group.date === leadDay && i === 0 ? 'feature' : 'row'} eager={group.date === leadDay && i === 0} showRhythm omitCity showDay={false} allDates showFacts />
          ))}
        </section>
      ))}
    </div>
    {/* A chosen day or weekend, built by the script from the rows above: the
        markets on those days under their own headers, with that day's hours. */}
    <div id="picked" hidden></div>
    <template id="day-template">
      <section class="day-group gutter">
        <h2 class="day-head"><span class="weekday"></span><span class="date"></span><span class="count"></span></h2>
      </section>
    </template>
    <p id="empty" class="gutter meta" hidden>{s.nothingInPeriod}</p>
    {only && ownDates && (
      <div class="gutter route"><Button href={routeHref} variant="primary" block rel="noopener nofollow" target="_blank"><Icon name="map" size={18} />{s.route}</Button></div>
    )}
  </Section>

  {/* Straight after the markets that have a date, while people are still in
      the list. At the foot of the page it sat behind every undated market and
      almost nobody reached it (2026-09-23). */}
  {ownDates && <div class="gutter"><SubscribeForm locale={locale} near={{ slug: stadt, name: city }} anchors /></div>}

  {/* Each says when it is back, or when it last ran (MarketRow). */}
  {undated.length > 0 && (
    <Section id="undated" title={s.noDateYet} lede={s.noDateYetLede(undated.length)}>
      <div class="gutter">
        {undated.map((market) => <MarketRow market={market} locale={locale} variant={only ? 'feature' : 'row'} eager={!!only} showRhythm omitCity showDay={false} showFacts />)}
      </div>
      {only && !ownDates && (
      <div class="gutter route"><Button href={routeHref} variant="primary" block rel="noopener nofollow" target="_blank"><Icon name="map" size={18} />{s.route}</Button></div>
    )}
    </Section>
  )}

  {/* A town with nothing dated: the town's own markets first, then the one
      thing a visitor here can ask for — to be told when there is a date. */}
  {!ownDates && <div class="gutter"><SubscribeForm locale={locale} near={{ slug: stadt, name: city }} alert={{}} anchors /></div>}

  {nearby.length > 0 && (
    <aside data-outside-floor>
      <Section title={s.nearbyHeading(nearbyKm)} lede={s.nearbyLede(city)}>
        {nearbyGroups.map((group) => (
          <section class="day-group gutter" data-day={group.date}>
            {group.monthLabel && <p class="month">{group.monthLabel}</p>}
            <h3 class="day-head">
              <span class="weekday">{group.weekday}</span>
              <span class="date">{group.label}</span>
              <span class="count">{s.marketCount(group.rows.length)}</span>
            </h3>
            {group.rows.map(({ market, km }) => (
              <MarketRow market={market} locale={locale} showRhythm showDay={false} distance={`${Math.round(km)} km`} showFacts />
            ))}
          </section>
        ))}
      </Section>
    </aside>
  )}

  {/* A big town's own paragraph (Delfim, 2026-10-13, design/town-intro-v1.html):
      under its markets, so the list still comes first on a phone. Written by
      hand for that town alone, in each of its locales, and only where one was
      written — never a template (PAGES.md §City 7). */}
  {markets[0].cityDescription && (
    <Section title={s.townIntro(city)}>
      <div class="prose gutter">{markets[0].cityDescription.split(/\n\s*\n/).map((p) => <p>{p}</p>)}</div>
    </Section>
  )}

  {/* Navigation, so it sits after the thing people came for rather than
      between the headline and the first market: the towns around this one
      (src/lib/towns.ts), then the canton. */}
  {towns.length > 0 && (
    <Section title={s.townsNearby}>
      <PillList items={towns.map((town) => ({ href: town.href, label: town.name, meta: `${kmLabel(town.km, localeTag(locale))} · ${s.marketCount(town.n)}` }))} />
    </Section>
  )}
  {!cityState && <PillList items={[{ href: regionPath(locale, markets[0].countryCode, markets[0].countrySlug, regionSlug), label: s.regionLabel(region, markets[0].countryCode) }]} />}

  {hasBadge && <TypeLegend locale={locale} />}

</Page>

<style>
  .route { margin-block-start: var(--space-4); max-width: var(--measure); }
  /* The line under an empty weekend day that says the rows are other towns'. */
  .around-note { margin: var(--space-2) 0 0; }

  /* Sticky, opaque, thin: the one sticky element that earns its place, because
     it is the list's own index rather than chrome. The rule beneath is grey —
     the accent is the date and nothing else. */
  .day-head {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    padding-block: var(--space-4) var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
    background: var(--color-surface);
    font-size: var(--text-date);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
    line-height: 1.2;
  }
  .day-head .date { color: var(--color-accent-text); font-weight: var(--weight-black); }
  .day-head .count { margin-inline-start: auto; color: var(--color-quiet); font-size: var(--text-micro); font-weight: var(--weight-semibold); white-space: nowrap; }

  .month {
    margin: var(--space-6) 0 0;
    color: var(--color-quiet);
    font-size: var(--text-tiny);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  /* The feature sits under a header now, so it needs the room a row gets. */
  .day-group :global(.feature) { padding-block: var(--space-4); border-block-end: var(--border-width) solid var(--color-line); }

  /* One feature, not two, so on a desk it no longer shares .leads' two-column
     grid — and alone at 1200px a 16:10 picture is 750px of photograph before
     the first name. Picture beside the words instead. Keep in step with
     .leads' 720px threshold in base.css. */
  @media (min-width: 720px) {
    .day-group :global(.feature) { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: center; }
    .day-group :global(.feature .pic) { margin-block-end: 0; }
  }
</style>

<script>
  import { inWindow, iso, type DateWindow } from '../../../lib/date-window';
  import { matching } from '../../../lib/date-rows';
  import { cardsIn, setVariant } from '../../../lib/row-shift';

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const list = document.getElementById('list');
  const picked = document.getElementById('picked');
  const template = document.getElementById('day-template') as HTMLTemplateElement | null;
  const empty = document.getElementById('empty');
  const undated = document.getElementById('undated');
  /* The town's own rows, and the "within 25 km" block's. The block's rows are
     other towns' markets at their next date only, so they keep filtering on
     that one date. */
  /* One per market: the week lists a weekly market under each day it runs, and
     a chosen window must not show it twice. The around block is other towns'. */
  const ownAll = list ? Array.from(list.querySelectorAll<HTMLElement>('article.card')).filter((row) => !row.closest('[data-outside-floor]')) : [];
  const own = ownAll.filter((row, i) => ownAll.findIndex((r) => r.dataset.market === row.dataset.market) === i);
  /* Other towns' rows. The town's undated rows carry an empty data-date and are its own (undatedCards below). */
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-date]')).filter((row) => !ownAll.includes(row) && !undated?.contains(row));
  const read = <T,>(key: string, fallback: T): T => { try { return JSON.parse(list?.dataset[key] ?? ''); } catch { return fallback; } };
  const weekdays = read<string[]>('weekdays', []);
  const months = read<string[]>('months', []);

  /* The What row (DateFilters `what`): the ids of the markets holding the
     pressed fact, or null for every market. It narrows the town's own rows
     and leaves the When window as it is; other towns' rows step aside while
     it is on, since we hold no facts for them here. */
  const whatButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-what]'));
  const undatedCards = undated ? Array.from(undated.querySelectorAll<HTMLElement>('article.card')) : [];
  const outside = Array.from(document.querySelectorAll<HTMLElement>('[data-outside-floor]'));
  let keep: Set<string> | null = null;
  let current: DateWindow = 'all';
  const kept = (row: HTMLElement) => !row.dataset.gone && (keep === null || keep.has(row.dataset.market ?? ''));

  /**
   * The day list under a What button: a day with none of its markets goes, the
   * counts say what is left, the first market left is the lead, and a month
   * label goes where the month now turns. Undone by pressing the button again.
   */
  const tidyList = () => {
    if (!list) return;
    const groups = Array.from(list.querySelectorAll<HTMLElement>('section.day-group[data-day]'));
    for (const label of Array.from(list.querySelectorAll('[data-added-month]'))) label.remove();
    const proto = list.querySelector<HTMLElement>('p.month');
    let first: HTMLElement | undefined;
    let month: string | undefined;
    for (const group of groups) {
      const cards = cardsIn(group);
      group.hidden = cards.length === 0;
      if (group.hidden) continue;
      first ??= cards[0];
      const count = group.querySelector('.count');
      if (count) count.textContent = cards.length === 1 ? (list.dataset.countOne ?? '') : (list.dataset.countMany ?? '').replace('2', String(cards.length));
      const here = (group.dataset.day ?? '').slice(0, 7);
      if (month && here !== month && proto && !group.querySelector('p.month')) {
        const label = proto.cloneNode(true) as HTMLElement;
        label.dataset.addedMonth = '';
        label.textContent = `${months[Number(here.slice(5)) - 1] ?? ''} ${here.slice(0, 4)}`;
        group.prepend(label);
      }
      month = here;
    }
    for (const card of ownAll) setVariant(card, card === first ? 'feature' : 'row');
  };

  /**
   * A chosen window, as its own list: every market with a date in it, under
   * that date's header, showing that date's hours. A row is copied, not moved
   * — a market on Saturday and Sunday belongs under both — and the copy drops
   * today's clock when it stands for another day.
   */
  const renderPicked = (window: DateWindow, now: Date): number => {
    if (!picked || !template) return 0;
    picked.replaceChildren();
    const byDate = new Map<string, { row: HTMLElement; hours: string }[]>();
    for (const row of own) {
      if (row.hidden) continue;
      for (const d of matching(row, window, now)) {
        // A row moved past today's closed date (src/lib/row-shift.ts).
        if (d.date < (row.dataset.date ?? '')) continue;
        if (!byDate.has(d.date)) byDate.set(d.date, []);
        byDate.get(d.date)!.push({ row, hours: d.hours });
      }
    }
    const today = iso(now);
    let shown = 0;
    for (const date of [...byDate.keys()].sort()) {
      const items = byDate.get(date)!.sort((a, b) => a.hours.localeCompare(b.hours));
      const group = (template.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      const d = new Date(`${date}T12:00:00`);
      group.dataset.day = date;
      group.querySelector('.weekday')!.textContent = date === today ? (list?.dataset.today ?? '') : (weekdays[d.getDay()] ?? '');
      group.querySelector('.date')!.textContent = `${d.getDate()}${list?.dataset.dot ?? ''} ${months[d.getMonth()] ?? ''}`;
      group.querySelector('.count')!.textContent = items.length === 1
        ? (list?.dataset.countOne ?? '')
        : (list?.dataset.countMany ?? '').replace('2', String(items.length));
      for (const { row, hours } of items) {
        const copy = row.cloneNode(true) as HTMLElement;
        copy.classList.replace('feature', 'row');
        copy.dataset.date = date;
        const shownHours = copy.querySelector<HTMLElement>('.hours');
        if (shownHours && hours) shownHours.textContent = hours;
        if (date !== today) {
          copy.classList.remove('over');
          copy.querySelector<HTMLElement>('[data-clock]')?.setAttribute('hidden', '');
        }
        group.appendChild(copy);
        shown++;
      }
      picked.appendChild(group);
    }
    return shown;
  };

  /**
   * A row is a market, and it filters on the date it displays — so the day a
   * visitor is shown and the day the chip matched can never disagree. There
   * are no day bands to hide or recount any more. The "No date yet" block has
   * nothing to say about a chosen day, so it goes with any window but All.
   */
  const groupsOutside = () => Array.from(document.querySelectorAll<HTMLElement>('[data-day]')).filter((g) => !list?.contains(g) && !picked?.contains(g));
  const apply = (window: DateWindow) => {
    const now = new Date();
    const all = window === 'all';
    current = window;
    for (const row of [...ownAll, ...undatedCards]) row.hidden = !kept(row);
    for (const block of outside) block.hidden = keep !== null;
    if (all) tidyList();
    if (list) list.hidden = !all;
    if (picked) picked.hidden = all;
    let shown = all ? own.filter((row) => !row.hidden).length : renderPicked(window, now);
    for (const row of rows) {
      const visible = keep === null && !row.dataset.gone && inWindow(row.dataset.date ?? '', window, now);
      row.hidden = !visible;
      if (visible) shown++;
    }
    const undatedShown = undatedCards.filter((row) => !row.hidden).length;
    if (undated) undated.hidden = window !== 'all' || undatedShown === 0;
    if (all) shown += undatedShown;
    // A day whose rows are all hidden hides with them; every row in a group
    // shares its date, so the group is shown or hidden whole.
    for (const group of groupsOutside()) {
      group.hidden = !inWindow(group.dataset.day ?? '', window, now) || cardsIn(group).length === 0;
    }
    if (empty) empty.hidden = shown > 0;
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      apply((button.dataset.filter ?? 'all') as DateWindow);
    });
  }

  for (const button of whatButtons) {
    button.addEventListener('click', () => {
      const on = button.getAttribute('aria-pressed') !== 'true';
      for (const other of whatButtons) other.setAttribute('aria-pressed', String(on && other === button));
      keep = on ? new Set((button.dataset.ids ?? '').split(' ').filter(Boolean)) : null;
      apply(current);
    });
  }

  /**
   * A market closed for today moves on to its next date (MarketRow,
   * src/lib/row-shift.ts) — here that means under its own day: an existing
   * group, or a new one in date order. A day left with nothing goes, and the
   * soonest market is the lead again (Delfim, 2026-10-10: only what is on or
   * still to come).
   */
  const regroup = (container: HTMLElement | null, lead: boolean) => {
    if (!container || !template) return;
    const days = () => Array.from(container.querySelectorAll<HTMLElement>('section.day-group[data-day]'));
    for (const group of days()) {
      for (const card of cardsIn(group)) {
        const date = card.dataset.date ?? '';
        if (date === group.dataset.day) continue;
        let target = days().find((g) => g.dataset.day === date);
        if (!target) {
          target = (template.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
          const d = new Date(`${date}T12:00:00`);
          target.dataset.day = date;
          target.className = group.className;
          target.querySelector('.weekday')!.textContent = weekdays[d.getDay()] ?? '';
          target.querySelector('.date')!.textContent = `${d.getDate()}${list?.dataset.dot ?? ''} ${months[d.getMonth()] ?? ''}`;
          const later = days().find((g) => (g.dataset.day ?? '') > date);
          group.parentElement!.insertBefore(target, later ?? null);
        }
        // Already under that day — a Saturday-and-Sunday market closed on Saturday.
        if (cardsIn(target).some((c) => c !== card && c.dataset.market === card.dataset.market)) { card.remove(); continue; }
        target.appendChild(card);
      }
    }
    for (const group of days()) {
      const n = cardsIn(group).length;
      if (n === 0) { group.remove(); continue; }
      const count = group.querySelector('.count');
      if (count) count.textContent = n === 1 ? (list?.dataset.countOne ?? '') : (list?.dataset.countMany ?? '').replace('2', String(n));
    }
    if (lead) {
      const first = days()[0] ? cardsIn(days()[0])[0] : undefined;
      for (const card of Array.from(container.querySelectorAll<HTMLElement>('article.card'))) setVariant(card, card === first ? 'feature' : 'row');
    }
  };
  const nearbyBlock = document.querySelector<HTMLElement>('[data-outside-floor]');
  /* regroup moves and drops by what is visible, so it runs on the whole list
     and the What button, if one is pressed, is applied again after. */
  const settle = () => {
    const held = keep;
    keep = null;
    for (const row of ownAll) row.hidden = !kept(row);
    regroup(list, true);
    regroup(nearbyBlock, false);
    keep = held;
    if (keep) apply(current);
  };
  document.addEventListener('fynda:moved', settle);
  settle();

  // The home page's search card sends the chosen period here. Pressing the
  // matching chip rather than filtering directly keeps one code path, and
  // leaves the control showing what is actually applied.
  const wanted = new URLSearchParams(location.search).get('zeit');
  const preset = buttons.find((button) => button.dataset.filter === wanted);
  if (preset) preset.click();
  else apply('all');
</script>
