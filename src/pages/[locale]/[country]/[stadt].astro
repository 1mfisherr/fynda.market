---
/**
 * City page — `/de/schweiz/[stadt]/`.
 *
 * The best-earning page type on v1 and the one the home page's city list points
 * at. Unlike home it shows every date for the city: someone here has already
 * chosen the place, so the list is the answer rather than a sample of it.
 */
import Page from '../../../layouts/Page.astro';
import SubscribeForm from '../../../components/SubscribeForm.astro';
import DateFilters from '../../../components/DateFilters.astro';
import MarketRow from '../../../components/MarketRow.astro';
import PillList from '../../../components/PillList.astro';
import Section from '../../../components/Section.astro';
import TypeLegend from '../../../components/TypeLegend.astro';
import { getMarkets, HORIZON_DAYS } from '../../../lib/markets';
import { byMarket, datedRows, groupByDay, lastChecked, nearbyMarkets, undatedMarkets } from '../../../lib/lists';
import { formatDate, formatDateShort, formatTimeRange, parseDate, todayIso } from '../../../lib/format';
import { BADGED_KINDS } from '../../../lib/vocabulary';
import { DEFAULT_RADIUS } from '../../../lib/geo';
import { LOCALES, cityPath, homePath, regionPath, type Locale } from '../../../lib/i18n';
import { t } from '../../../lib/strings';
import { fitTitle } from '../../../lib/titles';
import type { Market } from '../../../lib/types';

/**
 * One city page per city per locale. A city carries the same slug in all four —
 * Zürich is `zurich` in every language — so the alternate paths differ only in
 * the locale and the country segment, and are read straight off the slug.
 */
export async function getStaticPaths() {
  const byLocale = new Map<Locale, Market[]>();
  for (const locale of LOCALES) byLocale.set(locale, await getMarkets(locale));

  // citySlug -> the country segment it sits under, per locale. The country is
  // the one part of the path still translated (schweiz / suisse / svizzera),
  // and it is looked up rather than assumed because a second country is coming.
  const countryOf = new Map<Locale, Map<string, string>>();
  for (const locale of LOCALES) {
    countryOf.set(locale, new Map(byLocale.get(locale)!.map((m) => [m.citySlug, m.countrySlug])));
  }

  const paths = [];
  for (const locale of LOCALES) {
    const markets = byLocale.get(locale)!;
    const cities = new Map(markets.map((m) => [m.citySlug, m]));
    for (const [stadt, sample] of cities) {
      const here = markets.filter((m) => m.citySlug === stadt);
      const nearby = nearbyMarkets(here, markets);
      const alternates = LOCALES.map((other) => {
        const country = countryOf.get(other)!.get(stadt);
        return country ? { locale: other, path: cityPath(other, country, stadt) } : null;
      }).filter(Boolean) as { locale: Locale; path: string }[];

      paths.push({
        params: { locale, country: sample.countrySlug, stadt },
        props: { locale, city: sample.city, stadt, region: sample.region, regionSlug: sample.regionSlug, markets: here, nearby, alternates },
      });
    }
  }
  return paths;
}

const { locale, city, stadt, region, regionSlug, markets, nearby, alternates } = Astro.props;
const s = t(locale);
/* Every date, for the counts and the answer sentence; then one row per market,
   which is what the page actually renders — src/lib/lists.ts. */
const rows = datedRows(markets);
const checked = lastChecked(rows);
const list = byMarket(rows);
/* The rest of the town's markets: no date inside the horizon, listed under
   their own header with the rhythm line, hidden by any When but All. */
const undated = undatedMarkets(markets);

const year = new Date().getFullYear();

/**
 * The answer sentence, before the list. Tripadvisor opens a city page with the
 * count in the title and one line that answers the query; it is also where AI
 * answers are extracted from — 44% of citations come from the first 30% of a
 * page. So: which market is next, when, and where.
 */
/**
 * The count leads, but "Flohmarkt" is the query and must survive: nobody
 * searches "7 Märkte in Luzern". Ranked-list shapes are what AI answers cite,
 * and this is that shape without losing the head term.
 */
/* The count is what the list holds, not what the city holds. `markets`
   includes markets with no upcoming date, so the old heading said 17 over
   fourteen rows — invisible while the list was 61 rows of repeats, and
   the first thing anyone would count now that it is one row each. */
/* …and the list now holds every market the town has — dated ones under their
   day, the rest under "No date yet" — so the count is simply all of them.
   (Before the undated were listed, "Die 0 Flohmärkte in Muttenz 2026" was a
   title in Google for a fortnight.) */
const heading = s.cityHeading(markets.length, city, year);

// The earliest upcoming date, not the first row of an unsorted list: `rows` is
// in market order, so `.find()` here answered with whichever market happened to
// be first in the database.
const soonest = [...rows]
  .filter((row) => row.next!.status !== 'cancelled')
  .sort((a, b) => a.next!.date.localeCompare(b.next!.date) || (a.next!.startTime ?? '').localeCompare(b.next!.startTime ?? ''))[0];
const answer = soonest
  ? s.cityNext(
      soonest.name,
      formatDate(soonest.next!.date, locale),
      formatTimeRange(soonest.next!.startTime, soonest.next!.endTime, locale),
      soonest.venueName
    )
  : s.cityNoDate;
/**
 * The search snippet. It said "Alle bekannten Flohmärkte in Worb — mit
 * Terminen, Öffnungszeiten und Absagen" on every city page, and Search
 * Console's first nine days showed what that earns: Worb, Wettingen and Chur
 * at position 5–8 with 100–200 impressions each and no clicks. The person
 * searching "flohmarkt worb" wants to know when, and the market page's snippet
 * already answers that. So the description is the answer sentence the page
 * opens with, plus the count — the generic line stays only for a city with
 * nothing upcoming, where it is the honest description.
 */
const description = soonest
  ? s.cityDescription(
      city,
      soonest.name,
      formatDate(soonest.next!.date, locale),
      formatTimeRange(soonest.next!.startTime, soonest.next!.endTime, locale),
      soonest.venueName,
      rows.length,
      Math.round(HORIZON_DAYS / 30)
    )
  : `${s.cityNoDate} ${s.cityIntro(city, region)}`;
/**
 * The list, grouped under the day it happens. It was fifteen rows each carrying
 * its own "SA 19." — the same day four times over, and the month changing
 * twice with nothing to say so. People scan headings, not rows (NN/g's
 * eyetracking, and both product studies of 2026-09-15 said the same). So one
 * header per day, sticky while its rows scroll past, and a month label where
 * the month turns. The date in the header is where the accent lives now: once
 * per day rather than once per row, which is what makes it mean something.
 *
 * Only the very first market is the feature. Two features and a two-line chip
 * row put the first market name 1,300px down a phone; one puts three markets
 * on the first screen.
 */
const today = todayIso();
interface Group<T> { date: string; label: string; weekday: string; monthLabel?: string; rows: T[] }
/** The day groups from lists.ts, with this page's header words on each. */
function labelled<T>(items: T[], dateOf: (item: T) => string): Group<T>[] {
  return groupByDay(items, dateOf).map(({ date, rows }, i, all) => {
    const d = parseDate(date);
    const dot = locale === 'de' ? '.' : '';
    const monthTurned = i > 0 && all[i - 1].date.slice(0, 7) !== date.slice(0, 7);
    return {
      date,
      weekday: date === today ? s.filterToday : s.weekdaysLong[d.getDay()],
      label: `${d.getDate()}${dot} ${s.monthsLong[d.getMonth()]}`,
      monthLabel: monthTurned ? `${s.monthsLong[d.getMonth()]} ${d.getFullYear()}` : undefined,
      rows,
    };
  });
}
const groups = labelled(list, (market) => market.next.date);
const nearbyGroups = labelled(nearby, ({ market }) => market.next.date);

/* The legend explains the badge colours. With no badged market on the page it
   teaches a colour system nothing on the page uses — the market page dropped
   it for the same reason. */
const hasBadge = [...list, ...nearby.map((n) => n.market)].some((market) => BADGED_KINDS.has(market.kind));

const site = 'https://fynda.market';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'fynda.market', item: `${site}${homePath(locale)}` },
    { '@type': 'ListItem', position: 2, name: region, item: `${site}${regionPath(locale, markets[0].countrySlug, regionSlug)}` },
    { '@type': 'ListItem', position: 3, name: city, item: `${site}${cityPath(locale, markets[0].countrySlug, stadt)}` },
  ],
};
---
<Page locale={locale} alternates={alternates} title={fitTitle(heading, soonest && s.titleNext(formatDateShort(soonest.next!.date, locale)))} description={description} analytics={{ city: stadt, region: regionSlug }}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="page-head gutter">
    <h1>{heading}</h1>
    <p class="answer">{answer}</p>
    {rows.length > 0 && (
      <p class="meta">{s.dateCount(rows.length)} {s.inNextMonths(Math.round(HORIZON_DAYS / 30))}{checked && <> · {s.lastChecked(formatDateShort(checked, locale))}</>}</p>
    )}
  </section>

  {/* The nearby rows count too: on Worb, "Wochenende" showing Bern's Saturday
      market is the point of the block. */}
  <DateFilters locale={locale} dates={[...list.map((m) => m.next.date), ...nearby.map((n) => n.market.next.date)]} />

  {/* One row per market, not one per date. Zürich was 61 rows for 14 markets
      under a heading that said 17; the recurrence phrase on each row says what
      the other forty-seven were repeating. See src/lib/lists.ts. */}
  <Section>
    <div id="list">
      {groups.map((group, g) => (
        <section class="day-group gutter" data-day={group.date}>
          {group.monthLabel && <p class="month">{group.monthLabel}</p>}
          <h2 class="day-head">
            <span class="weekday">{group.weekday}</span>
            <span class="date">{group.label}</span>
            <span class="count">{s.marketCount(group.rows.length)}</span>
          </h2>
          {group.rows.map((market, i) => (
            <MarketRow market={market} locale={locale} variant={g === 0 && i === 0 ? 'feature' : 'row'} showRhythm omitCity showDay={false} />
          ))}
        </section>
      ))}
    </div>
    <p id="empty" class="gutter meta" hidden>{s.nothingInPeriod}</p>
  </Section>

  {undated.length > 0 && (
    <Section id="undated" title={s.noDateYet} lede={s.noDateYetLede}>
      <div class="gutter">
        {undated.map((market) => <MarketRow market={market} locale={locale} showRhythm omitCity showDay={false} />)}
      </div>
    </Section>
  )}

  {nearby.length > 0 && (
    <aside data-outside-floor>
      <Section title={s.nearbyHeading(DEFAULT_RADIUS)} lede={s.nearbyLede(city)}>
        {nearbyGroups.map((group) => (
          <section class="day-group gutter" data-day={group.date}>
            {group.monthLabel && <p class="month">{group.monthLabel}</p>}
            <h3 class="day-head">
              <span class="weekday">{group.weekday}</span>
              <span class="date">{group.label}</span>
              <span class="count">{s.marketCount(group.rows.length)}</span>
            </h3>
            {group.rows.map(({ market, km }) => (
              <MarketRow market={market} locale={locale} showRhythm showDay={false} distance={`${Math.round(km)} km`} />
            ))}
          </section>
        ))}
      </Section>
    </aside>
  )}

  {/* Navigation, so it sits after the thing people came for rather than
      between the headline and the first market. */}
  <PillList items={[{ href: regionPath(locale, markets[0].countrySlug, regionSlug), label: s.regionLabel(region) }]} />

  {hasBadge && <TypeLegend locale={locale} />}

  <div class="gutter"><SubscribeForm locale={locale} near={{ slug: stadt, name: city }} /></div>
</Page>

<style>
  /* Sticky, opaque, thin: the one sticky element that earns its place, because
     it is the list's own index rather than chrome. The rule beneath is grey —
     the accent is the date and nothing else. */
  .day-head {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    padding-block: var(--space-4) var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
    background: var(--color-surface);
    font-size: var(--text-date);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
    line-height: 1.2;
  }
  .day-head .date { color: var(--color-accent); font-weight: var(--weight-black); }
  .day-head .count { margin-inline-start: auto; color: var(--color-quiet); font-size: var(--text-micro); font-weight: var(--weight-semibold); white-space: nowrap; }

  .month {
    margin: var(--space-6) 0 0;
    color: var(--color-quiet);
    font-size: var(--text-tiny);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  /* The feature sits under a header now, so it needs the room a row gets. */
  .day-group :global(.feature) { padding-block: var(--space-4); border-block-end: var(--border-width) solid var(--color-line); }

  /* One feature, not two, so on a desk it no longer shares .leads' two-column
     grid — and alone at 1200px a 16:10 picture is 750px of photograph before
     the first name. Picture beside the words instead. Keep in step with
     .leads' 720px threshold in base.css. */
  @media (min-width: 720px) {
    .day-group :global(.feature) { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: center; }
    .day-group :global(.feature .pic) { margin-block-end: 0; }
  }
</style>

<script>
  import { inWindow, type DateWindow } from '../../../lib/date-window';

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-date]'));
  const empty = document.getElementById('empty');
  const undated = document.getElementById('undated');

  /**
   * A row is a market, and it filters on the date it displays — so the day a
   * visitor is shown and the day the chip matched can never disagree. There
   * are no day bands to hide or recount any more. The "No date yet" block has
   * nothing to say about a chosen day, so it goes with any window but All.
   */
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-day]'));
  const apply = (window: DateWindow) => {
    const now = new Date();
    let shown = 0;
    for (const row of rows) {
      const visible = inWindow(row.dataset.date ?? '', window, now);
      row.hidden = !visible;
      if (visible) shown++;
    }
    if (undated) undated.hidden = window !== 'all';
    // A day whose rows are all hidden hides with them; every row in a group
    // shares its date, so the group is shown or hidden whole.
    for (const group of groups) {
      group.hidden = !inWindow(group.dataset.day ?? '', window, now);
    }
    if (empty) empty.hidden = shown > 0;
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      apply((button.dataset.filter ?? 'all') as DateWindow);
    });
  }

  // The home page's search card sends the chosen period here. Pressing the
  // matching chip rather than filtering directly keeps one code path, and
  // leaves the control showing what is actually applied.
  const wanted = new URLSearchParams(location.search).get('zeit');
  const preset = buttons.find((button) => button.dataset.filter === wanted);
  if (preset) preset.click();
  else apply('all');
</script>
