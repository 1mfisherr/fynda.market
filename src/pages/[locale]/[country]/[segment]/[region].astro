---
/**
 * Canton page — `/de/schweiz/kanton/[kanton]/`.
 *
 * The type segment is what makes this level possible at all: five Swiss canton
 * names are also city names, and Berlin and Hamburg are city-states, so the
 * path has to say which kind of place it means. `kanton` / `canton` / `cantone`
 * comes from LOCALE[locale].segments.region — never written into a template.
 *
 * It is not a bigger city page. The query behind "flohmarkt kanton zürich" is
 * "which towns near me have one", so the towns come first, with their counts,
 * and the dates follow. That is also what keeps a one-market canton from
 * reading as a copy of its one city page.
 *
 * Every canton with a market gets a page. There is no density gate: the content
 * floor is the gate, and it is measured on the rendered page rather than
 * guessed from a market count.
 */
import Page from '../../../../layouts/Page.astro';
import CtaCard from '../../../../components/CtaCard.astro';
import DateFilters from '../../../../components/DateFilters.astro';
import LinkList from '../../../../components/LinkList.astro';
import MarketRow from '../../../../components/MarketRow.astro';
import Section from '../../../../components/Section.astro';
import TypeLegend from '../../../../components/TypeLegend.astro';
import { getMarkets, HORIZON_DAYS } from '../../../../lib/markets';
import { byMarket, datedRows } from '../../../../lib/lists';
import { formatDate, formatTimeRange } from '../../../../lib/format';
import { LOCALE, LOCALES, cityPath, homePath, regionPath, type Locale } from '../../../../lib/i18n';
import { t } from '../../../../lib/strings';
import type { Market } from '../../../../lib/types';

/**
 * One page per canton per locale. A canton carries the same slug in all four —
 * Ticino is `ticino` in German too — so only the locale, the country segment
 * and the type word (kanton / canton / cantone) change between alternates.
 */
export async function getStaticPaths() {
  const byLocale = new Map<Locale, Market[]>();
  for (const locale of LOCALES) byLocale.set(locale, await getMarkets(locale));

  // regionSlug -> the country segment it sits under, per locale. See the city
  // page: the country is the last translated part of the path.
  const countryOf = new Map<Locale, Map<string, string>>();
  for (const locale of LOCALES) {
    countryOf.set(locale, new Map(byLocale.get(locale)!.map((m) => [m.regionSlug, m.countrySlug])));
  }

  const paths = [];
  for (const locale of LOCALES) {
    const markets = byLocale.get(locale)!;
    const regions = new Map(markets.map((m) => [m.regionSlug, m]));
    for (const [region, sample] of regions) {
      const here = markets.filter((m) => m.regionSlug === region);
      const alternates = LOCALES.map((other) => {
        const country = countryOf.get(other)!.get(region);
        return country ? { locale: other, path: regionPath(other, country, region) } : null;
      }).filter(Boolean) as { locale: Locale; path: string }[];

      paths.push({
        params: { locale, country: sample.countrySlug, segment: LOCALE[locale].segments.region, region },
        props: { locale, region, regionName: sample.region, country: sample.countrySlug, markets: here, alternates },
      });
    }
  }
  return paths;
}

const { locale, region, regionName, country, markets, alternates } = Astro.props;
const s = t(locale);

/* Every date, for the counts and the answer sentence; then one row per market,
   which is what the page actually renders — src/lib/lists.ts. */
const rows = datedRows(markets);
const list = byMarket(rows);

/** Towns in this canton, most markets first: the ranking is the useful part. */
const cities = [...new Map(markets.map((m) => [m.citySlug, m.city]))]
  .map(([slug, city]) => ({ slug, city, count: markets.filter((m) => m.citySlug === slug).length }))
  .sort((a, b) => b.count - a.count || a.city.localeCompare(b.city, locale));

const year = new Date().getFullYear();
/* The count is what the list holds, not what the city holds. `markets`
   includes markets with no upcoming date, so the old heading said 17 over
   fourteen rows — invisible while the list was 61 rows of repeats, and
   the first thing anyone would count now that it is one row each. */
const heading = s.regionHeading(list.length, regionName, year);

// The earliest non-cancelled date in the canton, sorted rather than found:
// `rows` is in market order, not date order.
const soonest = [...rows]
  .filter((row) => row.next!.status !== 'cancelled')
  .sort((a, b) => a.next!.date.localeCompare(b.next!.date) || (a.next!.startTime ?? '').localeCompare(b.next!.startTime ?? ''))[0];
const answer = soonest
  ? s.cityNext(
      soonest.name,
      formatDate(soonest.next!.date, locale),
      formatTimeRange(soonest.next!.startTime, soonest.next!.endTime, locale),
      `${soonest.venueName}, ${soonest.city}`
    )
  : s.cityNoDate;

const site = 'https://fynda.market';
// Home, then canton. The country page does not exist yet — docs/ARCHITECTURE.md
// — and a breadcrumb whose item 404s is worse than a shorter breadcrumb. The
// country step goes in when the page does.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Fynda', item: `${site}${homePath(locale)}` },
    { '@type': 'ListItem', position: 2, name: regionName, item: `${site}${regionPath(locale, country, region)}` },
  ],
};
---
<Page locale={locale} alternates={alternates} title={`${heading} | Fynda`} description={s.regionIntro(regionName)}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="page-head gutter">
    <h1>{heading}</h1>
    <p class="answer">{answer}</p>
    <p class="meta">{s.dateCount(rows.length)} {s.inNextMonths(Math.round(HORIZON_DAYS / 30))} · {s.lastChecked}</p>
  </section>

  <Section title={s.cities}>
    <LinkList items={cities.map((c) => ({
      href: cityPath(locale, country, c.slug),
      label: c.city,
      meta: s.marketCount(c.count),
    }))} />
  </Section>

  <DateFilters locale={locale} dates={list.map((m) => m.next.date)} />

  {/* One row per market, not one per date. Zürich was 61 rows for 14 markets
      under a heading that said 17; the recurrence phrase on each row says what
      the other forty-seven were repeating. See src/lib/lists.ts. */}
  <Section>
    <div id="list">
      {list.map((market) => <MarketRow market={market} locale={locale} mode="date" />)}
    </div>
    <p id="empty" class="gutter meta" hidden>{s.nothingInPeriod}</p>
  </Section>

  <TypeLegend locale={locale} />

  <CtaCard locale={locale} kind="newsletter" body={`${s.newsletterBody} ${regionName}.`} />
</Page>

<script>
  import { inWindow, type DateWindow } from '../../../../lib/date-window';

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-date]'));
  const empty = document.getElementById('empty');

  /**
   * A row is a market, and it filters on the date it displays — so the day a
   * visitor is shown and the day the chip matched can never disagree. There
   * are no day bands to hide or recount any more.
   */
  const apply = (window: DateWindow) => {
    const now = new Date();
    let shown = 0;
    for (const row of rows) {
      const visible = inWindow(row.dataset.date ?? '', window, now);
      row.hidden = !visible;
      if (visible) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      apply((button.dataset.filter ?? 'all') as DateWindow);
    });
  }
  apply('all');
</script>
