---
/**
 * Market page — the highest-intent visitor on the site. PAGES.md: confirm it is
 * really happening, then get them there. Nothing else.
 *
 * Every block renders only when its data exists. We hold stall counts, seller
 * mix and facilities for nobody yet, so those sections are simply absent rather
 * than filled with placeholders — PLAN.md §The honest gap.
 */
import Page from '../../../layouts/Page.astro';
import Button from '../../../components/Button.astro';
import Icon from '../../../components/Icon.astro';
import LineBadge from '../../../components/LineBadge.astro';
import PhotoOrArt from '../../../components/PhotoOrArt.astro';
import Section from '../../../components/Section.astro';
import TypeLegend from '../../../components/TypeLegend.astro';
import { getMarkets, withinHorizon } from '../../../lib/markets';
import { formatDate, formatDateShort, formatTimeRange, parseDate, toIsoWithOffset } from '../../../lib/format';
import { EVENT_STATUS, LINES } from '../../../lib/vocabulary';
import { LOCALE, LOCALES, cityPath, homePath, marketPath, regionPath, utilityPath, type Locale } from '../../../lib/i18n';
import { t } from '../../../lib/strings';

/**
 * One market page per locale. The slug is the same in every language — a market
 * name is a proper noun — so an alternate is the same page under a different
 * language and section word: /de/markt/x/, /fr/marche/x/, /it/mercato/x/.
 */
export async function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    for (const market of await getMarkets(locale)) {
      paths.push({
        params: { locale, type: LOCALE[locale].segments.market, slug: market.slug },
        props: {
          locale,
          market,
          alternates: LOCALES.map((l) => ({ locale: l, path: marketPath(l, market.slug) })),
        },
      });
    }
  }
  return paths;
}

const { locale, market, alternates } = Astro.props;
const s = t(locale);
const next = market.next;
const cancelled = next?.status === 'cancelled';
const dates = withinHorizon([next, ...market.upcoming].filter(Boolean) as NonNullable<typeof next>[])
  .sort((a, b) => a.date.localeCompare(b.date));
const kind = LINES[market.kind];

const site = 'https://fynda.market';
const url = `${site}${marketPath(locale, market.slug)}`;
const event = next ? {
  '@type': 'Event',
  name: market.name,
  startDate: toIsoWithOffset(next.date, next.startTime, market.timezone),
  ...(next.endTime ? { endDate: toIsoWithOffset(next.date, next.endTime, market.timezone) } : {}),
  eventStatus: EVENT_STATUS[next.status],
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: market.venueName,
    address: { '@type': 'PostalAddress', streetAddress: market.addressLine, postalCode: market.postalCode, addressLocality: market.city, addressCountry: 'CH' },
    geo: { '@type': 'GeoCoordinates', latitude: market.lat, longitude: market.lng },
  },
  url,
  // Search Console asks for these four on every Event. We hold real values for
  // all of them, so they are worth emitting — and only where we do: an absent
  // field is a smaller problem than an invented one.
  //
  // `performer` is the fifth it asks for and is deliberately absent. A flea
  // market has no act; naming one to satisfy a checklist is exactly the padding
  // that got v1 classified as spam.
  ...(market.imageUrl ? { image: [`${site}${market.imageUrl}`] } : {}),
  ...(market.description ? { description: market.description } : {}),
  ...(market.organiserName ? {
    organizer: {
      '@type': 'Organization',
      name: market.organiserName,
      ...(market.websiteUrl ? { url: market.websiteUrl } : {}),
    },
  } : {}),
  ...(market.entryFee !== undefined ? {
    offers: {
      '@type': 'Offer',
      price: market.entryFee,
      priceCurrency: 'CHF',
      availability: 'https://schema.org/InStock',
      validFrom: `${next.date}T00:00:00`,
      url,
    },
  } : {}),
} : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(event ? [event] : []),
    // Home, canton, city, market — every step a page that exists. Position 1
    // pointed at a country page that has never been built, so the canton page
    // is what finally makes this trail true rather than plausible.
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Fynda', item: `${site}${homePath(locale)}` },
      { '@type': 'ListItem', position: 2, name: market.region, item: `${site}${regionPath(locale, market.countrySlug, market.regionSlug)}` },
      { '@type': 'ListItem', position: 3, name: market.city, item: `${site}${cityPath(locale, market.countrySlug, market.citySlug)}` },
      { '@type': 'ListItem', position: 4, name: market.name, item: url },
    ] },
  ],
};

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${market.lat},${market.lng}`;
const date = next ? parseDate(next.date) : undefined;
const weekday = date ? s.weekdaysLong[date.getDay()] : undefined;
const month = date ? s.monthsLong[date.getMonth()] : undefined;

/**
 * v1's address_line often already ends in the postcode and city ("Dynamo,
 * Wasserwerkstrasse 21, 8006 Zürich"), so printing the locality line as well
 * repeats it. Show it only when it adds something.
 */
const locality = [market.postalCode, market.city].filter(Boolean).join(' ');
const showLocality = locality.length > 0 && !market.addressLine.includes(locality)
  && !market.addressLine.includes(market.city);

/** Date status, in words. Never colour alone — docs/BRAND.md. */
const STATUS: Record<Locale, Record<string, string>> = {
  de: { confirmed: 'Bestätigt', tentative: 'Vorläufig', cancelled: 'Abgesagt', unverified: 'Nicht bestätigt' },
  fr: { confirmed: 'Confirmé', tentative: 'Provisoire', cancelled: 'Annulé', unverified: 'Non confirmé' },
  it: { confirmed: 'Confermato', tentative: 'Provvisorio', cancelled: 'Annullato', unverified: 'Non confermato' },
  en: { confirmed: 'Confirmed', tentative: 'Provisional', cancelled: 'Cancelled', unverified: 'Not confirmed' },
};

const facts = [
  market.stallCount ? ['Stände', `~${market.stallCount}${market.stallCountBadWeather ? `, bei schlechtem Wetter ~${market.stallCountBadWeather}` : ''}`] : undefined,
  market.sellerMix ? ['Verkäufer', { private: 'nur Private', mixed: 'Private und Händler', trader: 'Händler', new_goods: 'Neuware' }[market.sellerMix]] : undefined,
  market.priceLevel ? ['Preisniveau', { cheap: 'günstig', flohmarkt: 'Flohmarkt', trader: 'Händler' }[market.priceLevel]] : undefined,
  market.entryFee !== undefined ? [s.entryLabel, market.entryFee === 0 ? s.entryFree : `${market.entryFee} CHF`] : undefined,
  market.covered ? ['Gelände', { open: 'offen', partly: 'teilweise gedeckt', indoor: 'drinnen' }[market.covered]] : undefined,
  market.groundSurface ? ['Untergrund', market.groundSurface] : undefined,
].filter(Boolean) as [string, string][];

const facilityItems = market.facilities ? [
  market.facilities.wc !== undefined ? ['WC', market.facilities.wc ? 'ja' : 'nein'] : undefined,
  market.facilities.dogs !== undefined ? ['Hunde', market.facilities.dogs ? 'ja' : 'nein'] : undefined,
  market.facilities.strollers ? ['Kinderwagen', market.facilities.strollers] : undefined,
  market.facilities.food ? ['Essen', market.facilities.food] : undefined,
  market.facilities.cash ? ['Bargeld', market.facilities.cash] : undefined,
].filter(Boolean) as [string, string][] : [];
---
<Page
  locale={locale}
  alternates={alternates}
  title={`${market.name}, ${market.city} — ${s.dates} ${new Date().getFullYear()} | Fynda`}
  description={`${kind.full[locale]}, ${market.city}. ${next ? s.cityNext(market.name, formatDate(next.date, locale), formatTimeRange(next.startTime, next.endTime, locale), market.venueName) : s.cityNoDate}`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  {/* One grid, so the width above 900px can put the actions beside the page
      instead of below it. The DOM order is the mobile order and the reading
      order both — hero, title, what to do, then the detail — so nothing is
      re-sequenced for sighted users only. */}
  <div class="market">
    <div class="photo-hero">
      <PhotoOrArt market={market} width={720} height={210} loading="eager" />
      <span class="type eyebrow"><LineBadge kind={market.kind} /> {kind.full[locale]}</span>
    </div>

    <div class="head gutter">
      <h1>{market.name}</h1>
      {next && (
        <div class:list={['date', { cancelled }]}>
          <strong>{String(date?.getDate()).padStart(2, '0')}</strong>
          <span>
            <b class="eyebrow">{weekday}, {month}</b>
            {formatTimeRange(next.startTime, next.endTime, locale) && <em>{formatTimeRange(next.startTime, next.endTime, locale)} {s.timeSuffix}</em>}
          </span>
        </div>
      )}
      {market.packUpFrom && <p class="pack">{s.packUpFrom(market.packUpFrom)}</p>}
      {/* Who stands behind the date. Saying "not yet confirmed with the
          organiser" told a visitor the one thing that destroys trust and was
          not even true — we had confirmed it, just not with the organiser.
          An organiser-sourced date is the strong claim and gets the accent;
          docs/BRAND.md lets the accent mark date and status, and nothing else. */}
      {next && (
        next.origin === 'organiser' ? (
          <p class="freshness organiser">{s.organiserConfirmed}</p>
        ) : (
          <p class="freshness meta-quiet">
            {next.confirmedAt ? s.confirmedOn(formatDateShort(next.confirmedAt, locale)) : s.notConfirmed}
          </p>
        )
      )}
    </div>

    {/* Directions is 55% of all outbound clicks — PAGES.md puts it above the fold.
        The second button is the organiser's own page where we hold one, which is
        153 of 157 markets; it used to scroll down this page instead. */}
    <div class="side">
      <div class="actions gutter">
        <Button href={mapsUrl} variant="primary" block rel="noopener nofollow" target="_blank"><Icon name="map" size={18} />{s.route}</Button>
        {market.websiteUrl
          ? <Button href={market.websiteUrl} block rel="noopener nofollow" target="_blank">{s.organiserWebsite}</Button>
          : <Button href="#hinkommen" block>{s.organiser}</Button>}
      </div>

      {/* Both are retention, not decoration: a market in someone's calendar keeps
          being useful without them returning, and a saved market is what the
          Friday newsletter is eventually built on. Saving is localStorage only —
          no account, docs/PLAN.md.

          They share a row rather than stacking full-width under Route. Four block
          buttons of the same size made "Merken" look like as big a decision as
          getting there, which it is not — Route is 55% of all outbound clicks. */}
      <div class="keep gutter">
        <Button href={`/ics/${market.slug}.ics`}><Icon name="check" size={16} />{s.addToCalendar}</Button>
        <Button data-save={market.slug} data-label-save={s.save} data-label-saved={s.savedState} aria-pressed="false"><Icon name="bookmark" size={16} />{s.save}</Button>
      </div>
    </div>

    <div class="detail">
      {market.description && (
        <Section level="sub"><p class="blurb meta">{market.description}</p></Section>
      )}

      {facts.length > 0 && (
        <Section level="sub" title={s.whatToExpect}>
          <dl class="gutter">{facts.map(([term, value]) => <><dt>{term}</dt><dd>{value}</dd></>)}</dl>
        </Section>
      )}

      {market.timing && (
        <Section level="sub" title={s.whenToGo}>
          <div class="timing gutter">
            {market.timing.map((slot) => (
              <div><strong>{slot.from}</strong><span><b>{slot.label}</b>{slot.note && <em>{slot.note}</em>}</span></div>
            ))}
          </div>
        </Section>
      )}

      <Section level="sub" title={s.gettingThere} id="hinkommen">
        <p class="address gutter">
          <b>{market.venueName}</b>
          <span>{market.addressLine}</span>
          {showLocality && <span>{locality}</span>}
        </p>
        {market.gettingThere && <p class="getting gutter">{market.gettingThere}</p>}
        {facilityItems.length > 0 && (
          <div class="facilities gutter">{facilityItems.map(([label, value]) => <span class="chip">{label} <b>{value}</b></span>)}</div>
        )}
      </Section>

      {/* A market between seasons has no date to show, and 40 of 157 are in
          that state in September. The heading used to stand over an empty
          list; the rhythm is what we do know — "Einmal jährlich, zwischen
          April und Oktober" — and it is the honest answer to "when". */}
      <Section level="sub" title={s.dates}>
        {dates.length > 0 ? (
          <ul class="dates list-reset gutter">
            {dates.map((occurrence) => (
              <li class:list={{ cancelled: occurrence.status === 'cancelled' }}>
                <strong>{formatDate(occurrence.date, locale)}</strong>
                {formatTimeRange(occurrence.startTime, occurrence.endTime, locale) && <span>{formatTimeRange(occurrence.startTime, occurrence.endTime, locale)}</span>}
                <em>{STATUS[locale][occurrence.status]}</em>
              </li>
            ))}
          </ul>
        ) : (
          <p class="gutter no-dates">
            <strong>{s.cityNoDate}</strong>
            {market.recurrenceText && <span>{market.recurrenceText}</span>}
          </p>
        )}
      </Section>

      <Section level="sub" title={s.wasItDifferent}>
        <p class="gutter meta">{s.reportIntro}</p>
        {/* The market travels with the report. Asking someone to retype the name
            of the page they are standing on is how a report form goes unused. */}
        <div class="report gutter">
          {[['ausgefallen', s.reportDidNotHappen], ['vorbei', s.reportEndedEarly], ['anderes', s.reportSomethingElse]].map(
            ([grund, label]) => (
              <a class="chip" href={`${utilityPath(locale, 'report')}?markt=${encodeURIComponent(market.name)}&grund=${grund}`}>{label}</a>
            )
          )}
        </div>
      </Section>

      <TypeLegend locale={locale} />
  </div>
</div>
</Page>

<style>
  /*
    Mobile: a plain column, and the gaps are the ones `main.stack` used to
    supply — this grid took its place as main's only child, so it owns them
    now. Above the breakpoint the same four blocks become two columns.
  */
  .market { display: grid; gap: var(--space-6); }
  .side { display: grid; gap: var(--space-6); }
  .detail { display: grid; gap: var(--space-6); }

  /* Running text stops at the reading measure whatever the column is doing.
     Unconditional, because the 720px layout was already setting it ~105
     characters wide, which is long past comfortable at this size. */
  .blurb { max-width: var(--measure); }

  .photo-hero { position: relative; height: var(--hero-height); overflow: hidden; background: var(--color-paper); }
  .type {
    position: absolute;
    inset-block-start: var(--space-hero);
    inset-inline-start: var(--space-hero);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-white);
  }

  h1 { font-size: var(--text-market-name); letter-spacing: var(--tracking-tight); }

  .date {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: center;
    margin-block-start: var(--space-hero);
  }
  .date > strong {
    color: var(--color-accent);
    font-size: var(--text-market-date);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }
  .date span b, .date span em { display: block; }
  .date span em {
    margin-block-start: var(--space-half);
    color: var(--color-grey);
    font-size: var(--text-date);
    font-style: normal;
    font-weight: var(--weight-bold);
  }
  .date.cancelled > strong, .date.cancelled span {
    color: var(--color-quiet);
    text-decoration: line-through;
    text-decoration-color: var(--color-line);
  }

  .pack { margin-block-start: var(--space-2); font-size: var(--text-small); font-weight: var(--weight-bold); }
  .freshness { margin-block-start: var(--space-half); }

  .actions { display: grid; gap: var(--space-2); }
  /* Two secondary actions side by side, one step quieter than the block
     buttons above them. */
  .keep { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .keep :global(.button) { min-width: 0; font-size: var(--text-micro); }
  .keep :global(.button) { padding-inline: var(--space-2); }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-hero);
    margin: 0;
    font-size: var(--text-small);
  }
  dt { color: var(--color-grey); }
  dd { margin: 0; text-align: end; font-weight: var(--weight-bold); }

  .timing > div {
    display: grid;
    grid-template-columns: var(--row-time) 1fr;
    gap: var(--space-row);
    padding-block: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .timing > div:last-child { border-block-end: 0; }
  .timing > div > strong { color: var(--color-quiet); font-size: var(--text-micro); font-weight: var(--weight-black); }
  .timing b, .timing em { display: block; font-size: var(--text-small); }
  .timing em { margin-block-start: var(--space-half); color: var(--color-grey); font-style: normal; }

  .address { display: grid; font-size: var(--text-small); line-height: var(--leading-body); }
  .address b { font-weight: var(--weight-black); }
  .address span { color: var(--color-grey); }
  .getting { margin-block-start: var(--space-2); font-size: var(--text-small); }

  .facilities, .report { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .facilities { margin-block-start: var(--space-3); }
  .chip {
    padding: var(--space-1) var(--space-row);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-photo);
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
  }
  .facilities b { font-weight: var(--weight-black); }

  .dates li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
    font-size: var(--text-small);
  }
  .dates li > strong { font-weight: var(--weight-bold); }
  .dates li > span { color: var(--color-grey); }
  .dates li > em { color: var(--color-quiet); font-size: var(--text-micro); font-style: normal; font-weight: var(--weight-bold); }
  .no-dates { display: flex; flex-direction: column; gap: var(--space-half); max-width: var(--measure); }
  .no-dates > strong { font-weight: var(--weight-bold); }
  .no-dates > span { color: var(--color-grey); }
  .freshness.organiser { color: var(--color-accent); font-weight: var(--weight-bold); }
  .dates li.cancelled > strong, .dates li.cancelled > span {
    color: var(--color-quiet);
    text-decoration: line-through;
    text-decoration-color: var(--color-line);
  }
  .report { margin-block-start: var(--space-3); }

  /*
    The change worth the most on this page. Route is 55% of every outbound
    click on the site and it sat 859px down — below the fold, behind the whole
    date list. Here it is a rail beside the page that never leaves the screen.

    `align-self: start` shrinks the rail to its own height while its grid area
    stays the full height of the page, which is the box sticky then travels
    inside. Keep in step with --breakpoint-wide; a media query cannot read a
    token.
  */
  @media (min-width: 900px) {
    .market {
      grid-template-columns: minmax(0, 1fr) var(--side-column);
      grid-template-areas:
        "hero   side"
        "head   side"
        "detail side";
      column-gap: var(--space-7);
      align-items: start;
    }
    .photo-hero {
      grid-area: hero;
      height: var(--hero-height-wide);
      margin-inline: var(--space-page);
      border-radius: var(--radius-md);
    }
    .head { grid-area: head; }
    .detail { grid-area: detail; }
    /*
      Two- and three-column blocks push their last column to the right edge, so
      a wider container buys nothing but a longer gap between a label and its
      value. They stop where the text does.
    */
    .dates, .timing, dl { max-width: var(--measure); }
    .side {
      grid-area: side;
      position: sticky;
      inset-block-start: var(--space-4);
      align-self: start;
      gap: var(--space-3);
      margin-inline-end: var(--space-page);
      padding-block: var(--space-4);
      border: var(--border-width) solid var(--color-line);
      border-radius: var(--radius-md);
    }
  }
</style>

<script>
  /**
   * Saved markets live in the visitor's own browser. No account, no server, and
   * nothing to leak — docs/PLAN.md settled "saved markets, no accounts". The
   * /de/gemerkt/ page reads the same key.
   */
  const KEY = 'fynda:gemerkt';
  const read = (): string[] => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; }
  };

  const button = document.querySelector<HTMLButtonElement>('[data-save]');
  const slug = button?.dataset.save;

  if (button && slug) {
    const paint = (saved: boolean) => {
      button.setAttribute('aria-pressed', String(saved));
      button.textContent = saved ? (button.dataset.labelSaved ?? '') : (button.dataset.labelSave ?? '');
    };
    paint(read().includes(slug));

    button.addEventListener('click', () => {
      const saved = read();
      const next = saved.includes(slug) ? saved.filter((s) => s !== slug) : [...saved, slug];
      try { localStorage.setItem(KEY, JSON.stringify(next)); } catch { /* private mode */ }
      paint(next.includes(slug));
    });
  }
</script>
