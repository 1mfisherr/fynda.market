---
/**
 * Market page — the highest-intent visitor on the site. PAGES.md: confirm it is
 * really happening, then get them there. Nothing else.
 *
 * Every block renders only when its data exists. We hold stall counts, seller
 * mix and facilities for nobody yet, so those sections are simply absent rather
 * than filled with placeholders — PLAN.md §The honest gap.
 */
import Page from '../../../layouts/Page.astro';
import Button from '../../../components/Button.astro';
import CtaCard from '../../../components/CtaCard.astro';
import SubscribeForm from '../../../components/SubscribeForm.astro';
import Icon from '../../../components/Icon.astro';
import PhotoOrArt from '../../../components/PhotoOrArt.astro';
import Section from '../../../components/Section.astro';
import { getMarkets, withinHorizon } from '../../../lib/markets';
import { formatDate, formatDateShort, formatTimeRange, parseDate, toIsoWithOffset, todayIso } from '../../../lib/format';
import { EVENT_STATUS, LINES } from '../../../lib/vocabulary';
import { LOCALE, LOCALES, cityPath, homePath, marketPath, regionPath, utilityPath, type Locale } from '../../../lib/i18n';
import { t } from '../../../lib/strings';

/**
 * One market page per locale. The slug is the same in every language — a market
 * name is a proper noun — so an alternate is the same page under a different
 * language and section word: /de/markt/x/, /fr/marche/x/, /it/mercato/x/.
 */
export async function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    for (const market of await getMarkets(locale)) {
      paths.push({
        params: { locale, type: LOCALE[locale].segments.market, slug: market.slug },
        props: {
          locale,
          market,
          alternates: LOCALES.map((l) => ({ locale: l, path: marketPath(l, market.slug) })),
        },
      });
    }
  }
  return paths;
}

const { locale, market, alternates } = Astro.props;
const s = t(locale);
const next = market.next;
const cancelled = next?.status === 'cancelled';
const dates = withinHorizon([next, ...market.upcoming].filter(Boolean) as NonNullable<typeof next>[])
  .sort((a, b) => a.date.localeCompare(b.date));
const kind = LINES[market.kind];

const site = 'https://fynda.market';
const url = `${site}${marketPath(locale, market.slug)}`;
const event = next ? {
  '@type': 'Event',
  name: market.name,
  startDate: toIsoWithOffset(next.date, next.startTime, market.timezone),
  ...(next.endTime ? { endDate: toIsoWithOffset(next.date, next.endTime, market.timezone) } : {}),
  eventStatus: EVENT_STATUS[next.status],
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: market.venueName,
    address: { '@type': 'PostalAddress', streetAddress: market.addressLine, postalCode: market.postalCode, addressLocality: market.city, addressCountry: 'CH' },
    geo: { '@type': 'GeoCoordinates', latitude: market.lat, longitude: market.lng },
  },
  url,
  // Search Console asks for these four on every Event. We hold real values for
  // all of them, so they are worth emitting — and only where we do: an absent
  // field is a smaller problem than an invented one.
  //
  // `performer` is the fifth it asks for and is deliberately absent. A flea
  // market has no act; naming one to satisfy a checklist is exactly the padding
  // that got v1 classified as spam.
  ...(market.imageUrl ? { image: [`${site}${market.imageUrl}`] } : {}),
  ...(market.description ? { description: market.description } : {}),
  ...(market.organiserName ? {
    organizer: {
      '@type': 'Organization',
      name: market.organiserName,
      ...(market.websiteUrl ? { url: market.websiteUrl } : {}),
    },
  } : {}),
  ...(market.entryFee !== undefined ? {
    offers: {
      '@type': 'Offer',
      price: market.entryFee,
      priceCurrency: 'CHF',
      availability: 'https://schema.org/InStock',
      validFrom: `${next.date}T00:00:00`,
      url,
    },
  } : {}),
} : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(event ? [event] : []),
    // Home, canton, city, market — every step a page that exists. Position 1
    // pointed at a country page that has never been built, so the canton page
    // is what finally makes this trail true rather than plausible.
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'fynda.market', item: `${site}${homePath(locale)}` },
      { '@type': 'ListItem', position: 2, name: market.region, item: `${site}${regionPath(locale, market.countrySlug, market.regionSlug)}` },
      { '@type': 'ListItem', position: 3, name: market.city, item: `${site}${cityPath(locale, market.countrySlug, market.citySlug)}` },
      { '@type': 'ListItem', position: 4, name: market.name, item: url },
    ] },
  ],
};

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${market.lat},${market.lng}`;

/**
 * The word the page leads with.
 *
 * Someone arrives asking whether it is on. "06" does not answer that; "Heute"
 * does, and it is also the one sentence an AI answer can quote whole.
 *
 * Resolved here because the build knows its own date. Whether the market is
 * open *at this minute* cannot be known at 03:00, so that half is left to the
 * browser below — the page is correct without it.
 */
const today = todayIso();
const tomorrow = (() => {
  const d = parseDate(today);
  d.setDate(d.getDate() + 1);
  return [d.getFullYear(), d.getMonth() + 1, d.getDate()]
    .map((n, i) => (i ? String(n).padStart(2, '0') : String(n)))
    .join('-');
})();
const statusWord = !next
  ? undefined
  : next.date === today ? s.statusToday
  : next.date === tomorrow ? s.statusTomorrow
  : formatDate(next.date, locale);

/** Only a date that is today, with both ends known, can be running right now. */
const liveStart = next && next.date === today && next.startTime
  ? toIsoWithOffset(next.date, next.startTime, market.timezone) : undefined;
const liveEnd = next && next.date === today && next.endTime
  ? toIsoWithOffset(next.date, next.endTime, market.timezone) : undefined;
const canBeLive = !cancelled && Boolean(liveStart && liveEnd);

/**
 * One stamp, not the two grey lines this replaced. The date-level claim leads,
 * because "is this Saturday on" is the question; the market-level confirmation
 * follows it only when it says something the first clause did not. They stay
 * distinct claims — v1 recorded that an organiser confirmed the market's
 * details, never that they confirmed one Saturday.
 */
const stampMain = next?.origin === 'organiser'
  ? s.organiserConfirmed
  : next?.confirmedAt ? s.confirmedOn(formatDateShort(next.confirmedAt, locale)) : s.notConfirmed;
const stampAlso = market.verifiedBy === 'organiser' && next?.origin !== 'organiser'
  ? s.organiserConfirmed : undefined;
const timeRange = next ? formatTimeRange(next.startTime, next.endTime, locale) : undefined;

/**
 * The claim card, on every market no organiser stands behind — 128 of 161.
 *
 * A market whose stamp already reads "Vom Veranstalter bestätigt" is not asked
 * again: asking would call our own stamp into question on the one page where
 * it is doing the most work. The market travels in the query so nobody has to
 * retype the name of the page they came from, the same way the report links do.
 */
const claimed = market.verifiedBy === 'organiser';
const claimHref = `${utilityPath(locale, 'organiser')}`
  + `?markt=${encodeURIComponent(market.name)}&ort=${encodeURIComponent(market.city)}`
  + `&mid=${market.id}`;

/**
 * v1's address_line often already ends in the postcode and city ("Dynamo,
 * Wasserwerkstrasse 21, 8006 Zürich"), so printing the locality line as well
 * repeats it. Show it only when it adds something.
 */
const locality = [market.postalCode, market.city].filter(Boolean).join(' ');
const showLocality = locality.length > 0 && !market.addressLine.includes(locality)
  && !market.addressLine.includes(market.city);

/** Date status, in words. Never colour alone — docs/BRAND.md. */
const STATUS: Record<Locale, Record<string, string>> = {
  de: { confirmed: 'Bestätigt', tentative: 'Vorläufig', cancelled: 'Abgesagt', unverified: 'Nicht bestätigt' },
  fr: { confirmed: 'Confirmé', tentative: 'Provisoire', cancelled: 'Annulé', unverified: 'Non confirmé' },
  it: { confirmed: 'Confermato', tentative: 'Provvisorio', cancelled: 'Annullato', unverified: 'Non confermato' },
  en: { confirmed: 'Confirmed', tentative: 'Provisional', cancelled: 'Cancelled', unverified: 'Not confirmed' },
};

const facts = [
  market.stallCount ? ['Stände', `~${market.stallCount}${market.stallCountBadWeather ? `, bei schlechtem Wetter ~${market.stallCountBadWeather}` : ''}`] : undefined,
  market.sellerMix ? ['Verkäufer', { private: 'nur Private', mixed: 'Private und Händler', trader: 'Händler', new_goods: 'Neuware' }[market.sellerMix]] : undefined,
  market.priceLevel ? ['Preisniveau', { cheap: 'günstig', flohmarkt: 'Flohmarkt', trader: 'Händler' }[market.priceLevel]] : undefined,
  // Say the exception, never the rule — docs/BRAND.md. 151 of 157 markets are
  // free, so "Eintritt: frei" separated nobody from anybody and stood alone
  // under a heading promising what to expect. A price shows when there is one.
  market.entryFee ? [s.entryLabel, `${market.entryFee} CHF`] : undefined,
  market.covered ? ['Gelände', { open: 'offen', partly: 'teilweise gedeckt', indoor: 'drinnen' }[market.covered]] : undefined,
  market.groundSurface ? ['Untergrund', market.groundSurface] : undefined,
].filter(Boolean) as [string, string][];

const facilityItems = market.facilities ? [
  market.facilities.wc !== undefined ? ['WC', market.facilities.wc ? 'ja' : 'nein'] : undefined,
  market.facilities.dogs !== undefined ? ['Hunde', market.facilities.dogs ? 'ja' : 'nein'] : undefined,
  market.facilities.strollers ? ['Kinderwagen', market.facilities.strollers] : undefined,
  market.facilities.food ? ['Essen', market.facilities.food] : undefined,
  market.facilities.cash ? ['Bargeld', market.facilities.cash] : undefined,
].filter(Boolean) as [string, string][] : [];
---
<Page
  locale={locale}
  alternates={alternates}
  title={`${market.name}, ${market.city} — ${s.dates} ${new Date().getFullYear()} | fynda.market`}
  description={`${kind.full[locale]}, ${market.city}. ${next ? s.cityNext(market.name, formatDate(next.date, locale), formatTimeRange(next.startTime, next.endTime, locale), market.venueName) : s.cityNoDate}`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  {/* One grid, so the width above 900px can put the actions beside the page
      instead of below it. The DOM order is the mobile order and the reading
      order both — hero, title, what to do, then the detail — so nothing is
      re-sequenced for sighted users only. */}
  <div class="market">
    <div class="photo-hero">
      <PhotoOrArt market={market} width={720} height={210} loading="eager" />
      {/* Filled, not white text laid over a photograph, where it was legible
          on a dark picture and invisible on a bright one. The fill is the
          kind's own line colour — docs/BRAND.md gives the line colours exactly
          one job, marking the type of market, and this is it. */}
      <span class="type eyebrow" style={`background: var(${kind.token})`}>
        <Icon name={kind.icon} size={14} />{kind.full[locale]}
      </span>
      {/* Saving and going are two different decisions. As a block button the
          same size as Route, Merken read as an equally large choice, which it
          is not — Route is 55% of every outbound click on the site. On the
          picture it is still in the first screen and never in the way. */}
      <Button
        class="save"
        data-save={market.slug}
        data-label-save={s.save}
        data-label-saved={s.savedState}
        aria-pressed="false"
      ><Icon name="bookmark" size={15} /><span data-save-label>{s.save}</span></Button>
    </div>

    <div class="head gutter">
      {/* Orientation before identity — PAGES.md has always said the page opens
          with kind and city, and only the kind was ever built. It is also the
          only way off this page that is not a link out of the site: the
          breadcrumb existed in the structured data and nowhere a person could
          see it. Parent links, not a related-market list. */}
      <p class="where">
        <a href={cityPath(locale, market.countrySlug, market.citySlug)}>{market.city}</a>
        <span aria-hidden="true">·</span>
        {/* "Kanton Genf", not "Genf": Genève, Luzern, Zürich, Bern and five
            more name both a city and its canton, so the bare pair read as the
            same word printed twice. The label string exists for this. */}
        <a href={regionPath(locale, market.countrySlug, market.regionSlug)}>{s.regionLabel(market.region)}</a>
      </p>
      <h1>{market.name}</h1>

      {next && (
        <div class:list={['status', { cancelled }]}>
          <p class="word">
            <strong>{statusWord}</strong>
            {/* Revealed by the script below, and only while the market is
                actually open. Hidden is the correct resting state: a static
                page written at 03:00 cannot claim anything about 14:00. */}
            {canBeLive && (
              <span
                class="live"
                data-live
                hidden
                data-start={liveStart}
                data-end={liveEnd}
                data-on-now={s.onRightNow}
                data-ends-in={s.endsInTemplate}
                data-ends-soon={s.endsSoon}
              ><i></i><b data-live-text></b></span>
            )}
          </p>
          {timeRange && (
            <p class="clock">{timeRange} {s.timeSuffix}<span data-ends hidden></span></p>
          )}
          {/* The single most useful thing we ever tell anyone, and the reason
              this site deserves to exist. It was held in the database and
              never rendered. */}
          {cancelled && next.cancellationNote && <p class="reason">{next.cancellationNote}</p>}
        </div>
      )}

      {market.packUpFrom && <p class="pack">{s.packUpFrom(market.packUpFrom)}</p>}

      {/* The decision strip. Every segment is computed from what we already
          hold, so it behaves identically for a market in Dortmund we have
          never seen. A segment renders when its value exists and is simply
          absent otherwise — never a dash, never "unbekannt".

          Distance is the third segment and is not here yet: it needs the
          visitor's own town, and `fynda:stadt` currently stores a name and a
          href without coordinates. The slot is left for it. */}
      <div class="strip">
        <ul class="list-reset">
          <li data-distance hidden><b data-distance-value></b><span data-distance-label></span></li>
          {market.recurrenceText && <li><b>{market.recurrenceText}</b><span>{s.howOften}</span></li>}
          {dates.length > 0 && <li><b>{dates.length}</b><span>{s.upcoming}</span></li>}
        </ul>
        <p class:list={['stamp', { organiser: next?.origin === 'organiser' }]}>
          {stampMain}{stampAlso ? ` · ${stampAlso}` : ''}
        </p>
      </div>
    </div>

    {/* Directions is 55% of all outbound clicks — PAGES.md puts it above the fold.
        The second button is the organiser's own page where we hold one, which is
        153 of 157 markets; it used to scroll down this page instead. */}
    <div class="side">
      <div class="actions gutter">
        <Button href={mapsUrl} variant="primary" block rel="noopener nofollow" target="_blank"><Icon name="map" size={18} />{s.route}</Button>
        {market.websiteUrl
          ? <Button href={market.websiteUrl} block rel="noopener nofollow" target="_blank">{s.organiserWebsite}</Button>
          : <Button href="#hinkommen" block>{s.organiser}</Button>}
      </div>

      {/* Both are retention, not decoration: a market in someone's calendar keeps
          being useful without them returning, and a saved market is what the
          Friday newsletter is eventually built on. Saving is localStorage only —
          no account, docs/PLAN.md.

          They share a row rather than stacking full-width under Route. Four block
          buttons of the same size made "Merken" look like as big a decision as
          getting there, which it is not — Route is 55% of all outbound clicks. */}
      <div class="keep gutter">
        <Button href={`/ics/${market.slug}.ics`} block><Icon name="check" size={16} />{s.addToCalendar}</Button>
      </div>
    </div>

    <div class="detail">
      {market.description && (
        <Section level="sub"><p class="blurb meta">{market.description}</p></Section>
      )}

      {facts.length > 0 && (
        <Section level="sub" title={s.whatToExpect}>
          <dl class="gutter">{facts.map(([term, value]) => <><dt>{term}</dt><dd>{value}</dd></>)}</dl>
        </Section>
      )}

      {market.timing && (
        <Section level="sub" title={s.whenToGo}>
          <div class="timing gutter">
            {market.timing.map((slot) => (
              <div><strong>{slot.from}</strong><span><b>{slot.label}</b>{slot.note && <em>{slot.note}</em>}</span></div>
            ))}
          </div>
        </Section>
      )}

      <Section level="sub" title={s.gettingThere} id="hinkommen">
        <p class="address gutter">
          <b>{market.venueName}</b>
          <span>{market.addressLine}</span>
          {showLocality && <span>{locality}</span>}
        </p>
        {market.gettingThere && <p class="getting gutter">{market.gettingThere}</p>}
        {facilityItems.length > 0 && (
          <div class="facilities gutter">{facilityItems.map(([label, value]) => <span class="chip">{label} <b>{value}</b></span>)}</div>
        )}
      </Section>

      {/* A market between seasons has no date to show, and 40 of 157 are in
          that state in September. The heading used to stand over an empty
          list; the rhythm is what we do know — "Einmal jährlich, zwischen
          April und Oktober" — and it is the honest answer to "when". */}
      <Section level="sub" title={s.dates}>
        {dates.length > 0 ? (
          <ul class="dates list-reset gutter">
            {dates.map((occurrence) => (
              <li class:list={{ cancelled: occurrence.status === 'cancelled' }}>
                <strong>{formatDate(occurrence.date, locale)}</strong>
                {formatTimeRange(occurrence.startTime, occurrence.endTime, locale) && <span>{formatTimeRange(occurrence.startTime, occurrence.endTime, locale)}</span>}
                {/* One row in the list can be today, and when it is, that is
                    the only thing in the list worth colouring. Everything else
                    says "Bestätigt", which is true of nearly every row and is
                    therefore furniture — docs/BRAND.md. */}
                {occurrence.date === today && occurrence.status !== 'cancelled'
                  ? <em class="is-today">{s.statusToday}</em>
                  : <em>{STATUS[locale][occurrence.status]}</em>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="gutter no-dates">
            <strong>{s.cityNoDate}</strong>
            {market.recurrenceText && <span>{market.recurrenceText}</span>}
          </p>
        )}
      </Section>

      {/* Who runs it. Held for 94% of markets and, until now, printed only
          into the structured data — a fact we had, that a person could not
          read. It sits above the claim card on purpose: naming the organiser
          and then saying nobody has taken this page over is the ask making its
          own case. */}
      {market.organiserName && (
        <p class="host gutter">{s.hostedBy(market.organiserName)}</p>
      )}

      {/* After the dates, not above them. An organiser looking their own market
          up will scroll; a visitor deciding whether to go should not have a
          supply ask standing between them and the date. Paper, not the dark
          card the mockup drew: on 128 pages it must not out-shout Route. */}
      {!claimed && (
        <div class="gutter"><CtaCard kind="claim" locale={locale} href={claimHref} variant="secondary" /></div>
      )}

      {/* The market page had no newsletter ask at all — only the claim card,
          which is addressed to an organiser rather than to the visitor. This is
          the page where somebody has already shown they care about one
          particular Saturday in one particular canton, so the canton is known
          and never asked for. On every market page, not only the unclaimed
          ones: the visitor is the customer either way. */}
      <div class="gutter"><SubscribeForm locale={locale} region={{ slug: market.regionSlug, label: s.regionLabel(market.region) }} /></div>

      <Section level="sub" title={s.wasItDifferent}>
        <p class="gutter meta">{s.reportIntro}</p>
        {/* The market travels with the report, as the name a person reads and as
            the id the database needs -- so a report from here arrives already
            attached to the right market rather than waiting for someone to
            match a typed name. Asking someone to retype the name of the page
            they are standing on is how a report form goes unused.

            `grund` is the value the reports table stores, not a key of our own
            mapped onto a position in the select. One vocabulary from the chip
            to the column. */}
        <div class="report gutter">
          {[['cancelled', s.reportDidNotHappen], ['wrong_date', s.reportEndedEarly], ['other', s.reportSomethingElse]].map(
            ([grund, label]) => (
              <a class="chip" href={`${utilityPath(locale, 'report')}?markt=${encodeURIComponent(market.name)}&grund=${grund}&mid=${market.id}`}>{label}</a>
            )
          )}
        </div>
      </Section>

      {/* The type legend used to close this page. It teaches a colour system
          for reading lists, and there is no list on the page of one market. */}
  </div>
</div>
</Page>

<style>
  /*
    Mobile: a plain column, and the gaps are the ones `main.stack` used to
    supply — this grid took its place as main's only child, so it owns them
    now. Above the breakpoint the same four blocks become two columns.
  */
  .market { display: grid; gap: var(--space-6); }
  .side { display: grid; gap: var(--space-6); }
  .detail { display: grid; gap: var(--space-6); }

  /* Running text stops at the reading measure whatever the column is doing.
     Unconditional, because the 720px layout was already setting it ~105
     characters wide, which is long past comfortable at this size. */
  .blurb { max-width: var(--measure); }

  .photo-hero { position: relative; height: var(--hero-height); overflow: hidden; background: var(--color-paper); }
  .type {
    position: absolute;
    inset-block-start: var(--space-hero);
    inset-inline-start: var(--space-hero);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--color-white);
  }

  /* The city and the canton, above the name. Quiet — they orient, they are not
     the point of the page — but they are links, and until now this page had
     none that stayed on the site. */
  .where {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-1);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
  }
  .where a { color: var(--color-grey); }
  .where > span { color: var(--color-line); }

  h1 { font-size: var(--text-market-name); letter-spacing: var(--tracking-tight); }

  .host { font-size: var(--text-small); color: var(--color-grey); }

  /*
    The status line. The one loud thing above the fold, and the only accented
    thing on the page — docs/BRAND.md lets the accent mark the date and whether
    it is happening, and nothing else.
  */
  .status { margin-block-start: var(--space-hero); }
  .word {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  .word > strong {
    color: var(--color-accent);
    font-size: var(--text-market-date);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-accent);
    font-size: var(--text-micro);
    font-weight: var(--weight-black);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }
  /* `hidden` is the resting state of both of these, and a display rule above
     would quietly beat the attribute. Keep these two next to the rules they
     undo. */
  .live[hidden] { display: none; }
  /* The dot takes its size from the space scale — it is a mark, not a control,
     so it has no size of its own to name. */
  .live i {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: currentColor;
  }
  .clock {
    margin-block-start: var(--space-half);
    font-size: var(--text-date);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
  }
  .clock span { color: var(--color-grey); font-weight: var(--weight-regular); }
  .reason {
    margin-block-start: var(--space-2);
    max-width: var(--measure);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
  }
  .status.cancelled > .word > strong {
    color: var(--color-quiet);
    text-decoration: line-through;
    text-decoration-color: var(--color-line);
  }
  .status.cancelled .clock { color: var(--color-quiet); }

  /*
    The decision strip. Everything in it is computed from what we already hold,
    a segment renders only when its value exists, and `auto-fit` means two
    segments fill the band as evenly as four — so a thin market reads as
    deliberate rather than broken.
  */
  .strip {
    margin-block-start: var(--space-4);
    max-width: var(--measure);
    border-block: var(--border-width) solid var(--color-line);
  }
  .strip ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--strip-column), 1fr));
    padding-block: var(--space-3);
  }
  .strip li {
    display: flex;
    flex-direction: column;
    gap: var(--space-half);
    min-width: 0;
    padding-inline: var(--space-3);
    border-inline-start: var(--border-width) solid var(--color-line);
  }
  .strip li[hidden] { display: none; }
  .strip li:first-child { padding-inline-start: 0; border-inline-start: 0; }
  .strip li b {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }
  .strip li span {
    color: var(--color-quiet);
    font-size: var(--text-tiny);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }
  /* The one line that never disappears. Where we hold no confirmation date it
     says so in words rather than going quiet — docs/PAGES.md. */
  .stamp {
    margin: 0;
    padding-block-end: var(--space-3);
    color: var(--color-quiet);
    font-size: var(--text-micro);
  }
  .stamp.organiser { color: var(--color-accent); font-weight: var(--weight-bold); }

  .pack { margin-block-start: var(--space-2); font-size: var(--text-small); font-weight: var(--weight-bold); }

  .actions { display: grid; gap: var(--space-2); }
  .keep :global(.button) { font-size: var(--text-micro); }

  /* Merken, on the picture. Top right, opposite the type badge. */
  .photo-hero :global(.save) {
    position: absolute;
    inset-block-start: var(--space-hero);
    inset-inline-end: var(--space-hero);
    gap: var(--space-1);
    min-height: 0;
    padding: var(--space-1) var(--space-3);
    background: var(--color-white);
    font-size: var(--text-micro);
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-hero);
    margin: 0;
    font-size: var(--text-small);
  }
  dt { color: var(--color-grey); }
  dd { margin: 0; text-align: end; font-weight: var(--weight-bold); }

  .timing > div {
    display: grid;
    grid-template-columns: var(--row-time) 1fr;
    gap: var(--space-row);
    padding-block: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .timing > div:last-child { border-block-end: 0; }
  .timing > div > strong { color: var(--color-quiet); font-size: var(--text-micro); font-weight: var(--weight-black); }
  .timing b, .timing em { display: block; font-size: var(--text-small); }
  .timing em { margin-block-start: var(--space-half); color: var(--color-grey); font-style: normal; }

  .address { display: grid; font-size: var(--text-small); line-height: var(--leading-body); }
  .address b { font-weight: var(--weight-black); }
  .address span { color: var(--color-grey); }
  .getting { margin-block-start: var(--space-2); font-size: var(--text-small); }

  .facilities, .report { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .facilities { margin-block-start: var(--space-3); }
  .chip {
    padding: var(--space-1) var(--space-row);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-photo);
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
  }
  .facilities b { font-weight: var(--weight-black); }

  .dates li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
    font-size: var(--text-small);
  }
  .dates li > strong { font-weight: var(--weight-bold); }
  .dates li > span { color: var(--color-grey); }
  .dates li > em { color: var(--color-quiet); font-size: var(--text-micro); font-style: normal; font-weight: var(--weight-bold); }
  /* The accent marks the date and whether it is happening — this is the second
     of those, and the only row in the list that earns it. */
  .dates li > em.is-today { color: var(--color-accent); }
  .no-dates { display: flex; flex-direction: column; gap: var(--space-half); max-width: var(--measure); }
  .no-dates > strong { font-weight: var(--weight-bold); }
  .no-dates > span { color: var(--color-grey); }
  .dates li.cancelled > strong, .dates li.cancelled > span {
    color: var(--color-quiet);
    text-decoration: line-through;
    text-decoration-color: var(--color-line);
  }
  .report { margin-block-start: var(--space-3); }

  /*
    The change worth the most on this page. Route is 55% of every outbound
    click on the site and it sat 859px down — below the fold, behind the whole
    date list. Here it is a rail beside the page that never leaves the screen.

    `align-self: start` shrinks the rail to its own height while its grid area
    stays the full height of the page, which is the box sticky then travels
    inside. Keep in step with --breakpoint-wide; a media query cannot read a
    token.
  */
  @media (min-width: 900px) {
    .market {
      grid-template-columns: minmax(0, 1fr) var(--side-column);
      grid-template-areas:
        "hero   side"
        "head   side"
        "detail side";
      column-gap: var(--space-7);
      align-items: start;
    }
    .photo-hero {
      grid-area: hero;
      height: var(--hero-height-wide);
      margin-inline: var(--space-page);
      border-radius: var(--radius-md);
    }
    .head { grid-area: head; }
    .detail { grid-area: detail; }
    /*
      Two- and three-column blocks push their last column to the right edge, so
      a wider container buys nothing but a longer gap between a label and its
      value. They stop where the text does.
    */
    .dates, .timing, dl { max-width: var(--measure); }
    .side {
      grid-area: side;
      position: sticky;
      inset-block-start: var(--space-4);
      align-self: start;
      gap: var(--space-3);
      margin-inline-end: var(--space-page);
      padding-block: var(--space-4);
      border: var(--border-width) solid var(--color-line);
      border-radius: var(--radius-md);
    }
  }
</style>

<script>
  /**
   * Saved markets live in the visitor's own browser. No account, no server, and
   * nothing to leak — docs/PLAN.md settled "saved markets, no accounts". The
   * /de/gemerkt/ page reads the same key.
   */
  const KEY = 'fynda:gemerkt';
  const read = (): string[] => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; }
  };

  const button = document.querySelector<HTMLButtonElement>('[data-save]');
  const slug = button?.dataset.save;

  if (button && slug) {
    // Write into the label, not the button: setting textContent on the button
    // deleted the bookmark icon on first paint, so the icon never survived to
    // be seen.
    const label = button.querySelector<HTMLElement>('[data-save-label]');
    const paint = (saved: boolean) => {
      button.setAttribute('aria-pressed', String(saved));
      if (label) label.textContent = saved ? (button.dataset.labelSaved ?? '') : (button.dataset.labelSave ?? '');
    };
    paint(read().includes(slug));

    button.addEventListener('click', () => {
      const saved = read();
      const next = saved.includes(slug) ? saved.filter((s) => s !== slug) : [...saved, slug];
      try { localStorage.setItem(KEY, JSON.stringify(next)); } catch { /* private mode */ }
      paint(next.includes(slug));
    });
  }

  /**
   * "Läuft gerade", and how long is left.
   *
   * The page is written by a build that runs at 03:00, so it can say which day
   * a market is on and nothing about the hour. This is the other half, and it
   * is strictly additive: with no JavaScript the page still says "Heute" and
   * the opening times, which is the whole answer minus one detail.
   */
  const live = document.querySelector<HTMLElement>('[data-live]');
  const startsAt = live?.dataset.start ? new Date(live.dataset.start) : undefined;
  const endsAt = live?.dataset.end ? new Date(live.dataset.end) : undefined;

  if (live && startsAt && endsAt && !Number.isNaN(startsAt.valueOf()) && !Number.isNaN(endsAt.valueOf())) {
    const now = Date.now();
    if (now >= startsAt.valueOf() && now < endsAt.valueOf()) {
      const text = live.querySelector<HTMLElement>('[data-live-text]');
      if (text) text.textContent = live.dataset.onNow ?? '';
      live.hidden = false;

      // Round up, so the last stretch reads "1 Std." rather than "0 Std.".
      const hours = Math.ceil((endsAt.valueOf() - now) / 3_600_000);
      const ends = document.querySelector<HTMLElement>('[data-ends]');
      if (ends) {
        ends.textContent = ` · ${hours <= 1
          ? live.dataset.endsSoon ?? ''
          : (live.dataset.endsIn ?? '').replace('{h}', String(hours))}`;
        ends.hidden = false;
      }
    }
  }
</script>
