---
/**
 * The four utility pages, in every language — `/de/melden/`, `/fr/signaler/`,
 * `/it/salvati/`, `/en/newsletter/` and the rest.
 *
 * One route rather than four files times four locales. The three form pages are
 * the same page with different words, so they are rendered from the data in
 * lib/utility-copy.ts; "saved" is genuinely different and gets its own branch.
 *
 * The mailto serialiser is shared too. It used to be written out three times,
 * once per page, each walking its own list of field names — so adding a field
 * meant remembering to add it in two places. It now walks the form.
 *
 * The four legal documents — about, imprint, privacy, terms — are the third
 * branch. They are prose with headings and lists and nothing else, so they are
 * rendered from lib/legal/ rather than from sixteen .astro files.
 */
import Page from '../../layouts/Page.astro';
import Button from '../../components/Button.astro';
import Field from '../../components/Field.astro';
import MarketRow from '../../components/MarketRow.astro';
import Section from '../../components/Section.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import { regionOptions } from '../../lib/regions';
import { getMarkets } from '../../lib/markets';
import { byMarket, datedRows, type Dated } from '../../lib/lists';
import { FORMS, SAVED, type FormKey } from '../../lib/utility-copy';
import { LEGAL, LEGAL_KEYS, type LegalKey } from '../../lib/legal';
import {
  INDEXED_UTILITY, UTILITY, UTILITY_LOCALES, homePath, marketPrefix, utilityAlternates,
  type Locale, type UtilityKey,
} from '../../lib/i18n';
import { t } from '../../lib/strings';

/** Every key this route owns — which, since the legal pages moved in, is all of
    them except the radius view. */
const KEYS = [
  'report', 'newsletter', 'organiser', 'saved',
  'about', 'imprint', 'privacy', 'terms',
] as const satisfies readonly UtilityKey[];

export async function getStaticPaths() {
  const keys = [
    'report', 'newsletter', 'organiser', 'saved',
    'about', 'imprint', 'privacy', 'terms',
  ] as const;
  return keys.flatMap((key) =>
    UTILITY_LOCALES[key].map((locale) => ({
      params: { locale, utility: UTILITY[key][locale] },
      props: { locale, key },
    }))
  );
}

const { locale, key } = Astro.props as { locale: Locale; key: (typeof KEYS)[number] };
const s = t(locale);
const alternates = utilityAlternates(key);

/* The saved page renders every market and lets the browser hide the ones that
   were not saved — see the note in the script below. Only it needs the data.
   One row per market: you save a market, not a date. */
let list: Dated[] = [];
if (key === 'saved') {
  list = byMarket(datedRows(await getMarkets(locale)));
}

/**
 * Where each form posts.
 *
 * One endpoint per form rather than one endpoint with a `kind` field: they
 * validate different things, write to different tables and answer differently,
 * and a single handler branching on a posted string is how one form's bug
 * becomes all three. Single letters because these are not pages — /n, /u and
 * /e were already this shape.
 */
const ENDPOINT: Record<FormKey, string> = {
  newsletter: '/n',
  report: '/r',
  organiser: '/o',
};

/* The newsletter page is the one signup a person arrives at on purpose, and
   it is the one page with no canton of its own — so it draws the picker. */
const cantons = key === 'newsletter' ? await regionOptions(locale) : [];

const legal = LEGAL_KEYS.includes(key as LegalKey) ? LEGAL[key as LegalKey][locale] : null;
const form = legal || key === 'saved' ? null : FORMS[key as FormKey][locale];
const saved = key === 'saved' ? SAVED[locale] : null;
const copy = form ?? saved ?? legal!;

/**
 * What the saved page's summary needs, as data on the element rather than as an
 * import in the browser: importing strings.ts would ship all four languages'
 * interface copy to a page that only ever speaks one. `marketCount` is
 * "<n> <noun>" in every locale, so the noun is what is left once the number is
 * taken off the front.
 */
const savedCopy = saved && {
  summary: saved.summary,
  one: s.marketCount(1).replace(/^1\s*/, ''),
  other: s.marketCount(2).replace(/^2\s*/, ''),
};
---
<Page
  locale={locale}
  alternates={alternates}
  title={copy.title}
  description={copy.description}
  indexable={INDEXED_UTILITY.includes(key)}
>
  {form && (
    <>
      <section class="page-head gutter">
        <h1>{form.heading}</h1>
        <p class="answer">{form.answer}</p>
      </section>

      {/* The three answers a form can get, all in the page and all hidden until
          one of them applies. The script reveals one by class; a form the
          browser posted itself arrives back at `#form-done` and CSS `:target`
          reveals it with no script at all. Either way the words are the page's
          own language and are written in exactly one place.

          One set of ids for all three forms, because only one form is ever on a
          page. They used to be `#signup-*`, which would have meant a second
          vocabulary the moment the report form got the same treatment. */}
      <div class="gutter">
        <p class="result answer" id="form-done">{form.success}</p>
        <p class="result answer" id="form-invalid">{form.errors?.invalid}</p>
        <p class="result answer" id="form-failed">{form.errors?.failed}</p>
      </div>

      {/* The newsletter page uses the same block as every other page, rather
          than a form of its own. There was no reason for two: this one just
          happens to be the page somebody arrives at on purpose, so it is the
          one that draws the canton picker instead of carrying a canton. */}
      {key === 'newsletter' && (
        <div class="gutter"><SubscribeForm locale={locale} options={cantons} /></div>
      )}

      {/* Above the prose, not below it. On a phone the first field used to sit
          750px down, behind ninety words nobody had asked for. The explanation
          is still here for whoever wants it — underneath, where an explanation
          belongs. */}
      {key !== 'newsletter' && (
      <form
        class="stack gutter"
        data-mail
        action={ENDPOINT[key as FormKey]}
        method="post"
        data-subject={form.subject}
        data-endpoint={ENDPOINT[key as FormKey]}
        data-errors={JSON.stringify(form.errors ?? {})}
      >
        {/* What the endpoint needs from a post the browser made on its own:
            which page it came from, which fixes the language and where to send
            the visitor back to. The script sends the same field in its JSON.

            `mid` is the market this is about, and it is empty in the HTML on
            purpose: these pages are static files shared by every visitor, so
            the market can only come from the query string the market page put
            it in. The script fills it; a visitor with no script posts without
            it and the row is saved with the market they typed instead. */}
        <input type="hidden" name="path" value={Astro.url.pathname} />
        <input type="hidden" name="mid" value="" />

        {form.fields.map((field) => (
          <Field
            label={field.label}
            name={field.name}
            type={field.type}
            hint={field.hint}
            required={field.required}
            placeholder={field.placeholder}
            options={field.options}
          />
        ))}

        {/* The honeypot, on every form now that every form writes a row.
            Hidden from people and from screen readers, so anything in it came
            from a bot. Not `display:none` alone — some bots skip those — but
            off-screen and untabbable as well. */}
        <div class="trap" aria-hidden="true">
          <label for="f-website">Website</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <Button type="submit" variant="primary" block>{form.submit}</Button>
        <p class="meta">{form.note}</p>
      </form>
      )}

      <div class="prose gutter">
        {form.prose.map((paragraph) => <p>{paragraph}</p>)}
        {form.listTitle && <h2>{form.listTitle}</h2>}
        {form.list && <ul>{form.list.map((item) => <li>{item}</li>)}</ul>}
        {form.after && <p>{form.after}</p>}
      </div>
    </>
  )}

  {legal && (
    <div class="prose gutter">
      <h1>{legal.heading}</h1>
      {legal.effective && <p class="meta effective">{legal.effective}</p>}
      {legal.lede?.map((paragraph) => <p>{paragraph}</p>)}
      {legal.blocks.map((block) => (
        <>
          {block.h && <h2>{block.h}</h2>}
          {block.p?.map((paragraph) => <p>{paragraph}</p>)}
          {block.ul && <ul>{block.ul.map((item) => <li>{item}</li>)}</ul>}
        </>
      ))}
    </div>
  )}

  {saved && (
    <>
      <section class="page-head gutter">
        <h1>{saved.heading}</h1>
        <p class="answer" id="summary" data-none={saved.none} data-copy={JSON.stringify(savedCopy)}>{saved.none}</p>
        <p class="meta">{saved.note}</p>
      </section>

      <Section>
        <div id="list" data-market-prefix={marketPrefix(locale)}>
          {list.map((market) => <MarketRow market={market} locale={locale} showRhythm />)}
        </div>
        <p id="empty" class="gutter meta">{saved.empty}</p>
        <div class="find gutter"><Button href={homePath(locale)} block>{saved.browse}</Button></div>
      </Section>
    </>
  )}
</Page>

<style>
  .find { margin-block-start: var(--space-4); }

  /* The three signup answers. One of them is revealed either by the script or,
     when there is none, by the fragment the endpoint redirects to — `:target`
     is what makes the form work with JavaScript switched off. */
  .result { display: none; }
  .result.shown,
  .result:target { display: block; }

  /* Off-screen rather than display:none — a bot that skips hidden fields still
     fills this one in, and a person never sees it or tabs to it. Taken out of
     flow, so it needs no size of its own. */
  .trap {
    position: absolute;
    inset-inline-start: -9999px;
  }

  /* The operator's name, town and address are one paragraph with line breaks in
     it — a block of three <p> would be read as three separate statements. */
  .prose p { white-space: pre-line; }
  .effective { margin-block-start: calc(var(--space-2) * -1); }
</style>

<script>
  /**
   * The three forms, one script.
   *
   * Each posts to its own endpoint — /n the newsletter, /r a report, /o an
   * organiser claim — and the page says what happened without leaving. All of
   * this is an enhancement: the form carries `action` and `method` in the HTML,
   * so with no JavaScript the browser posts it itself and the endpoint answers
   * with a redirect to `#form-done`, which CSS `:target` reveals. Nothing here
   * is load-bearing.
   *
   * The mailto serialiser stays as the last resort, after a second failure that
   * was ours. It walks the form rather than a hand-written list of field names,
   * so the labels are whatever the page's own language calls them.
   */
  import { CONTACT } from '../../lib/utility-copy';

  const form = document.querySelector<HTMLFormElement>('form[data-mail]');

  if (form) {
    const endpoint = form.dataset.endpoint ?? null;
    const subscribe = form.hasAttribute('data-subscribe');
    const errors = JSON.parse(form.dataset.errors ?? '{}') as Partial<
      Record<'empty' | 'invalid' | 'failed' | 'offline', string>
    >;

    /**
     * The market page sends the market with the visitor:
     * /fr/signaler/?markt=…&grund=…&mid=… — someone who has just found a closed
     * gate should not have to retype the name of the page they came from.
     *
     * `grund` is now the same key the database stores and the select posts, so
     * setting the control is one assignment. It used to be a made-up key mapped
     * onto a position in the options list, which meant reordering the options
     * silently changed what a report meant.
     *
     * `mid` is the market's id. It is what lets a report attach itself to the
     * right market instead of waiting for someone to match a typed name, and it
     * is checked at the endpoint rather than trusted — it arrives in a query
     * string anyone can edit.
     */
    const params = new URLSearchParams(location.search);
    const fill = (name: string, value: string | null) => {
      const field = form.elements.namedItem(name) as
        | HTMLInputElement
        | HTMLSelectElement
        | null;
      if (field && value) field.value = value;
    };

    fill('markt', params.get('markt'));
    // The claim card on a market page sends the town as well, so an organiser
    // arrives at a form with the two identifying fields already filled and only
    // their own name and address left to add.
    fill('ort', params.get('ort'));
    fill('mid', params.get('mid'));

    const reason = params.get('grund');
    const reasonField = form.elements.namedItem('grund') as HTMLSelectElement | null;
    if (reason && reasonField) {
      // Only if the select actually offers it. A hand-edited query string must
      // not be able to put a value the endpoint would reject into the control.
      const offered = Array.from(reasonField.options).some((o) => o.value === reason);
      if (offered) reasonField.value = reason;
    }

    /**
     * Milliseconds from the first touch of the form, not from page load.
     *
     * The endpoint uses it to throw away a fill no person could have typed. It
     * used to be measured from page load against a three-second floor, which
     * was harmless only because the form sat 750px down: reaching it took
     * longer than the limit. Now that the form is at the top, that same floor
     * would start catching real people — and it answers with a success, so
     * they would be told something was saved that never was.
     *
     * Stays zero when nobody ever touched the form — an address filled in by a
     * password manager can involve no focus and no keystroke — and the
     * endpoint then skips the check rather than guessing.
     */
    let firstTouch = 0;
    const touched = () => { if (!firstTouch) firstTouch = Date.now(); };
    form.addEventListener('focusin', touched);
    form.addEventListener('input', touched);

    const emailField = form.elements.namedItem('email') as HTMLInputElement | null;
    const emailError = document.getElementById('f-email-error');

    /*
     * The newsletter is the only form whose validation we take over, and it is
     * turned off here rather than in the markup, which is the whole point: with
     * no script the browser's own `required` and `type="email"` checks are the
     * only ones there are and must keep working.
     *
     * The other two keep the browser's checking. Their required fields are
     * ordinary text fields where the browser's own "please fill in this field"
     * is both correct and in the reader's language, and interrupting a report
     * about a market that did not happen to argue about form validation is the
     * wrong thing to spend a person's patience on. Where we do have something
     * better to say — a mistyped address, a save that failed — we say it below.
     */
    if (subscribe) form.noValidate = true;

    /* Loose on purpose. This decides whether to interrupt someone, so it may
       only reject what is certainly wrong; the endpoint is the real check. */
    const looksLikeAddress = (value: string) => /^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(value);

    function showError(message: string) {
      if (!emailError || !emailField) return;
      emailError.textContent = message;
      emailError.hidden = false;
      emailField.setAttribute('aria-invalid', 'true');
      emailField.focus();
    }

    function clearError() {
      if (!emailError || !emailField) return;
      emailError.hidden = true;
      emailError.textContent = '';
      emailField.removeAttribute('aria-invalid');
    }

    /* Checked when they leave the field, never while they are still typing:
       an address is invalid for as long as it takes to type one, and saying so
       at the third character is nagging rather than helping. Correcting it
       clears the message immediately.

       On every form that has an address field, including the two where it is
       optional — a report with a mistyped address is a reply that never
       arrives, which is worse than no address at all. */
    if (emailField) {
      emailField.addEventListener('blur', () => {
        const value = emailField.value.trim();
        if (value && !looksLikeAddress(value)) {
          if (emailError) {
            emailError.textContent = errors.invalid ?? '';
            emailError.hidden = false;
          }
          emailField.setAttribute('aria-invalid', 'true');
        } else {
          clearError();
        }
      });
      emailField.addEventListener('input', clearError);
    }

    type Outcome = 'ok' | 'invalid' | 'failed' | 'offline';

    /**
     * Everything the visitor typed, as JSON, plus the two things the page knows
     * and they do not: how long they took, and which page this is.
     *
     * Built from the form's own controls rather than from a list of field names
     * per form. Three forms with three hand-written payloads is three places to
     * forget a field the day one is added.
     */
    async function send(): Promise<Outcome> {
      const payload: Record<string, unknown> = {
        elapsed_ms: firstTouch ? Date.now() - firstTouch : null,
        path: location.pathname,
      };

      for (const element of Array.from(form!.elements)) {
        const control = element as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
        if (!control.name || control.name === 'path') continue;
        payload[control.name] = String(control.value ?? '').trim();
      }

      let res: Response;
      try {
        res = await fetch(endpoint!, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        });
      } catch {
        // The request never left the device.
        return 'offline';
      }

      if (res.ok) return 'ok';
      return res.status === 422 ? 'invalid' : 'failed';
    }

    /* Counts only the failures that were ours. A typo is not an attempt. */
    let failures = 0;

    form.addEventListener('submit', (event) => {
      /* No endpoint means no script-driven submit: let the browser do whatever
         the markup says, which for a form with no action is nothing at all. */
      if (!endpoint) return;
      event.preventDefault();

      /* The newsletter checks its one field itself. The other two have already
         been checked by the browser, which will not have let a submit event
         reach here with a required field empty. */
      if (subscribe) {
        const value = emailField?.value.trim() ?? '';
        if (!value) { showError(errors.empty ?? ''); return; }
        if (!looksLikeAddress(value)) { showError(errors.invalid ?? ''); return; }
      } else if (emailField) {
        /* Optional on these two, so an empty one is fine and a wrong one is
           not: it is the address a reply would go to. */
        const value = emailField.value.trim();
        if (value && !looksLikeAddress(value)) { showError(errors.invalid ?? ''); return; }
      }

      clearError();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;

      void send().then((outcome) => {
        if (button) button.disabled = false;

        if (outcome === 'ok') {
          form.hidden = true;
          const done = document.getElementById('form-done');
          if (done) {
            done.classList.add('shown');
            done.setAttribute('tabindex', '-1');
            done.focus();
          }
          return;
        }

        if (outcome === 'invalid') { showError(errors.invalid ?? ''); return; }

        /*
         * The mail program is the last resort, not the first thing that happens.
         * It used to open the moment anything went wrong, including a mistyped
         * address — so the one problem the visitor could have fixed themselves
         * was the one the page never mentioned. It opens only after a real retry
         * of a failure that was ours, and it is why every one of these forms
         * still carries a mailto subject.
         */
        failures += 1;
        if (failures >= 2) { sendByMail(form as HTMLFormElement); return; }

        showError(outcome === 'offline' ? errors.offline ?? '' : errors.failed ?? '');
      });
    });

    /* Takes the form rather than closing over it: a function declaration outlives
       the `if (form)` that narrowed it away from null. */
    function sendByMail(form: HTMLFormElement) {
      const lines: string[] = [];
      let subject = form.dataset.subject ?? 'fynda.market';

      for (const element of Array.from(form.elements)) {
        const control = element as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
        if (!control.name) continue;
        // The page path, the market id and the consent wording are for the
        // endpoint, not for a person reading the mail this builds.
        if (control.type === 'hidden') continue;
        const value = String(control.value ?? '').trim();
        if (!value) continue;
        const label = form.querySelector(`label[for="f-${control.name}"] > span`)?.textContent ?? control.name;
        lines.push(`${label}: ${value}`);
        if (control.name === 'markt') subject = `${subject}: ${value}`;
      }

      location.href = `mailto:${CONTACT}`
        + `?subject=${encodeURIComponent(subject)}`
        + `&body=${encodeURIComponent(lines.join('\n'))}`;
    }
  }
</script>

<script>
  /**
   * Saved markets. No accounts, ever (docs/PLAN.md): the list lives in this
   * browser under one localStorage key, which the market page's save button
   * writes.
   *
   * Every market with an upcoming date is in the HTML and the browser hides the
   * ones that were not saved. That sounds wasteful and is not — it is the same
   * payload the home page already ships, it needs no server, and the page is
   * noindex because its content differs for every visitor.
   */
  const list = document.getElementById('list');
  const summary = document.getElementById('summary');

  if (list && summary) {
    const KEY = 'fynda:gemerkt';
    const stored = (() => {
      try { return new Set<string>(JSON.parse(localStorage.getItem(KEY) ?? '[]')); }
      catch { return new Set<string>(); }
    })();

    // A row's only link is its market page, and the prefix is in the markup so
    // this does not have to know that French says /fr/marche/.
    const prefix = list.dataset.marketPrefix ?? '/';
    const empty = document.getElementById('empty');
    const slugs = new Set<string>();
    /* One row per market, so the row count is the market count. The dates it
       stands for ride along on the row — see MarketRow's data-dates. */
    let dates = 0;

    for (const row of Array.from(list.querySelectorAll<HTMLElement>('[data-date]'))) {
      const href = row.querySelector<HTMLAnchorElement>(`a[href^="${prefix}"]`)?.getAttribute('href') ?? '';
      const slug = href.split('/').filter(Boolean).at(-1) ?? '';
      const keep = stored.has(slug);
      row.hidden = !keep;
      if (keep) { slugs.add(slug); dates += Number(row.dataset.dates ?? 1); }
    }

    const shown = slugs.size;
    if (empty) empty.hidden = shown > 0;
    const copy = JSON.parse(summary.dataset.copy ?? '{}') as
      { summary?: string; one?: string; other?: string };
    summary.textContent = shown === 0
      ? (summary.dataset.none ?? '')
      : (copy.summary ?? '')
          .replace('{markets}', `${slugs.size} ${slugs.size === 1 ? copy.one : copy.other}`)
          .replace('{dates}', String(dates));
  }
</script>
