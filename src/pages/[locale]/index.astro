---
/**
 * Home — the long version, in the block order PAGES.md decided on 2026-08-30.
 *
 * The page is markup and data. Every visual decision below belongs to a
 * component or to styles/base.css; what is left here is the order of the
 * blocks and the rules that pick what goes in them.
 */
import Page from '../../layouts/Page.astro';
import Button from '../../components/Button.astro';
import Faq from '../../components/Faq.astro';
import CtaCard from '../../components/CtaCard.astro';
import PlaceCloud from '../../components/PlaceCloud.astro';
import MarketRow from '../../components/MarketRow.astro';
import PillList from '../../components/PillList.astro';
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';
import TownShortcut from '../../components/TownShortcut.astro';
import TypeGrid from '../../components/TypeGrid.astro';
import { getMarkets } from '../../lib/markets';
import DateFilters from '../../components/DateFilters.astro';
import { datedRows, weekendLead } from '../../lib/lists';
import { formatDateShort } from '../../lib/format';
import { LOCALES, cityPath, countryPath, homePath, marketPath, nearbyPath, regionPath } from '../../lib/i18n';
import { t } from '../../lib/strings';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale, alternates: LOCALES.map((l) => ({ locale: l, path: homePath(l) })) },
  }));
}

const { locale, alternates } = Astro.props;
const s = t(locale);
const markets = await getMarkets(locale);
const rows = datedRows(markets);

/**
 * The home page answers one question — what is on this weekend — and then asks
 * one back: where are you.
 *
 * It shows six markets, not all of them. A nationwide list is useless to any
 * one person: sorted by clock time it interleaved 22 cities at random, and
 * someone in Zürich had to read forty-five rows to find four. Six is a taste,
 * one per town so it reads as a country rather than as one city's diary, and
 * the picker underneath is the way out of it. `src/lib/lists.ts`.
 */
const { lead, rest, more, total, from, to } = weekendLead(rows, 6);

/** The radius view offers these four; the home form has to offer the same. */
const RADII = [10, 25, 50, 100];
const cities = [...new Map(markets.map((m) => [m.citySlug, m.city]))].sort((a, b) => a[1].localeCompare(b[1], locale));
const regions = [...new Map(markets.map((m) => [m.regionSlug, m.region]))].sort((a, b) => a[1].localeCompare(b[1], locale));
const countrySlug = markets[0]?.countrySlug ?? 'schweiz';

/**
 * Cancellations in the coming week. Nobody else in the category surfaces these
 * where people look. The block renders only when there is something in it,
 * which is what stops the order below filling with empty furniture.
 */
const inAWeek = (() => { const d = new Date(); d.setDate(d.getDate() + 7); return d.toISOString().slice(0, 10); })();
const cancelled = rows
  .filter((row) => row.next!.status === 'cancelled' && row.next!.date <= inAWeek)
  .sort((a, b) => a.next!.date.localeCompare(b.next!.date));

const site = 'https://fynda.market';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'fynda.market', inLanguage: 'de-CH', description: 'Flohmärkte in der Schweiz, mit Daten die stimmen.' },
    { '@type': 'Organization', '@id': `${site}/#organisation`, name: 'fynda.market', url: `${site}/` },
  ],
};

---
<Page locale={locale} alternates={alternates} title={s.homeTitle} description={s.homeDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  {/* The claim, and it is a number: the trust signal, the content that has to
      rank for the head term, and the sentence an AI answer can quote — one
      line doing three jobs. It comes before anything is asked of anyone.

      The three-field search card that used to sit here is gone. It stood
      between a visitor and the goods, and it is the shape of the one
      competitor in the category whose home page shows no markets at all.
      Choosing a place now happens below, once there is something to choose
      about — components/TownPicker.astro. */}
  <section class="page-head home-head gutter">
    <h1>{s.heroLine1}<br />{s.heroLine2}</h1>
    {/* The claim and the proof are one thought, so they move as one: under the
        headline on a phone, beside it on a desk. The wrapper exists for that
        and for nothing else. */}
    <div class="says">
      <p class="promise" set:html={s.homePromise(markets.length)}></p>
      <p class="meta">{s.homeProof}</p>
    </div>
  </section>

  {/* Empty until the browser says otherwise; see components/TownShortcut.
      The inset is the page's to give — a component that carried its own would
      force every other parent to cancel it (guardrail 7c). It matches the
      search card below, so the two read as one stack rather than two widths. */}
  <div class="shortcut-slot"><TownShortcut locale={locale} /></div>

  {/* Place, period, radius. Free text is deliberately absent — a search box
      needs the German text-search decision PLAN.md still has open, and a box
      that finds nothing is worse than no box.

      This is also the site's only place-chooser. A separate row of town
      buttons lived below the markets for a day; two ways to pick a town on
      one page is the incoherence this page is supposed to be free of, and
      the select already holds all 55. Choosing here is what the return-visit
      shortcut above remembers. */}
  <form class="search" action={nearbyPath(locale)} method="get" data-city-base={countryPath(locale, countrySlug)}>
    <label class="field">
      <span>{s.controlPlace}</span>
      <select name="ort">
        <option value="">{s.controlAnywhere}</option>
        {cities.map(([slug, city]) => <option value={slug}>{city}</option>)}
      </select>
    </label>
    {/* The same control every list page uses — chips plus a calendar of the
        days that actually have markets. It used to be a three-option select
        here, so the home page offered less than the page it sent you to, and
        "a specific day" was answerable everywhere except where people start.
        It is a row of chips, so it takes the full width rather than half of a
        pair. The hidden input is what the form submits; the buttons set it. */}
    <div class="field when">
      <span>{s.controlPeriod}</span>
      <DateFilters locale={locale} dates={rows.map((row) => row.next!.date)} />
    </div>
    <input type="hidden" name="zeit" value="all" />
    <label class="field">
      <span>{s.controlRadius}</span>
      <select name="km">{RADII.map((km) => <option value={km} selected={km === 50}>{km} km</option>)}</select>
    </label>
    <Button type="submit" variant="primary" block><Icon name="search" size={18} />{s.controlSubmit}</Button>
  </form>

  {/* Two at full size, then four compact. A block with one size in it has no
      rhythm, and rhythm is most of what stops a list reading as a database
      dump. The picture is the argument — a flea market is stuff you can see. */}
  {total > 0 && (
    <Section title={s.thisWeekend} lede={s.thisWeekendLede(total, formatDateShort(from, locale), formatDateShort(to, locale))}>
      <div class="leads gutter">
        {lead.map((market) => <MarketRow market={market} locale={locale} variant="feature" />)}
      </div>
      <div class="gutter">
        {rest.map((market) => <MarketRow market={market} locale={locale} />)}
      </div>
      {/* Opens in place. It used to link to /umkreis/, which is the radius
          view and holds a different list — a button that says "all 38" and
          then shows something else is worse than no button. */}
      {more.length > 0 && (
        <>
          <div id="rest-of-weekend" hidden>
            {more.map((market) => <MarketRow market={market} locale={locale} />)}
          </div>
          <div class="gutter more">
            <Button variant="quiet" data-expand aria-controls="rest-of-weekend" aria-expanded="false">{s.allWeekend(total)}</Button>
          </div>
        </>
      )}
    </Section>
  )}


  {/* Two full-width black buttons stacked one above the other were two equally
      loud asks, and two equally loud asks are neither. Side by side above
      900px, and only the first is filled — CtaCard takes `variant`. */}
  <div class="asks gutter">
    <CtaCard kind="newsletter" locale={locale} />
    <CtaCard kind="organiser" locale={locale} variant="secondary" />
  </div>

  {cancelled.length > 0 && (
    <Section title={s.cancelledThisWeek}>
      <ul class="calloffs list-reset gutter">
        {cancelled.map((row) => (
          <li>
            <a href={marketPath(locale, row.slug)}>{row.name}</a>
            <span class="meta">{formatDateShort(row.next!.date, locale)} · {row.city}</span>
            {row.next!.cancellationNote && <em class="meta-quiet">{row.next!.cancellationNote}</em>}
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section id="staedte" title={s.cities} lede={s.citiesLede}>
    <PlaceCloud items={cities.map(([slug, city]) => ({
      href: cityPath(locale, countrySlug, slug),
      label: city,
      count: markets.filter((m) => m.citySlug === slug).length,
    }))} />
  </Section>

  <Section id="kantone" title={s.regions} lede={s.regionsLede}>
    <PillList items={regions.map(([slug, region]) => ({
      href: regionPath(locale, countrySlug, slug),
      label: region,
      meta: String(markets.filter((m) => m.regionSlug === slug).length),
    }))} />
  </Section>

  <Section title={s.marketTypes} lede={s.typesLede}><TypeGrid locale={locale} /></Section>

  {/* "Termine prüfen · Quelle festhalten · Absagen sichtbar machen" was three
      verbs and no content, in the one block that says why this site is not the
      rest of the category. It is a sentence with the figure in it now. */}
  <Section title={s.whereDataComes}>
    <p class="proof gutter">{s.dataProvenance(rows.length)}</p>
    <p class="gutter meta counts">{s.marketCount(markets.length)} · {s.dateCount(rows.length)} · {cities.length} {s.cities} · {regions.length} {s.regions}</p>
  </Section>

  {/* Four answers, written per language like the rest of strings.ts — short,
      factual, and about the one thing that makes this site different: whether
      the date is true. Also the block AI answers quote from. */}
  <Section title={s.questions}>
    <Faq items={s.faq} />
  </Section>
</Page>

<script>
  /**
   * The search card routes itself, and remembers.
   *
   * A town goes to that town's page carrying the period as a query parameter
   * the city page reads; "Überall" falls through to the form's own action, the
   * radius view, which is the only place a radius means anything. Without JS
   * the form still submits there, which is a worse answer but never a broken
   * one.
   *
   * Choosing a town is also what the shortcut at the top of the page reads on
   * the next visit — one place-chooser, one memory, no account. Same
   * localStorage as Gemerkt.
   */
  const KEY = 'fynda:stadt';
  const search = document.querySelector<HTMLFormElement>('.search');

  /**
   * The date control is DateFilters, the same component the city and radius
   * pages use. There is no list on this page to filter, so a click here only
   * records the answer in the hidden `zeit` input, which the destination page
   * reads and applies. A calendar day writes a YYYY-MM-DD; a chip writes its
   * own word. Both are windows lib/date-window.ts already understands.
   */
  const zeit = search?.querySelector<HTMLInputElement>('input[name="zeit"]');
  const dateButtons = Array.from(search?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? []);
  for (const button of dateButtons) {
    button.addEventListener('click', () => {
      for (const other of dateButtons) other.setAttribute('aria-pressed', String(other === button));
      if (zeit) zeit.value = button.dataset.filter ?? 'all';
    });
  }

  search?.addEventListener('submit', (event) => {
    const data = new FormData(search);
    const town = String(data.get('ort') ?? '');
    if (!town) return;
    event.preventDefault();

    const period = String(data.get('zeit') ?? 'all');
    const base = search.dataset.cityBase ?? '/';
    const href = `${base}${town}/`;
    const name = search.querySelector<HTMLOptionElement>(`option[value="${town}"]`)?.textContent?.trim();

    try {
      if (name) localStorage.setItem(KEY, JSON.stringify({ slug: town, name, href }));
    } catch { /* private mode. The navigation below still happens. */ }

    location.href = period === 'all' ? href : `${href}?zeit=${period}`;
  });
</script>

<script>
  /**
   * "Alle 38 Märkte am Wochenende" opens the rest in place. No new URL, no
   * navigation, and every row is in the HTML either way — hiding rows from a
   * crawler to save a scroll trades the thing that earns traffic for the thing
   * that costs nothing.
   */
  const button = document.querySelector<HTMLButtonElement>('[data-expand]');
  const rest = document.getElementById('rest-of-weekend');

  if (button && rest) {
    button.addEventListener('click', () => {
      rest.hidden = false;
      button.setAttribute('aria-expanded', 'true');
      button.hidden = true;
    });
  }
</script>

<style>
  /* Only what is genuinely this page's. Everything else is a component. */

  /* The promise under the headline. One size up from body, because it is the
     sentence the page exists to make. */
  /* A card, not a grey tray. The place is the decision, so it gets the full
     width; period and radius are adjustments to it and share a row. */
  .shortcut-slot { margin-inline: var(--space-page); }

  .search {
    display: grid;
    gap: var(--space-3);
    margin-inline: var(--space-page);
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  /* The date control brings its own gutter; the card already has one. */
  .when :global(.filters) { margin-inline: 0; }

  /* At 1100px the card was four full-width controls stacked down the page —
     a phone layout given a desk. The four are one question, so on a wide
     screen they are one row: place takes the slack, the rest are as wide as
     their contents, and the button stops spanning the card.
     Keep in step with --breakpoint-wide. */
  @media (min-width: 900px) {
    .search {
      grid-template-columns: minmax(0, 1fr) auto auto auto;
      align-items: end;
      gap: var(--space-4);
      padding: var(--space-3) var(--space-4);
    }
    .search :global([data-block]) { width: auto; padding-inline: var(--space-6); }
  }

  .promise {
    margin-block-start: var(--space-3);
    max-width: 30ch;
    font-size: var(--text-feature);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
    line-height: 1.28;
  }
  .promise :global(b) { color: var(--color-accent); font-weight: var(--weight-black); }

  .more { margin-block-start: var(--space-4); }

  .calloffs li {
    display: grid;
    padding-block: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
    font-size: var(--text-small);
  }
  .calloffs a { font-weight: var(--weight-bold); }
  .calloffs em { font-style: normal; }

  .proof { max-width: var(--measure); line-height: var(--leading-body); }
  .counts { margin-block-start: var(--space-3); }

  .asks { display: grid; gap: var(--space-4); }

  /* Keep in step with --breakpoint-wide; a media query cannot read a token. */
  @media (min-width: 900px) {
    /* The headline stopped at 11 characters a line and the claim sat under it,
       so the page opened with its right half empty. Same two paragraphs, one
       column over. `align-items: end` sits the claim on the headline's last
       baseline rather than floating it at the top of a taller cell. */
    .home-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-7);
      align-items: end;
    }
    .home-head > * + * { margin-block-start: 0; }
    .says > * + * { margin-block-start: var(--space-2); }

    .asks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

</style>

