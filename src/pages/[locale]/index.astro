---
/**
 * Home — the long version, in the block order PAGES.md decided on 2026-08-30.
 *
 * The page is markup and data. Every visual decision below belongs to a
 * component or to styles/base.css; what is left here is the order of the
 * blocks and the rules that pick what goes in them.
 */
import Page from '../../layouts/Page.astro';
import Button from '../../components/Button.astro';
import Faq from '../../components/Faq.astro';
import CtaCard from '../../components/CtaCard.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import PlaceCloud from '../../components/PlaceCloud.astro';
import Flag from '../../components/Flag.astro';
import MarketRow from '../../components/MarketRow.astro';
import PillList from '../../components/PillList.astro';
import Section from '../../components/Section.astro';
import TownShortcut from '../../components/TownShortcut.astro';
import TypeGrid from '../../components/TypeGrid.astro';
import { getMarkets } from '../../lib/markets';
import TownSearch from '../../components/TownSearch.astro';
import { townIndex } from '../../lib/towns';
import { datedRows, weekendLead } from '../../lib/lists';
import { formatDateShort } from '../../lib/format';
import { COUNTRY, LOCALES, cityPath, countryName, homePath, isCityState, localeTag, marketPath, nearbyPath, regionPath, utilityPath } from '../../lib/i18n';
import { t } from '../../lib/strings';
import { TOWN_KEY } from '../../lib/local-keys';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale, alternates: LOCALES.map((l) => ({ locale: l, path: homePath(l) })) },
  }));
}

const { locale, alternates } = Astro.props;
const s = t(locale);

/* The home page cannot know where the visitor is, so its signup asks —
   the only three page types that do. */
const markets = await getMarkets(locale);
const rows = datedRows(markets);

/**
 * The home page answers one question — what is on this weekend — and then asks
 * one back: where are you.
 *
 * It shows six markets, not all of them. A nationwide list is useless to any
 * one person: sorted by clock time it interleaved 22 cities at random, and
 * someone in Zürich had to read forty-five rows to find four. Six is a taste,
 * one per town so it reads as a country rather than as one city's diary, and
 * the picker underneath is the way out of it. `src/lib/lists.ts`.
 */
/* Only what will run: a cancellation has its own block further down. */
const running = rows.filter((r) => r.next!.status !== 'cancelled');
const { lead, rest, more, total, from, to } = weekendLead(running, 6);

/**
 * The front door, grouped by country.
 *
 * Six comparable sites were read on 2026-09-22 — Booking, Airbnb, GetYourGuide,
 * Eventbrite, Meetup, TheFork — and not one of them has a country picker.
 * Every one asks for a TOWN; the country is a heading, never a control. So the
 * page keeps its one question, and the towns underneath sit in blocks with the
 * country named above them. The heading appears only when there is more than
 * one country: with a single country it says nothing a visitor did not know.
 */
const byCountry = [...new Map(markets.map((m) => [m.countryCode, m.countrySlug])).entries()]
  .map(([code, slug]) => {
    const mine = markets.filter((m) => m.countryCode === code);
    return {
      code,
      slug,
      name: countryName(locale, code),
      markets: mine.length,
      cities: [...new Map(mine.map((m) => [m.citySlug, m.city]))].sort((a, b) => a[1].localeCompare(b[1], locale)),
      regions: [...new Map(mine.map((m) => [m.regionSlug, m.region]))].sort((a, b) => a[1].localeCompare(b[1], locale)),
    };
  })
  .sort((a, b) => b.markets - a.markets);
const several = byCountry.length > 1;

/**
 * This weekend, the visitor's own country first.
 *
 * The six are picked one per town, biggest towns first, across every country —
 * so a visitor in Zürich opened the page on Hamburg. Each country's own six are
 * written into the page as well, hidden, and the script below shows the one
 * for the visitor's country when it can tell: the town they picked, else the
 * region of their browser's language (de-CH, de-DE). Order only: no redirect,
 * no country picker, nothing hidden that the mixed list showed — "all 38"
 * below still opens every market.
 */
const leadsByCountry = several
  ? byCountry
    .map((c) => ({ code: c.code, ...weekendLead(running.filter((r) => r.countryCode === c.code), 6) }))
    .filter((c) => c.lead.length > 0)
  : [];
/* Every locale's spelling of each country's URL word, so a town remembered
   from /de/schweiz/… is recognised on /en/. */
const countryWords = Object.fromEntries(
  (Object.keys(COUNTRY) as (keyof typeof COUNTRY)[]).flatMap((code) =>
    Object.values(COUNTRY[code].name).map((name) => [name!.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(), code]))
);

/**
 * Cancellations in the coming week. Nobody else in the category surfaces these
 * where people look. The block renders only when there is something in it,
 * which is what stops the order below filling with empty furniture.
 */
const inAWeek = (() => { const d = new Date(); d.setDate(d.getDate() + 7); return d.toISOString().slice(0, 10); })();
const cancelled = rows
  .filter((row) => row.next!.status === 'cancelled' && row.next!.date <= inAWeek)
  .sort((a, b) => a.next!.date.localeCompare(b.next!.date));

const site = 'https://fynda.market';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'fynda.market', inLanguage: localeTag(locale), description: s.homeDescription(byCountry.map((c) => c.code)) },
    { '@type': 'Organization', '@id': `${site}/#organisation`, name: 'fynda.market', url: `${site}/` },
  ],
};

---
<Page locale={locale} alternates={alternates} title={s.homeTitle(byCountry.map((c) => c.code))} description={s.homeDescription(byCountry.map((c) => c.code))} footerSignup={false}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  {/* The claim, and it is a number: the trust signal, the content that has to
      rank for the head term, and the sentence an AI answer can quote — one
      line doing three jobs. It comes before anything is asked of anyone.

      The three-field search card that used to sit here is gone. It stood
      between a visitor and the goods, and it is the shape of the one
      competitor in the category whose home page shows no markets at all.
      Choosing a place happens just below it — components/TownSearch.astro. */}
  <section class="page-head home-head gutter">
    <h1>{s.heroLine1}<br />{s.heroLine2}</h1>
    {/* The claim and the proof are one thought, so they move as one: under the
        headline on a phone, beside it on a desk. The wrapper exists for that
        and for nothing else. */}
    <div class="says">
      <p class="promise" set:html={s.homePromise(markets.length)}></p>
      <p class="ask meta">{s.homeOrganiserAsk} <Button href={utilityPath(locale, 'organiser')}>{s.homeOrganiserAction}</Button></p>
    </div>
  </section>

  {/* Empty until the browser says otherwise; see components/TownShortcut.
      The inset is the page's to give — a component that carried its own would
      force every other parent to cancel it (guardrail 7c). It matches the
      search card below, so the two read as one stack rather than two widths. */}
  <div class="shortcut-slot"><TownShortcut locale={locale} /></div>

  {/* Where. One box: type a town, or take "near me", which is always the
      first suggestion — components/TownSearch.astro. When is asked on the
      page you land on, which has the dates; asking it here, before a single
      market was in view, was the second of four controls in a row (UI audit,
      2026-09-23). This is the site's only place-chooser, and what the
      return-visit card above remembers. */}
  <div class="search">
    <TownSearch locale={locale} towns={townIndex(locale, markets)} mode="go" nearbyHref={nearbyPath(locale)} showBig />
  </div>

  {/* Two at full size, then four compact. A block with one size in it has no
      rhythm, and rhythm is most of what stops a list reading as a database
      dump. The picture is the argument — a flea market is stuff you can see. */}
  {total > 0 && (
    <Section title={s.thisWeekend} lede={s.thisWeekendLede(total, formatDateShort(from, locale), formatDateShort(to, locale))}>
      <div data-weekend="all" data-over="hide" data-country-words={several ? JSON.stringify(countryWords) : undefined}>
        <div class="leads gutter">
          {lead.map((market, i) => <MarketRow market={market} locale={locale} variant="feature" eager={i === 0} />)}
        </div>
        <div class="gutter">
          {rest.map((market) => <MarketRow market={market} locale={locale} />)}
        </div>
      </div>
      {leadsByCountry.map((c) => (
        <div data-weekend={c.code} data-over="hide" hidden>
          <div class="leads gutter">
            {c.lead.map((market) => <MarketRow market={market} locale={locale} variant="feature" />)}
          </div>
          <div class="gutter">
            {c.rest.map((market) => <MarketRow market={market} locale={locale} />)}
          </div>
        </div>
      ))}
      {/* Empty in the HTML: filled in the browser with the six nearest of the
          weekend's markets to the visitor's town — the script under this
          section. Every market it can show is already in the page. */}
      <div data-weekend="near" data-over="hide" hidden
        data-key={TOWN_KEY}
        data-title={s.weekendNear}
        data-lede-one={s.weekendNearLede(true, formatDateShort(from, locale), formatDateShort(to, locale))}
        data-lede-many={s.weekendNearLede(false, formatDateShort(from, locale), formatDateShort(to, locale))}
        data-not-near={s.notNear}
        data-change={s.changeTown}
        data-all={s.allWeekendEverywhere(total)}>
        <div class="leads gutter"></div>
        <div class="gutter"></div>
      </div>
      {/* Opens in place. It used to link to /umkreis/, which is the radius
          view and holds a different list — a button that says "all 38" and
          then shows something else is worse than no button. */}
      {more.length > 0 && (
        <>
          <div id="rest-of-weekend" data-over="hide" hidden>
            {more.map((market) => <MarketRow market={market} locale={locale} />)}
          </div>
          <div class="gutter more">
            <Button variant="quiet" data-expand aria-controls="rest-of-weekend" aria-expanded="false">{s.allWeekend(total)}</Button>
          </div>
        </>
      )}
    </Section>
  )}

  {/* Only what is on or still to come (Delfim, 2026-10-10). The page is built
      at night, so on a Saturday evening its two lead photographs were markets
      that had closed at four. A card whose end today has passed leaves, and
      the next row steps up into the lead with the larger picture. Inline and
      right here, so it is settled before the first paint rather than after. */}
  <script is:inline>
    (function () {
      var now = Date.now();
      var over = function (card) { return card.dataset.end && Date.parse(card.dataset.end) <= now; };
      document.querySelectorAll('[data-weekend] article.card, #rest-of-weekend article.card').forEach(function (card) {
        if (over(card)) card.remove();
      });
      document.querySelectorAll('[data-weekend]').forEach(function (block) {
        var leads = block.querySelector('.leads');
        var rows = leads && leads.nextElementSibling;
        var card;
        while (leads && rows && leads.querySelectorAll('article.card').length < 2 && (card = rows.querySelector('article.card'))) {
          card.classList.replace('row', 'feature');
          var img = card.querySelector('img');
          if (img && /-thumb\.webp$/.test(img.getAttribute('src'))) {
            img.src = img.getAttribute('src').replace(/-thumb\.webp$/, '-720.webp');
            img.width = img.height = 720;
          }
          leads.appendChild(card);
        }
      });
      /* A Sunday evening: the whole weekend is over. Tonight's build brings the
         next one; until then the block goes rather than stand empty. */
      var all = document.querySelector('[data-weekend="all"]');
      if (all && !all.querySelector('article.card')) all.closest('section').hidden = true;
    })();
  </script>

  {/* This weekend near the visitor's town (Delfim, 2026-10-14,
      design/home-town-v1.html). The town is the one they picked before, else
      the nearest of ours within 25 km of where their connection comes from —
      a point the edge adds to this page (functions/_middleware.ts), never
      stored. Then the six nearest of the weekend's markets within 30 km, each
      with its distance. No town, or nothing that close: the page as it was.
      Inline and before the first paint, like the script above, so the photos
      do not change under the visitor's eyes. */}
  <script is:inline>
    (function () {
      var near = document.querySelector('[data-weekend="near"]');
      var all = document.querySelector('[data-weekend="all"]');
      var rest = document.getElementById('rest-of-weekend');
      var button = document.querySelector('[data-expand]');
      if (!near || !all) return;
      var section = near.closest('section');
      var d = near.dataset;

      /* Same formula as src/lib/geo.ts, which an inline script cannot import. */
      var km = function (lat1, lng1, lat2, lng2) {
        var rad = function (x) { return (x * Math.PI) / 180; };
        var a = Math.pow(Math.sin(rad(lat2 - lat1) / 2), 2) +
          Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.pow(Math.sin(rad(lng2 - lng1) / 2), 2);
        return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      };
      var label = function (k) {
        var n = k < 1 ? k : Math.round(k);
        return new Intl.NumberFormat(document.documentElement.lang || 'en', { maximumFractionDigits: k < 1 ? 1 : 0 }).format(n) + ' km';
      };
      /* A card moved between the big and the small size, with its photo. */
      var shape = function (card, to) {
        var from = to === 'feature' ? 'row' : 'feature';
        if (!card.classList.contains(from)) return;
        card.classList.replace(from, to);
        var pic = card.querySelector('.pic');
        var img = pic && pic.querySelector('img');
        if (!img) return;
        var base = img.getAttribute('src').replace(/-(thumb|720)\.webp$/, '.webp');
        if (to === 'feature') {
          img.src = base.replace(/\.webp$/, '-720.webp');
          img.width = img.height = 720;
        } else {
          var picture = pic.querySelector('picture');
          img.src = base.replace(/\.webp$/, '-thumb.webp');
          img.width = img.height = 148;
          if (picture) picture.replaceWith(img);
        }
      };

      /* "All 67" opens every market except the ones already shown above it.
         The hidden list holds everything but the first six of the mixed
         block, so when another block leads — a country's own six, or the six
         near a town — the mixed six move in and the leading ones move out. */
      if (button && rest) {
        button.addEventListener('click', function () {
          var shown = Array.prototype.find.call(section.querySelectorAll('[data-weekend]'), function (b) { return !b.hidden; });
          if (!shown || shown === all) return;
          var above = {};
          shown.querySelectorAll('article.card').forEach(function (c) { above[c.dataset.market] = true; });
          rest.querySelectorAll('article.card').forEach(function (c) { if (above[c.dataset.market]) c.remove(); });
          all.querySelectorAll('article.card').forEach(function (c) {
            if (above[c.dataset.market]) return;
            shape(c, 'row');
            rest.appendChild(c);
          });
          var key = function (c) { return (c.dataset.date || '') + (c.dataset.start || ''); };
          Array.prototype.slice.call(rest.querySelectorAll('article.card'))
            .sort(function (a, b) { return key(a) < key(b) ? -1 : key(a) > key(b) ? 1 : 0; })
            .forEach(function (c) { rest.appendChild(c); });
        }, { once: true });
      }

      var towns;
      try {
        towns = JSON.parse(document.querySelector('[data-ts]').dataset.towns).map(function (t) {
          return { slug: t[0], name: t[1], lat: t[6], lng: t[7] };
        });
      } catch (e) { return; }

      var town = null;
      var guessed = false;
      try {
        var saved = JSON.parse(localStorage.getItem(d.key) || 'null');
        if (saved && saved.slug) town = towns.find(function (t) { return t.slug === saved.slug; }) || null;
      } catch (e) { /* private mode */ }
      if (!town) {
        var meta = document.querySelector('meta[name="fynda:near"]');
        var p = meta ? meta.content.split(',').map(Number) : [];
        if (p.length === 2 && isFinite(p[0]) && isFinite(p[1])) {
          var best = null;
          var bestKm = Infinity;
          towns.forEach(function (t) { var k = km(p[0], p[1], t.lat, t.lng); if (k < bestKm) { best = t; bestKm = k; } });
          if (best && bestKm <= 25) { town = best; guessed = true; }
        }
      }
      if (!town) return;

      var seen = {};
      var close = [];
      [all, rest].forEach(function (box) {
        if (!box) return;
        box.querySelectorAll('article.card').forEach(function (c) {
          if (seen[c.dataset.market]) return;
          seen[c.dataset.market] = true;
          var k = km(town.lat, town.lng, Number(c.dataset.lat), Number(c.dataset.lng));
          if (k <= 30) close.push({ card: c, km: k });
        });
      });
      if (!close.length) return;
      close.sort(function (a, b) { return a.km - b.km; });

      var leads = near.querySelector('.leads');
      var rows = leads.nextElementSibling;
      close.slice(0, 6).forEach(function (x, i) {
        var c = x.card.cloneNode(true);
        shape(c, i < 2 ? 'feature' : 'row');
        var img = c.querySelector('img');
        if (img && i < 2) img.loading = 'eager';
        var pill = c.querySelector('[data-distance]');
        if (pill) { pill.textContent = label(x.km); pill.hidden = false; }
        (i < 2 ? leads : rows).appendChild(c);
      });

      section.querySelectorAll('[data-weekend]').forEach(function (b) { b.hidden = b !== near; });
      section.querySelector('h2').textContent = d.title.replace('{town}', town.name);
      var lede = section.querySelector('.lede');
      if (lede) {
        lede.textContent = (close.length === 1 ? d.ledeOne : d.ledeMany).replace('{n}', String(close.length)) + ' · ';
        var change = document.createElement('a');
        change.href = '#town-search';
        change.setAttribute('data-change-town', '');
        change.textContent = guessed ? d.notNear.replace('{town}', town.name) + ' ' + d.change : d.change;
        change.addEventListener('click', function (e) {
          e.preventDefault();
          var input = document.querySelector('[data-ts-input]');
          if (input) { input.scrollIntoView({ block: 'center' }); input.focus(); }
        });
        lede.appendChild(change);
      }
      if (button) button.textContent = d.all;
    })();
  </script>

  {/* Two full-width black buttons stacked one above the other were two equally
      loud asks, and two equally loud asks are neither. Side by side above
      900px, and only the first is filled — CtaCard takes `variant`. */}
  <div class="asks gutter">
    <SubscribeForm locale={locale} pick anchors />
    <CtaCard kind="organiser" locale={locale} variant="secondary" />
  </div>

  {cancelled.length > 0 && (
    <Section title={s.cancelledThisWeek}>
      <ul class="calloffs list-reset gutter">
        {cancelled.map((row) => (
          <li>
            <a href={marketPath(locale, row.slug)}>{row.name}</a>
            <span class="meta">{formatDateShort(row.next!.date, locale)} · {row.city}</span>
            {row.next!.cancellationNote && <em class="meta-quiet">{row.next!.cancellationNote}</em>}
          </li>
        ))}
      </ul>
    </Section>
  )}

  {byCountry.map((country) => (
    <>
      {several && (
        <h2 class="country gutter"><Flag code={country.code} /> {country.name}
          <span class="meta">{s.countryCount(country.markets, country.cities.length)}</span>
        </h2>
      )}
      <Section id={several ? `orte-${country.code.toLowerCase()}` : 'staedte'} title={s.cities} lede={s.citiesLede} level={several ? 'sub' : undefined}>
        <PlaceCloud items={country.cities.map(([slug, city]) => ({
          href: cityPath(locale, country.slug, slug),
          label: city,
          count: markets.filter((m) => m.citySlug === slug).length,
        }))} />
      </Section>

      <Section id={several ? `regionen-${country.code.toLowerCase()}` : 'kantone'} title={s.regionsOf(country.code)} lede={s.regionsLede} level={several ? 'sub' : undefined}>
        <PillList items={country.regions.map(([slug, region]) => ({
          href: isCityState(country.code, slug) ? cityPath(locale, country.slug, slug) : regionPath(locale, country.code, country.slug, slug),
          label: region,
          meta: String(markets.filter((m) => m.regionSlug === slug).length),
        }))} />
      </Section>
    </>
  ))}

  <Section title={s.marketTypes} lede={s.typesLede}><TypeGrid locale={locale} /></Section>

  {/* Four answers, written per language like the rest of strings.ts — short,
      factual, and about the one thing that makes this site different: whether
      the date is true. Also the block AI answers quote from. */}
  <Section id="faq" title={s.questions}>
    <Faq items={s.faq} />
  </Section>
</Page>

<script>
  /**
   * "Alle 38 Märkte am Wochenende" opens the rest in place. No new URL, no
   * navigation, and every row is in the HTML either way — hiding rows from a
   * crawler to save a scroll trades the thing that earns traffic for the thing
   * that costs nothing.
   */
  import { TOWN_KEY, adopt } from '../../lib/local-keys';

  /**
   * Which country's six to show first. The town the visitor picked says it
   * best; failing that, the region of the browser's language. Neither is a
   * guess about a person — both are things their own browser already says.
   */
  const mixed = document.querySelector<HTMLElement>('[data-weekend="all"]');
  const words: Record<string, string> = (() => {
    try { return JSON.parse(mixed?.dataset.countryWords ?? '{}'); } catch { return {}; }
  })();
  const visitorCountry = (): string | undefined => {
    adopt(TOWN_KEY);
    try {
      const href: string | undefined = JSON.parse(localStorage.getItem(TOWN_KEY) ?? 'null')?.href;
      const word = href?.split('/')[2];
      if (word && words[word]) return words[word];
    } catch { /* private mode */ }
    const codes = new Set(Object.values(words));
    for (const lang of navigator.languages ?? []) {
      const region = lang.split('-')[1]?.toUpperCase();
      if (region && codes.has(region)) return region;
    }
    return undefined;
  };
  /* A town already leads the block (the inline script above); nothing to choose. */
  const nearShown = !!document.querySelector('[data-weekend="near"]:not([hidden])');
  const own = mixed && !nearShown && Object.keys(words).length ? visitorCountry() : undefined;
  const block = own ? document.querySelector<HTMLElement>(`[data-weekend="${own}"]`) : null;
  if (mixed && block) {
    block.hidden = false;
    mixed.hidden = true;
  }

  const button = document.querySelector<HTMLButtonElement>('[data-expand]');
  const rest = document.getElementById('rest-of-weekend');

  if (button && rest) {
    button.addEventListener('click', () => {
      rest.hidden = false;
      button.setAttribute('aria-expanded', 'true');
      button.hidden = true;
    });
  }
</script>

<style>
  /* Only what is genuinely this page's. Everything else is a component. */

  /* The country heading on the front door: a flag, a name, and the two counts
     that make the block worth opening. It only renders with a second country
     on the page — src/pages/[locale]/index.astro, the byCountry block. */
  .country {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: var(--space-7) 0 0;
    font-size: var(--text-section);
    letter-spacing: var(--tracking-tight);
  }
  .country .meta { margin-inline-start: auto; font-size: var(--text-small); }

  /* The promise under the headline. One size up from body, because it is the
     sentence the page exists to make. */
  .shortcut-slot { margin-inline: var(--space-page); }

  /* The control sits in the page's own gutter; it draws no box of its own
     (BRAND.md §Controls are editorial). */
  .search { margin-inline: var(--space-page); }

  .promise {
    margin-block-start: var(--space-3);
    max-width: 30ch;
    font-size: var(--text-feature);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
    line-height: 1.28;
  }
  .promise :global(b) { color: var(--color-accent-text); font-weight: var(--weight-black); }
  /* The organiser line: a question in grey and the site's small pill beside it,
     so it reads as one quiet action, not as a link buried in a sentence. */
  .ask { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); }

  .calloffs li {
    display: grid;
    padding-block: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
    font-size: var(--text-small);
  }
  .calloffs a { font-weight: var(--weight-bold); }
  .calloffs em { font-style: normal; }

  .proof { max-width: var(--measure); line-height: var(--leading-body); }
  .counts { margin-block-start: var(--space-3); }

  .asks { display: grid; gap: var(--space-4); }

  /* "Not near Zurich? Change" — written by the script, so unscoped. Underlined
     like a link in prose, or it reads as more of the grey line. */
  :global([data-change-town]) { color: var(--color-ink); text-decoration: underline; text-underline-offset: var(--space-half); }

  /* Keep in step with --breakpoint-wide; a media query cannot read a token. */
  @media (min-width: 900px) {
    /* The headline stopped at 11 characters a line and the claim sat under it,
       so the page opened with its right half empty. Same two paragraphs, one
       column over. `align-items: end` sits the claim on the headline's last
       baseline rather than floating it at the top of a taller cell. */
    .home-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-7);
      align-items: end;
    }
    .home-head > * + * { margin-block-start: 0; }
    .says > * + * { margin-block-start: var(--space-2); }

    /* `start`, not the default stretch. The signup card is a form and the
       organiser card is two lines and a button, so matching their heights
       bought nothing but a 200px hole in the shorter one. Each card ends where
       its content ends and both begin on the same line, which is the alignment
       a reader actually notices. */
    .asks { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  }

</style>

