---
/**
 * Home — the long version, in the block order PAGES.md decided on 2026-08-30.
 *
 * The page is markup and data. Every visual decision below belongs to a
 * component or to styles/base.css; what is left here is the order of the
 * blocks and the rules that pick what goes in them.
 */
import Page from '../../layouts/Page.astro';
import Button from '../../components/Button.astro';
import CtaCard from '../../components/CtaCard.astro';
import DateBand from '../../components/DateBand.astro';
import DateFilters from '../../components/DateFilters.astro';
import LinkList from '../../components/LinkList.astro';
import MarketRow from '../../components/MarketRow.astro';
import PillList from '../../components/PillList.astro';
import Section from '../../components/Section.astro';
import TypeLegend from '../../components/TypeLegend.astro';
import { getMarkets, withinHorizon } from '../../lib/markets';
import { formatDateShort } from '../../lib/format';
import { LOCALES, cityPath, homePath, marketPath } from '../../lib/i18n';
import { t } from '../../lib/strings';
import type { Market, Occurrence } from '../../lib/types';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale, alternates: LOCALES.map((l) => ({ locale: l, path: homePath(l) })) },
  }));
}

const { locale, alternates } = Astro.props;
const s = t(locale);
const markets = await getMarkets(locale);
const rows = markets.flatMap((market) =>
  withinHorizon([market.next, ...market.upcoming].filter(Boolean) as Occurrence[])
    .map((next) => ({ ...market, next }))
);
const groups = Object.values(
  rows.reduce<Record<string, Market[]>>((all, row) => { (all[row.next!.date] ??= []).push(row); return all; }, {})
).sort((a, b) => a[0].next!.date.localeCompare(b[0].next!.date));

const cities = [...new Map(markets.map((m) => [m.citySlug, m.city]))].sort((a, b) => a[1].localeCompare(b[1], locale));
const regions = [...new Map(markets.map((m) => [m.regionSlug, m.region]))].sort((a, b) => a[1].localeCompare(b[1], locale));
const countrySlug = markets[0]?.countrySlug ?? 'schweiz';

/**
 * Four markets per day, then the rest behind one button — PAGES.md. Every row
 * is in the HTML: hiding them from the crawler to save a scroll would trade the
 * thing that earns traffic for the thing that costs nothing.
 */
const PER_DAY = 4;

/**
 * Cancellations in the coming week. Nobody else in the category surfaces these
 * where people look. The block renders only when there is something in it,
 * which is what stops the order below filling with empty furniture.
 */
const inAWeek = (() => { const d = new Date(); d.setDate(d.getDate() + 7); return d.toISOString().slice(0, 10); })();
const cancelled = rows
  .filter((row) => row.next!.status === 'cancelled' && row.next!.date <= inAWeek)
  .sort((a, b) => a.next!.date.localeCompare(b.next!.date));

const site = 'https://fynda.market';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'Fynda', inLanguage: 'de-CH', description: 'Flohmärkte in der Schweiz, mit Daten die stimmen.' },
    { '@type': 'Organization', '@id': `${site}/#organisation`, name: 'Fynda', url: `${site}/` },
  ],
};

---
<Page locale={locale} alternates={alternates} title={s.homeTitle} description={s.homeDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="page-head gutter">
    <h1>{s.heroLine1}<br />{s.heroLine2}</h1>
    <p class="meta">{s.heroPromise}</p>
  </section>

  <form class="control" action="/umkreis/" method="get">
    <label><b>{s.controlPlace}</b><span>{cities[0]?.[1] ?? ''}</span></label>
    <label><b>{s.controlPeriod}</b><span>{s.filterWeekend}</span></label>
    <label><b>{s.controlRadius}</b><span>50 km</span></label>
    <Button type="submit" variant="primary" block>{s.controlSubmit}</Button>
  </form>

  <DateFilters locale={locale} />

  <Section title={s.upcoming} bleed>
    <div id="list">
      {groups.map((group) => (
        <section class="day" data-day>
          <DateBand date={group[0].next!.date} count={group.length} locale={locale} />
          {group.map((market) => <MarketRow market={market} locale={locale} />)}
          {group.length > PER_DAY && (
            <div class="gutter more">
              <Button variant="quiet" data-more hidden>{s.showMore(group.length - PER_DAY)}</Button>
            </div>
          )}
        </section>
      ))}
    </div>
    <p id="empty" class="gutter meta" hidden>{s.nothingInPeriod}</p>
  </Section>

  <CtaCard kind="newsletter" locale={locale} />
  <CtaCard kind="organiser" locale={locale} />

  {cancelled.length > 0 && (
    <Section title={s.cancelledThisWeek}>
      <ul class="calloffs list-reset gutter">
        {cancelled.map((row) => (
          <li>
            <a href={marketPath(locale, row.slug)}>{row.name}</a>
            <span class="meta">{formatDateShort(row.next!.date, locale)} · {row.city}</span>
            {row.next!.cancellationNote && <em class="meta-quiet">{row.next!.cancellationNote}</em>}
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section title={s.cities}>
    <LinkList items={cities.map(([slug, city]) => ({
      href: cityPath(locale, countrySlug, slug),
      label: city,
      meta: s.marketCount(markets.filter((m) => m.citySlug === slug).length),
    }))} />
  </Section>

  <Section title={s.regions}>
    <PillList items={regions.map(([slug, region]) => ({
      label: region,
      meta: String(markets.filter((m) => m.regionSlug === slug).length),
    }))} />
  </Section>

  <Section title={s.marketTypes}><TypeLegend locale={locale} /></Section>

  <Section title={s.whereDataComes}>
    <ol class="steps gutter">
      <li>{s.dataStep1}</li>
      <li>{s.dataStep2}</li>
      <li>{s.dataStep3}</li>
    </ol>
    <p class="gutter meta counts">{s.marketCount(markets.length)} · {s.dateCount(rows.length)} · {cities.length} {s.cities} · {regions.length} {s.regions}</p>
  </Section>

  {/* The FAQ is real copy, not interface labels, so it waits for real copy in
      each language rather than shipping a machine translation. docs/PLAN.md. */}
</Page>

<style>
  /* Only what is genuinely this page's. Everything else is a component. */
  .control {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-half);
    margin-inline: var(--space-page);
    padding: var(--space-2);
    border-radius: var(--radius-photo);
    background: var(--color-paper);
  }
  .control label { min-width: 0; padding: var(--space-1); font-size: var(--text-micro); }
  .control b, .control span { display: block; }
  .control b { color: var(--color-quiet); font-weight: var(--weight-semibold); }
  .control span { overflow: hidden; font-weight: var(--weight-bold); text-overflow: ellipsis; white-space: nowrap; }
  .control :global(.button) { grid-column: 1 / -1; }

  .more { margin-block-start: var(--space-2); }

  .calloffs li {
    display: grid;
    padding-block: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-line);
    font-size: var(--text-small);
  }
  .calloffs a { font-weight: var(--weight-bold); }
  .calloffs em { font-style: normal; }

  .steps { margin: 0; padding-inline-start: calc(var(--space-page) + var(--space-3)); font-size: var(--text-small); }
  .counts { margin-block-start: var(--space-3); }

  /* Keep in step with --breakpoint-wide; a media query cannot read a token. */
  @media (min-width: 900px) {
    .control { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .control :global(.button) { grid-column: auto; }
  }
</style>

<script>
  /**
   * One pass owns both rules, because they interact: the date chips decide
   * which rows are eligible, and only then does the four-per-day cap apply to
   * what is left. Two independent handlers would fight over `hidden` and leave
   * a day showing three rows behind a button offering five more.
   *
   * Everything is in the HTML already. Without JavaScript the page is the full
   * list, which is the right failure: the rows are what earns the traffic.
   */
  import { inWindow, type DateWindow } from '../../lib/date-window';

  const PER_DAY = 4;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const days = Array.from(document.querySelectorAll<HTMLElement>('[data-day]'));
  const empty = document.getElementById('empty');
  const expanded = new Set<HTMLElement>();

  const apply = (window: DateWindow) => {
    const now = new Date();
    let shown = 0;

    for (const section of days) {
      const rows = Array.from(section.querySelectorAll<HTMLElement>('[data-date]'));
      const more = section.querySelector<HTMLElement>('[data-more]');
      const eligible = rows.filter((row) => inWindow(row.dataset.date ?? '', window, now));

      const open = expanded.has(section);
      const visible = open ? eligible : eligible.slice(0, PER_DAY);
      const visibleSet = new Set(visible);
      for (const row of rows) row.hidden = !visibleSet.has(row);

      const remaining = eligible.length - visible.length;
      if (more) {
        more.hidden = remaining === 0;
        more.textContent = `${remaining} weitere anzeigen`;
      }

      section.hidden = eligible.length === 0;
      shown += visible.length;
    }

    if (empty) empty.hidden = shown > 0;
  };

  let current: DateWindow = 'all';
  for (const section of days) {
    section.querySelector<HTMLElement>('[data-more]')?.addEventListener('click', () => {
      expanded.add(section);
      apply(current);
    });
  }
  for (const button of buttons) {
    button.addEventListener('click', () => {
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      current = (button.dataset.filter ?? 'all') as DateWindow;
      // A new period is a new question; the days collapse back to four.
      expanded.clear();
      apply(current);
    });
  }
  apply(current);
</script>
